# Cloudflare Pages Functions / wrangler pages dev bindings.
# Copy to `.dev.vars` (gitignored) and set DAILYBOT_API_KEY from
# https://app.dailybot.com → User settings → API keys.
#
# Form and question ids are configuration, not code.

DAILYBOT_API_KEY=

# The target form, and the map from our field names to its question ids. Both
# belong to a DailyBot workspace this repository does not own, which is why
# neither is committed: a fork that inherited them would post into somebody
# else's form.
#
#   DAILYBOT_FORM_QUESTIONS='{"email":"<uuid>","message":"<uuid>",
#                             "interest":"<uuid>","lang":"<uuid>",
#                             "name":"<uuid>","organization":"<uuid>"}'
#
# With any of the three absent, /api/contact answers 503 `not-configured` and
# the page shows the issue tracker instead — a form that accepts a message it
# cannot deliver is worse than no form.
DAILYBOT_FORM_ID=
DAILYBOT_FORM_QUESTIONS=

# ── The validator endpoint ────────────────────────────────
#
# `/api/validate` needs no secrets. Its only binding is the KV namespace
# `VALIDATE_RATE`, which holds two counters and is created locally by
# `wrangler pages dev dist --kv VALIDATE_RATE`.
#
# If the endpoint ever appears to need a credential, that is a design change
# worth stopping for: a service that fetches arbitrary URLs and also holds a
# secret is a considerably more attractive target than one that does not.

# ── The registry's measured state ─────────────────────────
#
# The badge endpoint and `/registry/status.json` read the KV namespace
# `REGISTRY_STATUS`. Both are read-only: nothing served from a Function can
# write a conformance state. Create it locally with
# `wrangler pages dev dist --kv VALIDATE_RATE --kv REGISTRY_STATUS`; an empty
# namespace renders every badge as its honest "not yet measured" state.
#
# The build can bake the current states into the static pages when these three
# are set. All three are optional — without them the build succeeds and every
# entry renders as not yet measured, which is what a local build should show.
# The token is READ-only and scoped to the one namespace; the write token lives
# only in the revalidation workflow's secrets. See docs/SECURITY.md § 4.
CF_ACCOUNT_ID=
CF_REGISTRY_KV_ID=
CF_KV_READ_TOKEN=
