---
import { getCollection, render } from 'astro:content';

import SpecSectionPage from '@/components/pages/spec/SpecSectionPage.astro';
import { specSection } from '@/lib/spec-loader';

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  return entries.map((entry) => ({
    params: { version: entry.data.version, section: entry.data.slug },
    props: { entry },
  }));
}

const { version, section: slug } = Astro.params as {
  version: string;
  section: string;
};
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = specSection(version, slug);
---

{
  section && (
    <SpecSectionPage lang="en" section={section} headings={headings}>
      <Content />
    </SpecSectionPage>
  )
}
