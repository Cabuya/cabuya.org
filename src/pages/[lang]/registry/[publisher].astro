---
import PublisherPage from '@/components/pages/PublisherPage.astro';
import {
  DEFAULT_LANGUAGE,
  getSupportedLanguages,
  type Language,
} from '@/lib/i18n';
import { allPublishers } from '@/lib/registry-loader';

export function getStaticPaths() {
  const languages = getSupportedLanguages().filter(
    (lang) => lang !== DEFAULT_LANGUAGE
  );
  return languages.flatMap((lang: Language) =>
    allPublishers().map((entry) => ({
      params: { lang, publisher: entry.publisher_id },
      props: { entry },
    }))
  );
}

const { lang } = Astro.params as { lang: Language };
const { entry } = Astro.props;
---

<PublisherPage lang={lang} entry={entry} />
