---
import { getCollection, render } from 'astro:content';

import SpecSectionPage from '@/components/pages/spec/SpecSectionPage.astro';
import {
  DEFAULT_LANGUAGE,
  getSupportedLanguages,
  type Language,
} from '@/lib/i18n';
import { specSection } from '@/lib/spec-loader';

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  const english = entries.filter((entry) => entry.data.lang === 'en');
  return getSupportedLanguages()
    .filter((lang) => lang !== DEFAULT_LANGUAGE)
    .flatMap((lang) => {
      const translated = entries.filter((entry) => entry.data.lang === lang);
      // A language with no translation still gets every section — in English,
      // with the page's notice saying so. A missing page is worse than an
      // untranslated one.
      const forLang =
        translated.length === english.length ? translated : english;
      return forLang.map((entry) => ({
        params: {
          lang,
          version: entry.data.version,
          section: entry.data.slug,
        },
        props: { entry },
      }));
    });
}

const {
  lang,
  version,
  section: slug,
} = Astro.params as {
  lang: Language;
  version: string;
  section: string;
};
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = specSection(version, slug, lang);
---

{
  section && (
    <SpecSectionPage lang={lang} section={section} headings={headings}>
      <Content />
    </SpecSectionPage>
  )
}
