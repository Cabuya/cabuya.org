---
import InternalLayout from '@/layouts/InternalLayout.astro';

const dashboards = [
  {
    name: 'Cloudflare Web Analytics',
    url: 'dash.cloudflare.com → Pages → Project → Web Analytics',
    login: 'Cloudflare account',
    measures: 'Traffic, Core Web Vitals (LCP, INP, CLS), referrers, countries',
    scriptSize: '~1KB (edge-injected)',
    cookies: 'None',
  },
  {
    name: 'Google Search Console',
    url: 'search.google.com/search-console',
    login: 'Google account',
    measures: 'Search queries, impressions, CTR, position, indexation',
    scriptSize: 'None (DNS TXT verification)',
    cookies: 'None',
  },
  {
    name: 'Bing Webmaster Tools',
    url: 'bing.com/webmasters',
    login: 'Microsoft account',
    measures: 'Search queries, AI Performance (Copilot citations)',
    scriptSize: 'None (meta tag)',
    cookies: 'None',
  },
  {
    name: 'Lighthouse CI',
    url: 'GitHub PR checks (automatic)',
    login: 'GitHub account',
    measures: 'Performance, Accessibility, Best Practices, SEO scores',
    scriptSize: 'None (CI only)',
    cookies: 'None',
  },
];

const weeklyTasks = [
  {
    tool: 'Cloudflare',
    action: 'Core Web Vitals snapshot',
    question: 'Any real-user performance regressions this week?',
  },
];

const monthlyTasks = [
  {
    tool: 'Google Search Console',
    action: 'Performance report',
    question: 'Which search queries are growing or declining?',
  },
  {
    tool: 'Google Search Console',
    action: 'Coverage report',
    question: 'Are all blog posts indexed? Any crawl errors?',
  },
  {
    tool: 'Bing Webmaster',
    action: 'AI Performance report',
    question: 'Is content being cited in Microsoft Copilot?',
  },
  {
    tool: 'Cloudflare',
    action: 'Core Web Vitals trends',
    question: 'Are any pages slow for real users?',
  },
];

/**
 * What the dashboard can answer, and what it cannot.
 *
 * Cloudflare Web Analytics measures page views, referrers, countries and Web
 * Vitals from its own beacon. It has **no custom-event API**, so every question
 * below is answered by comparing page-view counts rather than by an event —
 * which is a real limit and is stated as one rather than worked around.
 */
const keyMetrics = [
  {
    metric: 'Quickstart → validator',
    good: 'A meaningful share of quickstart readers reach the validator',
    bad: 'Readers arrive at the quickstart and go no further',
    tool: 'Cloudflare — page-view ratio, not a funnel',
  },
  {
    metric: 'Validator → registry',
    good: 'Validator visits are followed by registry visits',
    bad: 'People validate and never appear at the registry',
    tool: 'Cloudflare — page-view ratio',
  },
  {
    metric: 'Skill page views',
    good: 'Growing once the pack ships',
    bad: 'Flat after an announcement',
    tool: 'Cloudflare',
  },
  {
    metric: 'Agent fetches (.md, llms.txt)',
    good: 'Growing — agents are reading the protocol',
    bad: 'Zero: nothing is finding the agent surface',
    tool: 'Cloudflare — request logs by path, not a custom event',
  },
  {
    metric: 'Page views · unique visitors',
    good: 'Growing trend',
    bad: 'Declining without a change to explain it',
    tool: 'Cloudflare',
  },
  {
    metric: 'LCP',
    good: '< 2.5 s',
    bad: '> 4.0 s',
    tool: 'Cloudflare Web Analytics',
  },
  {
    metric: 'CLS',
    good: '< 0.1',
    bad: '> 0.25',
    tool: 'Cloudflare Web Analytics',
  },
  {
    metric: 'INP',
    good: '< 200 ms',
    bad: '> 500 ms',
    tool: 'Cloudflare Web Analytics',
  },
];

/**
 * Questions this stack deliberately cannot answer.
 *
 * Listed because the alternative — a maintainer assuming the data exists and
 * quietly adding a tracker to get it — is how a cookieless site stops being
 * one.
 */
const neverMeasured = [
  'Which URL somebody validated. The endpoint keeps nothing; a counter is the only thing written.',
  'What was in a feed, or in a contact message.',
  'Who anybody is. No cookie, no fingerprint, no identifier that survives a page load.',
  'A per-person path through the site. Page-view ratios are aggregates, and that is all a funnel here can be.',
  'Anything at all from a fork or a local build: the beacon token is env-gated and absent by default.',
];

const envVars = [
  {
    name: 'PUBLIC_CF_BEACON_TOKEN',
    tool: 'Cloudflare Web Analytics',
    where: 'dash.cloudflare.com → Web Analytics → site → JS snippet',
  },
  {
    name: 'PUBLIC_CF_BEACON_ENABLE',
    tool: 'Cloudflare (local only)',
    where:
      'Set to "true" to load the beacon outside production, for verification',
  },
  {
    name: 'PUBLIC_BING_SITE_VERIFICATION',
    tool: 'Bing',
    where: 'Bing Webmaster > Verification',
  },
];
---

<InternalLayout title="Analytics Monitoring Guide" description="Dashboard access, monitoring routines, and key metrics for the analytics stack" section="guide" subsection="analytics">

  <!-- Analytics Stack Overview -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Analytics Stack</h2>
    <p class="text-cabuya-text-secondary mb-6">
      All tools are free, privacy-first, and performance-preserving. Total script overhead stays minimal.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-cabuya-border">
            <th class="text-left py-2 px-3 font-semibold">Tool</th>
            <th class="text-left py-2 px-3 font-semibold">What It Measures</th>
            <th class="text-left py-2 px-3 font-semibold">Script</th>
            <th class="text-left py-2 px-3 font-semibold">Cookies</th>
          </tr>
        </thead>
        <tbody>
          {dashboards.map((d) => (
            <tr class="border-b border-cabuya-border">
              <td class="py-2 px-3 font-medium">{d.name}</td>
              <td class="py-2 px-3 text-cabuya-text-secondary">{d.measures}</td>
              <td class="py-2 px-3"><code class="text-xs bg-cabuya-bg-brand-strong px-1 rounded">{d.scriptSize}</code></td>
              <td class="py-2 px-3">{d.cookies}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Dashboard Quick Access -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Dashboard Quick Access</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {dashboards.map((d) => (
        <div class="rounded-xl border border-cabuya-border p-4">
          <h3 class="font-semibold mb-1">{d.name}</h3>
          <p class="text-sm text-cabuya-text-secondary mb-2">{d.url}</p>
          <span class="text-xs bg-cabuya-info-soft text-cabuya-info px-2 py-0.5 rounded-full">
            {d.login}
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- Weekly Review -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Weekly Review (~5 min)</h2>
    <div class="space-y-3">
      {weeklyTasks.map((task) => (
        <div class="flex items-start gap-3 p-3 rounded-lg border border-cabuya-border">
          <span class="shrink-0 text-xs font-medium bg-cabuya-success-soft text-cabuya-success px-2 py-0.5 rounded-full mt-0.5">
            {task.tool}
          </span>
          <div>
            <p class="font-medium text-sm">{task.action}</p>
            <p class="text-sm text-cabuya-text-secondary">{task.question}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Monthly Review -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Monthly Review (~10 min)</h2>
    <div class="space-y-3">
      {monthlyTasks.map((task) => (
        <div class="flex items-start gap-3 p-3 rounded-lg border border-cabuya-border">
          <span class="shrink-0 text-xs font-medium bg-cabuya-info-soft text-cabuya-info px-2 py-0.5 rounded-full mt-0.5">
            {task.tool}
          </span>
          <div>
            <p class="font-medium text-sm">{task.action}</p>
            <p class="text-sm text-cabuya-text-secondary">{task.question}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Key Metrics -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Key Metrics to Watch</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-cabuya-border">
            <th class="text-left py-2 px-3 font-semibold">Metric</th>
            <th class="text-left py-2 px-3 font-semibold">Good</th>
            <th class="text-left py-2 px-3 font-semibold">Needs Attention</th>
            <th class="text-left py-2 px-3 font-semibold">Tool</th>
          </tr>
        </thead>
        <tbody>
          {keyMetrics.map((m) => (
            <tr class="border-b border-cabuya-border">
              <td class="py-2 px-3 font-medium">{m.metric}</td>
              <td class="py-2 px-3 text-cabuya-success">{m.good}</td>
              <td class="py-2 px-3 text-cabuya-danger">{m.bad}</td>
              <td class="py-2 px-3 text-cabuya-text-secondary">{m.tool}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div
      class="mt-8 rounded-xl border border-cabuya-border-strong bg-cabuya-bg-elevated p-5"
    >
      <h3 class="font-semibold">What this stack cannot answer</h3>
      <p class="mt-2 text-sm text-cabuya-text-secondary">
        Listed because the alternative — assuming the data exists and quietly
        adding a tracker to get it — is how a cookieless site stops being one.
        If one of these becomes genuinely necessary, it is a decision with a
        privacy note attached, not a configuration change.
      </p>
      <ul
        class="mt-3 list-disc space-y-1 pl-5 text-sm text-cabuya-text-secondary"
      >
        {neverMeasured.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Content Performance Analysis -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Content Performance Analysis</h2>
    <div class="space-y-6">
      <div class="p-4 rounded-xl border border-cabuya-border">
        <h3 class="font-semibold mb-2">Identifying Best-Performing Posts</h3>
        <ol class="list-decimal list-inside space-y-1 text-sm text-cabuya-text-secondary">
          <li>Check <strong>Cloudflare Top Pages</strong> — which parts of the protocol people actually read</li>
          <li>Cross-reference with <strong>GSC queries</strong> to see which search terms drive traffic</li>
          <li>Compare quickstart and validator page views — the closest thing to a funnel this stack can produce</li>
        </ol>
      </div>
      <div class="p-4 rounded-xl border border-cabuya-border">
        <h3 class="font-semibold mb-2">Identifying Underperforming Posts</h3>
        <ol class="list-decimal list-inside space-y-1 text-sm text-cabuya-text-secondary">
          <li>Check <strong>GSC Performance</strong> for posts with high impressions but low CTR (&lt;1%)</li>
          <li>Look for pages with traffic and no onward traffic — a page that answers nothing people came for</li>
          <li>Review <strong>Cloudflare Core Web Vitals</strong> for UX issues caused by slow pages</li>
        </ol>
      </div>
      <div class="p-4 rounded-xl border border-cabuya-border">
        <h3 class="font-semibold mb-2">Improving Content Based on Data</h3>
        <ul class="list-disc list-inside space-y-1 text-sm text-cabuya-text-secondary">
          <li><strong>Low CTR in GSC?</strong> Rewrite the title and meta description to be more compelling</li>
          <li><strong>Low scroll depth?</strong> Improve the intro, add visual breaks, shorten paragraphs</li>
          <li><strong>High bounce rate?</strong> Add internal links and related posts to keep readers on-site</li>
          <li><strong>Good traffic but no engagement?</strong> Add calls-to-action and interactive elements</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Environment Variables -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Environment Variables</h2>
    <p class="text-sm text-cabuya-text-secondary mb-4">
      Set these in Cloudflare Pages dashboard (Settings &gt; Environment Variables) for production.
      All are optional — if not set, the corresponding scripts simply don't load.
    </p>
    <p class="text-sm text-cabuya-text-secondary mb-4">
      Google Search Console is verified via DNS TXT (Domain property), so there is no GSC env variable.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-cabuya-border">
            <th class="text-left py-2 px-3 font-semibold">Variable</th>
            <th class="text-left py-2 px-3 font-semibold">Tool</th>
            <th class="text-left py-2 px-3 font-semibold">Where to Get It</th>
          </tr>
        </thead>
        <tbody>
          {envVars.map((v) => (
            <tr class="border-b border-cabuya-border">
              <td class="py-2 px-3"><code class="text-xs bg-cabuya-bg-brand-strong px-1 rounded">{v.name}</code></td>
              <td class="py-2 px-3">{v.tool}</td>
              <td class="py-2 px-3 text-cabuya-text-secondary">{v.where}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Automatic Monitoring -->
  <section class="mb-12">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Automatic Monitoring</h2>
    <div class="p-4 rounded-xl border border-cabuya-success/40 bg-cabuya-success-soft">
      <h3 class="font-semibold mb-2">Lighthouse CI (runs on every PR)</h3>
      <p class="text-sm text-cabuya-text-secondary mb-3">
        Automatically checks Performance, Accessibility, Best Practices, and SEO scores on every pull request.
        No action needed — it runs via GitHub Actions.
      </p>
      <div class="text-sm">
        <p class="font-medium mb-1">Budgets:</p>
        <ul class="list-disc list-inside text-cabuya-text-secondary">
          <li>Performance: &gt;= 95</li>
          <li>Accessibility: = 100</li>
          <li>Best Practices: &gt;= 95</li>
          <li>SEO: &gt;= 95</li>
        </ul>
      </div>
    </div>
  </section>

</InternalLayout>
