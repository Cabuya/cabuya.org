---
import InternalLayout from '@/layouts/InternalLayout.astro';

/**
 * Brand book — Voice & Tone.
 *
 * The five principles come verbatim from the official Manual de Identidad
 * Visual (p. 8). The good/bad pairs are ours, written to make each principle
 * checkable rather than aspirational.
 */

interface Principle {
  name: string;
  definition: string;
  meaning: string;
}

const principles: Principle[] = [
  {
    name: 'Cálido y humano',
    definition: 'como un amigo que inspira a ayudar',
    meaning:
      'Write to one person, not to an audience. Second person, active voice, no institutional distance.',
  },
  {
    name: 'Inspirador y movilizador',
    definition: 'invita a la acción y al cambio',
    meaning:
      'Every section earns its place by making the next step obvious. A paragraph that inspires nothing to do is decoration.',
  },
  {
    name: 'Claro y sencillo',
    definition: 'sin tecnicismos, directo al corazón',
    meaning:
      'Short sentences. Concrete nouns. If a term needs explaining, explain it inline or drop it.',
  },
  {
    name: 'Juvenil y fresco',
    definition: 'cercano a la gente, con energía positiva',
    meaning:
      'Contemporary, unstuffy Spanish. Never slang for its own sake, never corporate register.',
  },
  {
    name: 'Esperanzador',
    definition: 'siempre transmitiendo que sí se puede transformar vidas',
    meaning:
      'The frame is what people can do together, not how bad things are. Never leverage despair.',
  },
];

interface Pair {
  bad: string;
  good: string;
  why: string;
}

const pairsEn: Pair[] = [
  {
    bad: 'We revolutionize humanitarian aid with cutting-edge technology.',
    good: 'We connect people who want to help with those who need it most.',
    why: 'Says what we do instead of how important we think it is.',
  },
  {
    bad: 'Our platform guarantees your donation arrives.',
    good: 'You can see what your contribution was used for, and the evidence behind it.',
    why: 'Claims only what the product actually delivers.',
  },
  {
    bad: 'Empowering vulnerable communities.',
    good: 'Communities organize their own aid. We make it visible.',
    why: 'No savior framing. People receiving aid are neighbours, not beneficiaries of our virtue.',
  },
];

const pairsEs: Pair[] = [
  {
    bad: 'Únete a la revolución solidaria.',
    good: 'Ayuda donde más se necesita.',
    why: 'Una acción concreta en lugar de un eslogan.',
  },
  {
    bad: 'Millones de vidas impactadas.',
    good: 'Cada aporte queda registrado, con su destino y su evidencia.',
    why: 'Una cifra que podemos sostener en vez de una que suena bien.',
  },
  {
    bad: 'Nuestra plataforma garantiza transparencia total.',
    good: 'Publicamos cuánto se recibió y cuánto se usó con evidencia verificada.',
    why: '“Transparencia total” no significa nada. Los dos números sí.',
  },
];

const blocklist = [
  'revolucionario',
  'disruptivo',
  'la mejor plataforma',
  'líder indiscutible',
  'cambiamos el mundo',
  'salvamos vidas',
  'empoderar',
  'sinergia',
  'solución integral',
  'game changer',
  'simplemente',
  'obviamente',
  'sumérgete',
  'desbloquea',
];

const slop = [
  'En un mundo donde…',
  'No es solo X, es Y',
  'Ya sea que… o…',
  'la clave está en',
  'en resumen',
];
---

<InternalLayout
  title="Voice & Tone — Brand Book"
  description="How Corag writes: the five official principles, with checkable examples."
  section="brand"
  subsection="voice-and-tone"
>
  <div class="space-y-10">
    <header class="space-y-3">
      <p class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">
        <a href="/internal/brand" class="hover:underline">Brand</a> / Voice &amp; Tone
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100">Voice &amp; Tone</h1>
      <p class="max-w-3xl text-base text-gray-600 dark:text-gray-300">
        Corag writes the way a friend who has been through it writes: warm, plain,
        hopeful, and specific. The five principles below are quoted from the
        official <strong>Manual de Identidad Visual</strong> (p. 8). They are not
        suggestions — copy that fails them is off-brand.
      </p>
    </header>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">The five principles</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {principles.map((p) => (
          <div class="rounded-xl border border-gray-200 p-5 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{p.name}</h3>
            <p class="mt-1 text-sm italic text-cabuya-primary">{p.definition}</p>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{p.meaning}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-3 rounded-2xl border border-cabuya-border bg-cabuya-bg-brand p-6">
      <h2 class="text-xl font-bold text-cabuya">Two registers, one brand</h2>
      <p class="text-sm text-cabuya-secondary">
        <strong class="text-cabuya">cabuya.org</strong> — this site — is warm, human and
        hopeful. It is where someone decides whether to trust Corag.
      </p>
      <p class="text-sm text-cabuya-secondary">
        <strong class="text-cabuya">ayuda.cabuya.org</strong> during a live emergency is
        operationally direct. When someone needs help right now, clarity beats warmth:
        <em>“Necesito ayuda”</em>, <em>“Quiero ayudar”</em>, <em>“Seguir mi aporte”</em> —
        three words, no adjectives.
      </p>
      <p class="text-sm text-cabuya-secondary">
        Both are Corag. Do not import the app's clipped register into marketing copy,
        and do not import marketing warmth into an emergency flow.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Spanish is the source language</h2>
      <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-300">
        <li>Write Spanish first. English is a real translation of it, never the reverse.</li>
        <li>
          <strong>Diacritics are mandatory</strong> — ñ, á/é/í/ó/ú, ¿…?, ¡…!, and
          interrogative accents (<code>cómo</code>, <code>qué</code>, <code>cuál</code>,
          <code>dónde</code>, <code>cuándo</code>).
        </li>
        <li>Sentence case for headings and UI labels; title case only for proper nouns.</li>
        <li>Colombian Spanish, but avoid regionalisms a reader outside Colombia would miss.</li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Examples — English</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-800">
            <tr class="text-left">
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Don't</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Do</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Why</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            {pairsEn.map((p) => (
              <tr>
                <td class="px-4 py-3 text-gray-500 line-through dark:text-gray-400">{p.bad}</td>
                <td class="px-4 py-3 font-medium text-gray-800 dark:text-gray-100">{p.good}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-gray-300">{p.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Ejemplos — Español</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-800">
            <tr class="text-left">
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Evita</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Escribe</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Por qué</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            {pairsEs.map((p) => (
              <tr>
                <td class="px-4 py-3 text-gray-500 line-through dark:text-gray-400">{p.bad}</td>
                <td class="px-4 py-3 font-medium text-gray-800 dark:text-gray-100">{p.good}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-gray-300">{p.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-3 rounded-2xl border border-cabuya-danger/30 bg-cabuya-danger-soft p-6">
      <h2 class="text-xl font-bold text-cabuya-danger">What warmth does not license</h2>
      <p class="text-sm text-gray-700 dark:text-gray-200">
        Corag handles real aid, real money and real people in bad situations.
        <strong>Confianza</strong> and <strong>Transparencia</strong> are official values.
      </p>
      <ul class="list-inside list-disc space-y-1 text-sm text-gray-700 dark:text-gray-200">
        <li>Never promise what the platform does not guarantee. “Verificado” and “con evidencia” mean specific things — do not blur them.</li>
        <li>Never sensationalize suffering. No disaster imagery, no misery as leverage, no urgency theatre.</li>
        <li>Never publish a live figure this static site cannot verify — link to the app instead.</li>
        <li>Never write savior framing.</li>
      </ul>
    </section>

    <section class="grid gap-6 sm:grid-cols-2">
      <div class="space-y-2">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Word blocklist</h2>
        <div class="flex flex-wrap gap-2">
          {blocklist.map((w) => (
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600 line-through dark:bg-gray-800 dark:text-gray-300">
              {w}
            </span>
          ))}
        </div>
      </div>
      <div class="space-y-2">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">AI-slop scaffolding</h2>
        <div class="flex flex-wrap gap-2">
          {slop.map((w) => (
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600 line-through dark:bg-gray-800 dark:text-gray-300">
              {w}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Naming</h2>
      <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-300">
        <li><strong>Corag</strong> — always capitalized, never “CORAG” in running text. The wordmark itself is lowercase.</li>
        <li><strong>Ayuda Directa</strong> — the flagship product, title case. It lives at <code>ayuda.cabuya.org</code>.</li>
        <li>Corag is <em>el ecosistema de impacto social</em>; Ayuda Directa is one product inside it. Do not use them interchangeably.</li>
        <li>Refer to people who contribute as <strong>colaboradores</strong>, to those coordinating as <strong>líderes</strong>, and to organizations as <strong>aliados</strong>.</li>
      </ul>
    </section>

    <footer class="border-t border-gray-200 pt-6 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">
      Full guidance in <code>docs/BRAND_GUIDE.md</code> §5 and
      <code>docs/WRITING_VOICE_GUIDE.md</code>.
    </footer>
  </div>
</InternalLayout>
