---
import InternalLayout from '@/layouts/InternalLayout.astro';

/**
 * Brand book — voice, banned vocabulary, and what the badge may say.
 *
 * The examples are the content. A rule like "be precise" is unactionable; a
 * pair showing the same sentence written badly and then written honestly is
 * something a contributor can copy.
 *
 * Source: docs/BRAND_GUIDE.md §5–6, itself derived from the founding
 * verbal-identity analysis.
 */

interface Pair {
  topic: string;
  bad: string;
  good: string;
  why: string;
}

const pairs: Pair[] = [
  {
    topic: 'Describing conformance',
    bad: 'Certified Cabuya-compatible platform.',
    good: 'Measured at L2 on 14 March 2026. The report is on the registry page.',
    why: 'Nobody certifies anything here. A measurement has a date, a method and a link; a certificate has an authority we do not have and would not want.',
  },
  {
    topic: 'Describing adoption',
    bad: 'The leading interoperability standard for aid in Latin America.',
    good: 'Four applications publish feeds today. Their entries are in the registry.',
    why: 'A count you can check beats a superlative you cannot. And the count grows on its own.',
  },
  {
    topic: 'Describing what is missing',
    bad: 'Advanced write capabilities coming soon!',
    good: 'L4 (write) is specified but not implemented. The checks exist and are marked unimplemented.',
    why: 'State the limit. A reader who finds the gap themselves stops trusting everything else on the page.',
  },
  {
    topic: 'Asking someone to adopt',
    bad: 'Join the revolution in humanitarian coordination.',
    good: 'Publishing a feed takes one JSON file at a known URL. Here is the smallest one that validates.',
    why: 'The reader is an engineer deciding how much of their week this costs. Answer that question.',
  },
  {
    topic: 'Talking about the other apps',
    bad: 'Fragmented, siloed tools that fail communities.',
    good: 'Each team built what their city needed, quickly. The cost is that the data cannot travel.',
    why: 'Everyone in this network shipped something under pressure. Contempt for their work is both wrong and a bad way to ask for their cooperation.',
  },
  {
    topic: 'An error message',
    bad: 'Invalid feed. Fix your data.',
    good: '/data/places/0 is missing last_confirmed_at. If nobody has confirmed it, publish null — that is a valid answer.',
    why: 'Locate it, name the rule, give the imperative fix. Never blame. The message is read by an agent as often as by a person.',
  },
];

const banned = [
  {
    word: 'revolucionario · revolutionary',
    note: 'Nothing here is a revolution. It is a JSON schema.',
  },
  {
    word: 'disruptivo · disruptive',
    note: 'Disruption is what an emergency does. We are the opposite.',
  },
  { word: 'líder · leading', note: 'Unverifiable and unnecessary.' },
  { word: 'el mejor · the best', note: 'Compared with what, measured how?' },
  {
    word: 'único · unique in the world',
    note: 'Usually false, always unfalsifiable.',
  },
  {
    word: 'certificado · certified',
    note: 'Doubly banned. Conformance is measured; the validator never says this either.',
  },
  {
    word: 'garantizado · guaranteed',
    note: 'We guarantee nothing about a third party’s data.',
  },
  { word: '"Powered by"', note: 'Implies a dependency that does not exist.' },
  {
    word: 'impacto exponencial',
    note: 'A number-shaped phrase with no number in it.',
  },
  { word: 'game-changer · cutting-edge', note: 'Marketing filler.' },
  { word: 'world-class (about ourselves)', note: 'Let someone else say it.' },
  {
    word: 'seamless',
    note: 'Integration work is never seamless, and engineers know it.',
  },
  {
    word: 'innovador as filler',
    note: 'Fine as a fact, meaningless as an adjective.',
  },
];

const badges = [
  {
    text: 'Compatible con Cabuya 1.0',
    ok: true,
    why: 'Version-scoped, backed by a measurement, links to where the measurement is visible.',
  },
  {
    text: 'Cabuya 1.0 compatible',
    ok: true,
    why: 'The English rendition. Same three properties.',
  },
  {
    text: 'Compatible con Cabuya',
    ok: false,
    why: 'Unversioned. The claim rots silently when the spec moves.',
  },
  {
    text: 'Powered by Cabuya',
    ok: false,
    why: 'There is nothing to be powered by. Cabuya is a document, not a service.',
  },
  {
    text: 'Certificado Cabuya',
    ok: false,
    why: 'Banned word, and it implies an authority granting certification. Measurement is what actually happens.',
  },
];
---

<InternalLayout
  title="Voice & badge language"
  description="A serious technical standard that anyone can read — with the examples that make that actionable."
  section="brand"
  subsection="brand-voice"
>
  <!-- ── The register ───────────────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-1">The register</h2>
    <p class="text-sm text-cabuya-text-secondary mb-5 max-w-3xl">
      Calm, concrete, humble, precise. The model is the way a good methodology
      site explains itself to engineers — never the way a startup announces a
      launch. Assume the reader is competent, busy, and skeptical, because they
      are.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {
        [
          {
            title: 'Both languages are first drafts',
            body: 'Spanish is written natively, with ñ, tildes and interrogative accents. English is not a translation of it, nor the reverse.',
          },
          {
            title: 'Normative words stay in spec/',
            body: 'MUST, SHOULD and MAY carry legal weight in a standard. Outside spec/ they are just emphasis, so they are not used.',
          },
          {
            title: 'State the limit',
            body: '"The specification is a draft under review" is better copy than a sentence engineered to avoid saying so.',
          },
          {
            title: 'Rule-0 outranks everything',
            body: 'No invented figures, no endorsement we cannot maintain, no CTA to a channel we do not run, no conformance claim the validator has not measured.',
          },
        ].map((rule) => (
          <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-4">
            <h3 class="text-sm font-semibold mb-1.5">{rule.title}</h3>
            <p class="text-xs text-cabuya-text-secondary leading-relaxed">{rule.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Paired examples ────────────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-1">The same thing, said twice</h2>
    <p class="text-sm text-cabuya-text-secondary mb-5 max-w-3xl">
      Left is what the sentence wants to become on its own. Right is what it
      should say.
    </p>

    <div class="space-y-4">
      {
        pairs.map((pair) => (
          <div class="rounded-xl border border-cabuya-border overflow-hidden">
            <div class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand px-4 py-2 text-xs font-semibold uppercase tracking-wide">
              {pair.topic}
            </div>
            <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-cabuya-border bg-cabuya-bg-elevated">
              <div class="p-4">
                <p class="text-xs font-semibold text-cabuya-danger mb-1.5">✗ Not this</p>
                <p class="text-sm text-cabuya-text-secondary italic">{pair.bad}</p>
              </div>
              <div class="p-4">
                <p class="text-xs font-semibold text-cabuya-success mb-1.5">✓ This</p>
                <p class="text-sm">{pair.good}</p>
              </div>
            </div>
            <p class="border-t border-cabuya-border px-4 py-3 text-xs text-cabuya-text-secondary">
              {pair.why}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Banned vocabulary ──────────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-1">Banned vocabulary</h2>
    <p class="text-sm text-cabuya-text-secondary mb-5 max-w-3xl">
      These are not stylistic preferences. They are the specific words with
      which aid-tech marketing has spent other people's credibility, and they do
      not appear in Cabuya copy in any language.
    </p>
    <div class="rounded-xl border border-cabuya-border overflow-hidden">
      <ul class="divide-y divide-cabuya-border bg-cabuya-bg-elevated">
        {
          banned.map((entry) => (
            <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 px-4 py-2.5">
              <span class="text-sm font-semibold text-cabuya-danger sm:w-72 shrink-0 line-through decoration-cabuya-danger/50">
                {entry.word}
              </span>
              <span class="text-xs text-cabuya-text-secondary">{entry.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Badge language ─────────────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-1">Badge language</h2>
    <p class="text-sm text-cabuya-text-secondary mb-5 max-w-3xl">
      The badge is the one piece of Cabuya copy that appears on somebody else's
      site, where we cannot correct it. It must be version-scoped, backed by a
      measurement, and linked to the page where that measurement is visible.
    </p>

    <div class="mb-6 rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6">
      <p class="text-xs uppercase tracking-widest text-cabuya-text-muted mb-3">Specimen</p>
      <div class="flex flex-wrap gap-3">
        <span class="inline-flex items-center gap-2 rounded-full bg-cabuya-fill text-cabuya-on-fill px-3.5 py-1.5 text-sm font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-cabuya-accent" aria-hidden="true"></span>
          Compatible con Cabuya 1.0
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-cabuya-on-fill text-cabuya-fill border border-cabuya-fill px-3.5 py-1.5 text-sm font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-cabuya-accent-strong" aria-hidden="true"></span>
          Cabuya 1.0 compatible
        </span>
      </div>
      <p class="mt-4 text-xs text-cabuya-text-secondary">
        Forest-on-ivory or ivory-on-forest. The fique strand is the graphic
        element — a dot, a rule, a strand — and never the type colour on a light
        ground.
      </p>
    </div>

    <div class="space-y-2">
      {
        badges.map((badge) => (
          <div
            class:list={[
              'flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 rounded-lg border px-4 py-3',
              badge.ok ? 'border-cabuya-success' : 'border-cabuya-danger',
            ]}
          >
            <span
              class:list={[
                'text-sm font-semibold shrink-0 sm:w-64',
                badge.ok ? 'text-cabuya-success' : 'text-cabuya-danger',
              ]}
            >
              {badge.ok ? '✓' : '✗'} {badge.text}
            </span>
            <span class="text-xs text-cabuya-text-secondary">{badge.why}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Naming ─────────────────────────────────────────── -->
  <section>
    <h2 class="text-xl font-display font-bold mb-4">Naming</h2>
    <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-5">
      <ul class="text-sm text-cabuya-text-secondary space-y-2 list-disc list-inside">
        <li>
          <strong class="text-cabuya-text">Cabuya</strong> — capitalised in running
          text, never "CABUYA". The lowercase form belongs to the wordmark only.
        </li>
        <li>
          <strong class="text-cabuya-text">the Cabuya Protocol</strong> when the
          document is meant; <strong class="text-cabuya-text">Cabuya</strong> alone
          when the project or the community is meant. Not interchangeable with a
          publisher's product name.
        </li>
        <li>
          Versions are written <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">Cabuya 1.0</code>,
          never "v1" or "Cabuya One".
        </li>
        <li>
          <em>cabuya</em> lowercase and italic when the plant fibre itself is
          meant — the word predates us by centuries and the copy should show that.
        </li>
        <li>
          Publishers are <strong class="text-cabuya-text">publishers</strong>, not
          "partners" — partnership implies an agreement nobody signed.
        </li>
      </ul>
    </div>
  </section>
</InternalLayout>
