---
import InternalLayout from '@/layouts/InternalLayout.astro';

interface Row {
  token: string;
  value: string;
  usage: string;
}

const spacing: Row[] = [
  { token: 'space-0', value: '0', usage: 'Reset · flush layouts' },
  { token: 'space-1', value: '0.25rem (4px)', usage: 'Hairline gaps' },
  {
    token: 'space-2',
    value: '0.5rem (8px)',
    usage: 'Tight gaps · icon padding',
  },
  { token: 'space-3', value: '0.75rem (12px)', usage: 'Small gaps · pills' },
  { token: 'space-4', value: '1rem (16px)', usage: 'Default gap unit' },
  {
    token: 'space-6',
    value: '1.5rem (24px)',
    usage: 'Card inner padding · section gaps',
  },
  {
    token: 'space-8',
    value: '2rem (32px)',
    usage: 'Card outer · section spacing',
  },
  {
    token: 'space-12',
    value: '3rem (48px)',
    usage: 'Block padding · large gaps',
  },
  {
    token: 'space-16',
    value: '4rem (64px)',
    usage: 'Section block · page spacing',
  },
  { token: 'space-20', value: '5rem (80px)', usage: 'Large section block' },
  { token: 'space-24', value: '6rem (96px)', usage: 'Hero · page top/bottom' },
  {
    token: 'space-32',
    value: '8rem (128px)',
    usage: 'Hero margin · landing pages',
  },
];

const radius: Row[] = [
  { token: 'radius-none', value: '0', usage: 'Pure block · admin tables' },
  { token: 'radius-sm', value: '0.25rem', usage: 'Inputs · small chips' },
  { token: 'radius-md', value: '0.5rem', usage: 'Buttons · default cards' },
  {
    token: 'radius-lg',
    value: '0.75rem',
    usage: 'Hero cards · feature blocks',
  },
  { token: 'radius-xl', value: '1rem', usage: 'Modals · drawers' },
  { token: 'radius-2xl', value: '1.5rem', usage: 'Large hero panels' },
  {
    token: 'radius-full',
    value: '9999px',
    usage: 'Avatars · pills · status dots',
  },
];

const motion: Row[] = [
  {
    token: 'duration-fast',
    value: '120ms',
    usage: 'Hover · pill toggle · icon tint',
  },
  {
    token: 'duration-base',
    value: '200ms',
    usage: 'Default UI transitions · button press',
  },
  {
    token: 'duration-slow',
    value: '320ms',
    usage: 'Modal open · drawer · page transition',
  },
  {
    token: 'ease-out',
    value: 'cubic-bezier(0, 0, 0.2, 1)',
    usage: 'Default easing for entry/state changes',
  },
  {
    token: 'ease-in-out',
    value: 'cubic-bezier(0.4, 0, 0.2, 1)',
    usage: 'Reversible / scrubbing motion',
  },
];
---

<InternalLayout
  title="Spacing · Radius · Motion"
  description="A short 4px scale, the radius tokens, and the reduced-motion contract."
  section="brand"
  subsection="brand-spacing"
>
  <div class="space-y-12">
    <p class="text-base text-cabuya-text-secondary max-w-3xl">
      Layout primitives built on a 4-pixel base. The scale is deliberately short:
      a small vocabulary is what makes two people — or a person and an agent —
      reach the same composition decision without discussing it.
    </p>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-cabuya-text">Spacing scale</h2>
      <div class="overflow-x-auto rounded-lg border border-cabuya-border">
        <table class="min-w-full text-sm">
          <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand">
            <tr class="text-left">
              <th class="px-4 py-2 font-semibold text-cabuya-text">Token</th>
              <th class="px-4 py-2 font-semibold text-cabuya-text">Value</th>
              <th class="px-4 py-2 font-semibold text-cabuya-text">Usage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cabuya-border">
            {spacing.map((row) => (
              <tr>
                <td class="px-4 py-3 font-mono text-xs text-cabuya-text">{row.token}</td>
                <td class="px-4 py-3 font-mono text-xs text-cabuya-text-secondary">{row.value}</td>
                <td class="px-4 py-3 text-cabuya-text-secondary">{row.usage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-cabuya-text">Radius tokens</h2>
      <div class="overflow-x-auto rounded-lg border border-cabuya-border">
        <table class="min-w-full text-sm">
          <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand">
            <tr class="text-left">
              <th class="px-4 py-2 font-semibold text-cabuya-text">Token</th>
              <th class="px-4 py-2 font-semibold text-cabuya-text">Value</th>
              <th class="px-4 py-2 font-semibold text-cabuya-text">Usage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cabuya-border">
            {radius.map((row) => (
              <tr>
                <td class="px-4 py-3 font-mono text-xs text-cabuya-text">{row.token}</td>
                <td class="px-4 py-3 font-mono text-xs text-cabuya-text-secondary">{row.value}</td>
                <td class="px-4 py-3 text-cabuya-text-secondary">{row.usage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-cabuya-text">Motion tokens</h2>
      <div class="overflow-x-auto rounded-lg border border-cabuya-border">
        <table class="min-w-full text-sm">
          <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand">
            <tr class="text-left">
              <th class="px-4 py-2 font-semibold text-cabuya-text">Token</th>
              <th class="px-4 py-2 font-semibold text-cabuya-text">Value</th>
              <th class="px-4 py-2 font-semibold text-cabuya-text">Usage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cabuya-border">
            {motion.map((row) => (
              <tr>
                <td class="px-4 py-3 font-mono text-xs text-cabuya-text">{row.token}</td>
                <td class="px-4 py-3 font-mono text-xs text-cabuya-text-secondary">{row.value}</td>
                <td class="px-4 py-3 text-cabuya-text-secondary">{row.usage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-cabuya-text">Reduced-motion contract</h2>
      <p class="text-sm text-cabuya-text-secondary">
        All animations and non-essential transitions MUST honor
        <code>@media (prefers-reduced-motion: reduce)</code> and degrade to
        instant changes. This is enforced by Task 19's a11y audit and by the
        global stylesheet:
      </p>
      <pre class="rounded-lg bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand p-4 overflow-x-auto text-xs text-cabuya-text"><code>{`@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}`}</code></pre>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-cabuya-text">Layout shells</h2>
      <ul class="list-disc list-inside text-sm text-cabuya-text-secondary space-y-1">
        <li><code>max-w-5xl mx-auto px-4 sm:px-6</code> — content pages.</li>
        <li><code>max-w-6xl mx-auto px-4 sm:px-6</code> — listings (blog, meetups).</li>
        <li><code>max-w-7xl mx-auto px-4 md:px-6</code> — site shell (`.main-container`).</li>
        <li>Vertical rhythm between major sections: <code>py-16</code> mobile / <code>py-24</code> desktop.</li>
      </ul>
    </section>
  </div>
</InternalLayout>
