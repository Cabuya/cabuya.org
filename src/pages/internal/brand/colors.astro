---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

import InternalLayout from '@/layouts/InternalLayout.astro';
import { measure, parseThemeTokens } from '@/lib/contrast';

/**
 * Brand book — the palette, derived and measured.
 *
 * The previous version of this page listed hexes and ratios by hand and
 * described itself as mirroring `global.css`. It was not: it still printed the
 * pre-migration wine and rosa values months after the tokens changed, and the
 * guard test passed the whole time because it only checked token *names*.
 *
 * So this page no longer holds any colour of its own. It reads
 * `src/styles/global.css` at build time, computes every ratio with
 * `src/lib/contrast.ts`, and prints what it finds. To make an omission
 * impossible rather than unlikely, the group table below is checked for
 * completeness against the stylesheet — a new token with no home **fails the
 * build**, and the error names it.
 */

const CSS = readFileSync(join(process.cwd(), 'src/styles/global.css'), 'utf-8');
const { light, dark } = parseThemeTokens(CSS);

/** How a token earns its contrast number. */
type Kind =
  | 'text' // carries text on the page grounds
  | 'ground' // text sits on it — measure body text against it
  | 'fill' // a filled surface with its own paired foreground
  | 'ui' // borders and non-text UI — the 3:1 threshold
  | 'decor'; // deliberately not text-safe; the number is the warning

interface Entry {
  token: string;
  role: string;
  kind: Kind;
}

interface Group {
  title: string;
  blurb: string;
  entries: Entry[];
}

const GROUPS: Group[] = [
  {
    title: 'Brand foreground',
    blurb:
      'Flips forest → fique in dark mode, because forest on Night measures about 1.9:1.',
    entries: [
      {
        token: 'cabuya-primary',
        role: 'The brand colour in running text and icons',
        kind: 'text',
      },
      {
        token: 'cabuya-primary-strong',
        role: 'Hover · active · pressed',
        kind: 'text',
      },
      {
        token: 'cabuya-primary-soft',
        role: 'Tinted ground behind primary content',
        kind: 'ground',
      },
      {
        token: 'cabuya-primary-light',
        role: 'Seedling; display text on dark canvases',
        kind: 'decor',
      },
      {
        token: 'cabuya',
        role: 'Alias of text — inherits the flip through var()',
        kind: 'text',
      },
      {
        token: 'cabuya-secondary',
        role: 'Alias of text-secondary',
        kind: 'text',
      },
    ],
  },
  {
    title: 'Brand fill — the pair that never flips',
    blurb:
      'A filled brand surface is forest-with-ivory in both themes. This is the split that stops bg-primary + text-white.',
    entries: [
      { token: 'cabuya-fill', role: 'Filled brand surface', kind: 'fill' },
      {
        token: 'cabuya-fill-strong',
        role: 'Pressed state of a filled surface',
        kind: 'fill',
      },
      {
        token: 'cabuya-on-fill',
        role: 'The only foreground allowed on a fill',
        kind: 'decor',
      },
    ],
  },
  {
    title: 'Fique — the golden strand',
    blurb:
      'Raw fique is decorative on light grounds. Its measurement below is the reason, not a footnote.',
    entries: [
      {
        token: 'cabuya-accent',
        role: 'Icons, strands, large display type, the logo',
        kind: 'decor',
      },
      {
        token: 'cabuya-accent-strong',
        role: 'The only text-safe fique on light',
        kind: 'text',
      },
      {
        token: 'cabuya-seedling',
        role: 'Pale green display text on dark canvases',
        kind: 'decor',
      },
      {
        token: 'cabuya-seedling-soft',
        role: 'Palest brand tint',
        kind: 'ground',
      },
    ],
  },
  {
    title: 'Surfaces',
    blurb:
      'Page grounds and elevations. Measured by what body text does on them.',
    entries: [
      { token: 'cabuya-bg', role: 'The page', kind: 'ground' },
      {
        token: 'cabuya-bg-elevated',
        role: 'Cards, panels, raised surfaces',
        kind: 'ground',
      },
      { token: 'cabuya-bg-brand', role: 'Soft brand ground', kind: 'ground' },
      {
        token: 'cabuya-bg-brand-strong',
        role: 'Chips and inline code on brand grounds',
        kind: 'ground',
      },
      {
        token: 'cabuya-bg-dark',
        role: 'Always-dark canvas, in both themes',
        kind: 'decor',
      },
    ],
  },
  {
    title: 'Borders',
    blurb:
      'Non-text UI: the threshold is 3:1, and interactive borders must clear it.',
    entries: [
      { token: 'cabuya-border', role: 'Hairlines and dividers', kind: 'ui' },
      {
        token: 'cabuya-border-strong',
        role: 'Emphasised separation',
        kind: 'ui',
      },
      {
        token: 'cabuya-border-interactive',
        role: 'Inputs, focusable outlines',
        kind: 'ui',
      },
    ],
  },
  {
    title: 'Text',
    blurb:
      'Three weights of legibility. All three clear AA on both light grounds.',
    entries: [
      { token: 'cabuya-text', role: 'Body and headings', kind: 'text' },
      {
        token: 'cabuya-text-secondary',
        role: 'Supporting prose',
        kind: 'text',
      },
      {
        token: 'cabuya-text-muted',
        role: 'Captions and metadata — the floor, not the default',
        kind: 'text',
      },
    ],
  },
  {
    title: 'Status',
    blurb:
      'Each colour ships with a soft ground sized so the colour stays AA when placed on it.',
    entries: [
      {
        token: 'cabuya-success',
        role: 'Confirmed, measured, conforming',
        kind: 'text',
      },
      {
        token: 'cabuya-success-soft',
        role: 'Ground for success',
        kind: 'ground',
      },
      {
        token: 'cabuya-warning',
        role: 'Stale, unmeasured, degraded',
        kind: 'text',
      },
      {
        token: 'cabuya-warning-soft',
        role: 'Ground for warning',
        kind: 'ground',
      },
      { token: 'cabuya-info', role: 'Neutral notes', kind: 'text' },
      { token: 'cabuya-info-soft', role: 'Ground for info', kind: 'ground' },
      {
        token: 'cabuya-danger',
        role: 'Errors and blocked states',
        kind: 'text',
      },
      {
        token: 'cabuya-danger-soft',
        role: 'Ground for danger',
        kind: 'ground',
      },
    ],
  },
];

// ── Completeness, enforced at build time ─────────────────
const grouped = new Set(GROUPS.flatMap((g) => g.entries.map((e) => e.token)));
const declared = Object.keys(light);
const ungrouped = declared.filter((t) => !grouped.has(t)).sort();
const phantom = [...grouped].filter((t) => !light[t]).sort();
if (ungrouped.length > 0 || phantom.length > 0) {
  throw new Error(
    [
      'internal/brand/colors: the palette page and global.css disagree.',
      ungrouped.length > 0
        ? `  declared but not documented: ${ungrouped.join(', ')}`
        : '',
      phantom.length > 0
        ? `  documented but not declared: ${phantom.join(', ')}`
        : '',
      '  Add the token to a group in this page, or remove it from global.css.',
    ]
      .filter(Boolean)
      .join('\n')
  );
}

// ── Measurement ──────────────────────────────────────────
const WHITE = light['cabuya-bg'];
const IVORY = light['cabuya-on-fill'];
const DARK_ELEVATED = dark['cabuya-bg-elevated'];

interface Row {
  token: string;
  role: string;
  kind: Kind;
  lightHex: string;
  darkHex: string;
  flips: boolean;
  lightNote: string;
  darkNote: string;
  lightPass: boolean;
  darkPass: boolean;
}

function rowFor(entry: Entry): Row {
  const lightHex = light[entry.token];
  const darkHex = dark[entry.token];
  const flips = lightHex !== darkHex;

  let lightNote = '—';
  let darkNote = '—';
  let lightPass = true;
  let darkPass = true;

  switch (entry.kind) {
    case 'text': {
      const onWhite = measure(lightHex, WHITE);
      const onIvory = measure(lightHex, IVORY);
      const tighter = onWhite.ratio <= onIvory.ratio ? onWhite : onIvory;
      lightNote = `${tighter.label} on the tighter light ground`;
      lightPass = tighter.body;
      const onDark = measure(darkHex, DARK_ELEVATED);
      darkNote = `${onDark.label} on dark elevated`;
      darkPass = onDark.body;
      break;
    }
    case 'ground': {
      const body = measure(light['cabuya-text'], lightHex);
      lightNote = `body text ${body.label}`;
      lightPass = body.body;
      const bodyDark = measure(dark['cabuya-text'], darkHex);
      darkNote = `body text ${bodyDark.label}`;
      darkPass = bodyDark.body;
      break;
    }
    case 'fill': {
      const pair = measure(light['cabuya-on-fill'], lightHex);
      lightNote = `on-fill ${pair.label}`;
      lightPass = pair.body;
      darkNote = 'identical — never flips';
      darkPass = !flips;
      break;
    }
    case 'ui': {
      const onPage = measure(lightHex, light['cabuya-bg']);
      lightNote = `${onPage.label} vs the page`;
      lightPass = onPage.large;
      const onNight = measure(darkHex, dark['cabuya-bg']);
      darkNote = `${onNight.label} vs the page`;
      darkPass = onNight.large;
      break;
    }
    default: {
      // Decorative or fixed-purpose: state where it IS safe, plainly.
      if (entry.token === 'cabuya-accent') {
        const onWhite = measure(lightHex, WHITE);
        const onNight = measure(lightHex, light['cabuya-bg-dark']);
        lightNote = `${onWhite.label} on white — not text-safe`;
        lightPass = false;
        darkNote = `${onNight.label} on Night — text-safe`;
        darkPass = onNight.body;
      } else if (entry.token === 'cabuya-bg-dark') {
        const ivoryOn = measure(IVORY, lightHex);
        lightNote = `ivory on it ${ivoryOn.label}`;
        lightPass = ivoryOn.body;
        darkNote = 'the same canvas in both themes';
        darkPass = true;
      } else {
        const onNight = measure(lightHex, light['cabuya-bg-dark']);
        lightNote = `${onNight.label} on Night`;
        lightPass = onNight.body;
        darkNote = 'unchanged';
        darkPass = !flips;
      }
      break;
    }
  }
  return {
    token: entry.token,
    role: entry.role,
    kind: entry.kind,
    lightHex,
    darkHex,
    flips,
    lightNote,
    darkNote,
    lightPass,
    darkPass,
  };
}

const groups = GROUPS.map((group) => ({
  ...group,
  rows: group.entries.map(rowFor),
}));

const KIND_LABEL: Record<Kind, string> = {
  text: 'text',
  ground: 'ground',
  fill: 'fill pair',
  ui: 'non-text UI',
  decor: 'decorative',
};
---

<InternalLayout
  title="Palette"
  description="Every token read from global.css and measured at build time. Nothing on this page is typed by hand."
  section="brand"
  subsection="brand-colors"
>
  <section class="mb-10 rounded-xl border border-cabuya-border bg-cabuya-bg-brand/50 dark:bg-cabuya-bg-elevated p-5">
    <h2 class="text-base font-semibold mb-2">How to read this page</h2>
    <p class="text-sm text-cabuya-text-secondary max-w-3xl">
      Hexes come from <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">src/styles/global.css</code>;
      ratios are computed here with the WCAG relative-luminance formula. Each
      token is measured against the ground it actually meets: text against the
      tighter of the two light grounds and against dark elevated, surfaces by
      what body text does on them, borders against the 3:1 non-text threshold.
      A token that fails its own threshold is marked, not hidden — for
      <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">accent</code>
      that failure <em>is</em> the documentation.
    </p>
    <p class="mt-3 text-sm text-cabuya-text-muted">
      {declared.length} tokens declared · all {declared.length} documented below
      — the build fails if those two numbers ever differ.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="mb-12">
        <h2 class="text-xl font-display font-bold mb-1">{group.title}</h2>
        <p class="text-sm text-cabuya-text-secondary mb-4 max-w-3xl">{group.blurb}</p>

        <div class="overflow-x-auto rounded-xl border border-cabuya-border">
          <table class="w-full text-sm min-w-[54rem]">
            <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand text-left">
              <tr>
                <th scope="col" class="px-4 py-2.5 font-semibold">Swatch</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Token</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Light</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Dark</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Measured</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cabuya-border bg-cabuya-bg-elevated">
              {group.rows.map((row) => (
                <tr>
                  <td class="px-4 py-3">
                    <div class="flex gap-1.5">
                      <span
                        class="inline-block w-9 h-9 rounded-md border border-cabuya-border"
                        style={`background:${row.lightHex}`}
                        title={`light: ${row.lightHex}`}
                      />
                      <span
                        class="inline-block w-9 h-9 rounded-md border border-cabuya-border"
                        style={`background:${row.darkHex}`}
                        title={`dark: ${row.darkHex}`}
                      />
                    </div>
                  </td>
                  <td class="px-4 py-3 align-top">
                    <code class="text-xs">--color-{row.token}</code>
                    <p class="mt-1 text-xs text-cabuya-text-secondary max-w-xs">{row.role}</p>
                    <span class="mt-1.5 inline-block rounded-full bg-cabuya-bg-brand-strong px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-wide">
                      {KIND_LABEL[row.kind]}
                    </span>
                  </td>
                  <td class="px-4 py-3 align-top">
                    <code class="text-xs uppercase">{row.lightHex}</code>
                  </td>
                  <td class="px-4 py-3 align-top">
                    <code class="text-xs uppercase">{row.darkHex}</code>
                    {!row.flips && (
                      <p class="mt-1 text-[0.65rem] uppercase tracking-wide text-cabuya-text-muted">
                        no flip
                      </p>
                    )}
                  </td>
                  <td class="px-4 py-3 align-top">
                    <p class={row.lightPass ? 'text-cabuya-success' : 'text-cabuya-danger'}>
                      <span class="font-semibold">{row.lightPass ? 'PASS' : 'FAIL'}</span>
                      <span class="text-cabuya-text-secondary"> light · {row.lightNote}</span>
                    </p>
                    <p class={`mt-1 ${row.darkPass ? 'text-cabuya-success' : 'text-cabuya-danger'}`}>
                      <span class="font-semibold">{row.darkPass ? 'PASS' : 'FAIL'}</span>
                      <span class="text-cabuya-text-secondary"> dark · {row.darkNote}</span>
                    </p>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <section class="rounded-xl border border-cabuya-border p-5">
    <h2 class="text-base font-semibold mb-2">Where the numbers can still be wrong</h2>
    <ul class="text-sm text-cabuya-text-secondary space-y-1.5 list-disc list-inside max-w-3xl">
      <li>
        Contrast is measured against the grounds a token is <em>documented</em> to
        meet. Put a token somewhere it was never meant to go and the number here
        no longer describes it.
      </li>
      <li>
        Opacity utilities are not modelled. <code>bg-cabuya-bg-brand/50</code>
        composites against whatever is behind it, and this page measures the
        solid value.
      </li>
      <li>
        The live per-utility view is at
        <a href="/internal/ui/colors" class="text-cabuya-primary underline underline-offset-2">/internal/ui/colors</a>,
        which reads <code>getComputedStyle</code> in the browser and so catches a
        broken utility that this build-time view cannot see.
      </li>
    </ul>
  </section>
</InternalLayout>
