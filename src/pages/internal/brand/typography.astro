---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

import InternalLayout from '@/layouts/InternalLayout.astro';

/**
 * Brand book — typography.
 *
 * The family names are read out of `global.css` rather than typed here. The
 * previous version documented "Inter Variable" for nine roles; the site has
 * never loaded Inter. A page about type that names the wrong typeface is worse
 * than no page, because it gets quoted.
 */

const CSS = readFileSync(join(process.cwd(), 'src/styles/global.css'), 'utf-8');

const stackFor = (token: string): string =>
  CSS.match(new RegExp(`--font-${token}:\\s*([^;]+);`))?.[1]
    .replace(/\s+/g, ' ')
    .trim() ?? '(not declared)';

const sansStack = stackFor('sans');
const displayStack = stackFor('display');
const firstOf = (stack: string): string =>
  stack.split(',')[0].replace(/"/g, '').trim();

const displayFace = firstOf(displayStack);
const bodyFace = firstOf(sansStack);

/** Self-hosted files, read from disk so the weight list cannot drift. */
const faces = [
  ...CSS.matchAll(/font-family:\s*"([^"]+)"[\s\S]*?src:\s*url\("([^"]+)"/g),
].map((match) => ({ family: match[1], file: match[2] }));
const uniqueFiles = [...new Map(faces.map((f) => [f.file, f])).values()];

interface Role {
  role: string;
  face: 'display' | 'body';
  size: string;
  weight: string;
  tracking: string;
  note: string;
}

const scale: Role[] = [
  {
    role: 'Display',
    face: 'display',
    size: 'clamp(2.5rem, 6vw, 4rem)',
    weight: '700',
    tracking: '-0.02em',
    note: 'Hero statements only. One per page, at most.',
  },
  {
    role: 'H1',
    face: 'display',
    size: '2.25rem → 3rem',
    weight: '700',
    tracking: '-0.02em',
    note: 'The page subject. Exactly one.',
  },
  {
    role: 'H2',
    face: 'display',
    size: '1.5rem → 1.875rem',
    weight: '700',
    tracking: '-0.01em',
    note: 'Section boundaries.',
  },
  {
    role: 'H3',
    face: 'display',
    size: '1.125rem → 1.25rem',
    weight: '600',
    tracking: 'normal',
    note: 'Sub-sections. Never skipped to from H1.',
  },
  {
    role: 'Lead',
    face: 'body',
    size: '1.125rem',
    weight: '400',
    tracking: 'normal',
    note: 'The paragraph under a heading that frames the section.',
  },
  {
    role: 'Body',
    face: 'body',
    size: '1rem',
    weight: '400',
    tracking: 'normal',
    note: 'Line height 1.65. Measure capped near 70 characters.',
  },
  {
    role: 'Small',
    face: 'body',
    size: '0.875rem',
    weight: '400',
    tracking: 'normal',
    note: 'Captions, table cells, metadata.',
  },
  {
    role: 'Eyebrow',
    face: 'body',
    size: '0.75rem',
    weight: '600',
    tracking: '0.1em, uppercase',
    note: 'Section label above a heading. Never a link on its own.',
  },
  {
    role: 'Code',
    face: 'body',
    size: '0.875em',
    weight: '400',
    tracking: 'normal',
    note: 'Monospace stack; inline code sits on a brand-strong chip.',
  },
];
---

<InternalLayout
  title="Typography"
  description={`${displayFace} for display, ${bodyFace} for body — read from the stylesheet, not restated here.`}
  section="brand"
  subsection="brand-typography"
>
  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-1">The two faces</h2>
    <p class="text-sm text-cabuya-text-secondary mb-5 max-w-3xl">
      Both are geometric sans faces in the family of the wordmark's letterforms,
      both are already subset to latin and latin-ext, self-hosted, and loaded
      with <code>font-display: swap</code>. Shipping a third face would spend
      performance budget for a marginal gain — this is recorded as an interim
      decision, revisited only if a bespoke brand face is ever commissioned.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6">
        <p class="text-xs uppercase tracking-widest text-cabuya-text-muted mb-3">Display</p>
        <p class="font-display text-5xl font-bold tracking-tight">{displayFace}</p>
        <p class="font-display text-2xl mt-2">Crecemos juntos</p>
        <p class="mt-4 text-xs text-cabuya-text-secondary break-words">
          <code>--font-display</code>: {displayStack}
        </p>
      </div>
      <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6">
        <p class="text-xs uppercase tracking-widest text-cabuya-text-muted mb-3">Body</p>
        <p class="font-sans text-5xl font-semibold tracking-tight">{bodyFace}</p>
        <p class="font-sans text-base mt-3 leading-relaxed">
          Cada app es un hilo; el protocolo es la cuerda. Ñ, á, é, í, ó, ú, ü, ¿?, ¡!
        </p>
        <p class="mt-4 text-xs text-cabuya-text-secondary break-words">
          <code>--font-sans</code>: {sansStack}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-4">The scale</h2>
    <div class="overflow-x-auto rounded-xl border border-cabuya-border">
      <table class="w-full text-sm min-w-[46rem]">
        <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand text-left">
          <tr>
            <th scope="col" class="px-4 py-2.5 font-semibold">Role</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Face</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Size</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Weight</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Tracking</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Use</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cabuya-border bg-cabuya-bg-elevated">
          {
            scale.map((row) => (
              <tr>
                <td class="px-4 py-3 font-medium">{row.role}</td>
                <td class="px-4 py-3 text-cabuya-text-secondary">
                  {row.face === 'display' ? displayFace : bodyFace}
                </td>
                <td class="px-4 py-3"><code class="text-xs">{row.size}</code></td>
                <td class="px-4 py-3"><code class="text-xs">{row.weight}</code></td>
                <td class="px-4 py-3"><code class="text-xs">{row.tracking}</code></td>
                <td class="px-4 py-3 text-cabuya-text-secondary">{row.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-display font-bold mb-4">Specimen</h2>
    <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6 sm:p-8">
      <p class="text-xs uppercase tracking-[0.1em] font-semibold text-cabuya-text-muted">
        Conformance
      </p>
      <h3 class="mt-2 font-display text-4xl sm:text-5xl font-bold tracking-tight">
        Measured, never declared
      </h3>
      <p class="mt-4 text-lg text-cabuya-text-secondary max-w-2xl">
        A publisher does not tell the registry which level it reaches. The
        validator fetches what is published and reports what it found.
      </p>
      <p class="mt-4 text-base leading-relaxed max-w-2xl">
        That distinction is the whole design. A declared badge is a claim about
        the past; a measured one is a statement about a document that was
        readable at a specific time, by anyone who cares to check. When a feed
        stops resolving, the badge goes with it — which is the point.
      </p>
      <p class="mt-4 text-sm text-cabuya-text-secondary max-w-2xl">
        Bodies of running text are capped near a 70-character measure. Beyond
        that the eye loses the line return, and a specification that is hard to
        read is a specification that gets skimmed.
      </p>
      <p class="mt-4 text-sm">
        Inline code such as
        <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">last_confirmed_at</code>
        keeps its own chip so it never blends into prose.
      </p>
    </div>
  </section>

  <section>
    <h2 class="text-xl font-display font-bold mb-4">Loading</h2>
    <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-5">
      <p class="text-sm text-cabuya-text-secondary mb-4">
        {uniqueFiles.length} self-hosted files, all woff2, all subset. Nothing is
        fetched from a third-party font host — a webfont CDN is a request to
        someone else's server on every page load, and it is not one this project
        needs to make.
      </p>
      <ul class="text-xs space-y-1">
        {
          uniqueFiles.map((face) => (
            <li>
              <code>{face.file}</code>
              <span class="text-cabuya-text-muted"> · {face.family}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</InternalLayout>
