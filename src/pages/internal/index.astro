---
import InternalLayout from '@/layouts/InternalLayout.astro';
import { INTERNAL_SECTIONS, pagesIn } from '@/lib/internal-hub';

/**
 * The hub landing.
 *
 * Both the grid below and the sidebar read `src/lib/internal-hub.ts`, so a page
 * that exists is listed and a page that is listed exists — a unit test holds
 * both directions.
 */

const sections = INTERNAL_SECTIONS.map((section) => ({
  ...section,
  pages: pagesIn(section.id).filter((page) => !page.topLevel),
  entry: pagesIn(section.id).find((page) => page.topLevel),
}));
---

<InternalLayout
  title="Internal Hub"
  description="The dev-only reference for cabuya.org — brand, design system, and how the repository fits together."
  section="hub"
>
  <section class="mb-12 rounded-2xl border border-cabuya-border bg-cabuya-bg-brand/50 dark:bg-cabuya-bg-elevated p-6 sm:p-8">
    <h2 class="text-xl sm:text-2xl font-display font-bold mb-3">
      What this hub is for
    </h2>
    <p class="text-base leading-relaxed text-cabuya-text-secondary max-w-3xl">
      Every rule the project documents in Markdown has a rendered counterpart
      here. A palette entry you can read is a claim; a swatch with its contrast
      measured at build time is evidence. Use this hub when you need to
      <em>see</em> the thing before you build against it.
    </p>
    <p class="mt-4 text-sm text-cabuya-text-muted max-w-3xl">
      Nothing under <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">/internal</code>
      reaches production. It is deleted from the build output, filtered out of
      the sitemap, and marked <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">noindex</code> —
      three independent layers, each covered by a test.
    </p>
  </section>

  {
    sections.map((section) => (
      <section class="mb-12">
        <div class="mb-5">
          <h2 class="text-2xl font-display font-bold">
            {section.entry ? (
              <a href={section.entry.href} class="hover:text-cabuya-primary transition-colors">
                {section.title}
              </a>
            ) : (
              section.title
            )}
          </h2>
          <p class="mt-1 text-sm text-cabuya-text-secondary max-w-3xl">{section.blurb}</p>
        </div>

        {section.pages.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {section.pages.map((page) => (
              <a
                href={page.href}
                class="group rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-5 hover:border-cabuya-primary hover:shadow-sm transition-all"
              >
                <div class="text-base font-semibold mb-1.5 group-hover:text-cabuya-primary transition-colors">
                  {page.title}
                </div>
                <p class="text-sm leading-relaxed text-cabuya-text-secondary">{page.purpose}</p>
              </a>
            ))}
          </div>
        ) : (
          section.entry && (
            <a
              href={section.entry.href}
              class="group inline-flex rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-5 hover:border-cabuya-primary transition-all"
            >
              <div>
                <div class="text-base font-semibold mb-1.5 group-hover:text-cabuya-primary transition-colors">
                  {section.entry.title}
                </div>
                <p class="text-sm text-cabuya-text-secondary">{section.entry.purpose}</p>
              </div>
            </a>
          )
        )}
      </section>
    ))
  }

  <section class="mb-4">
    <h2 class="text-2xl font-display font-bold mb-5">Elsewhere</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="rounded-xl border border-cabuya-border p-5">
        <div class="text-base font-semibold mb-1.5">The written record</div>
        <p class="text-sm text-cabuya-text-secondary">
          <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">docs/</code> holds the
          prose source of truth — <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">BRAND_GUIDE.md</code>,
          <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">DESIGN.md</code>,
          <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">PRODUCT_SPEC.md</code>.
          When a page here and a doc there disagree, the doc is the one to fix
          first, then the page.
        </p>
      </div>
      <div class="rounded-xl border border-cabuya-border p-5">
        <div class="text-base font-semibold mb-1.5">The protocol itself</div>
        <p class="text-sm text-cabuya-text-secondary">
          <code class="rounded bg-cabuya-bg-brand-strong px-1 py-0.5">spec/</code> is CC0 and
          bounded: no imports in, no build step touching it. It is the one
          directory in this repository that another organisation can lift whole.
        </p>
      </div>
    </div>
  </section>
</InternalLayout>
