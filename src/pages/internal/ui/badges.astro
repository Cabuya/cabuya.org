---
import Badge from '@/components/ui/Badge.astro';
import Pill from '@/components/ui/Pill.astro';
import ShowcaseLayout from '@/layouts/ShowcaseLayout.astro';

/**
 * Design system — badges and pills.
 *
 * Rewritten around the real `Badge` component. The previous version documented
 * `SkillBadge.astro` (deleted), blog-post lifecycle states (gone with the
 * blog), and a set of raw Tailwind palette classes that bypassed the token
 * layer entirely — three ways for a showcase page to teach the wrong thing.
 *
 * The rule this page exists to enforce: **a badge's colour is a second signal,
 * never the only one.** Every specimen below is legible with colour removed,
 * which you can verify by reading it in greyscale.
 */

const states = [
  {
    variant: 'measured' as const,
    label: 'Conforming at L2',
    when: 'The validator fetched the document and every check at that level passed.',
  },
  {
    variant: 'unmeasured' as const,
    label: 'Conformance unmeasured',
    when: 'Schema-valid, but the transport checks did not run. Never shown as "conforming".',
  },
  {
    variant: 'non-conformant' as const,
    label: '3 errors',
    when: 'Errors found. The count is part of the label because a bare colour tells you nothing actionable.',
  },
  {
    variant: 'planned' as const,
    label: 'Planned for v0.2',
    when: 'Catalogued and specified, not implemented. Used on checks and on levels this build cannot measure.',
  },
  {
    variant: 'proposed' as const,
    label: 'Proposed entry',
    when: 'In the registry, awaiting confirmation from the team that owns the application. Dashed, because it is provisional.',
  },
  {
    variant: 'draft' as const,
    label: 'Draft 0.1',
    when: 'A specification stage. The version is always part of the label.',
  },
  {
    variant: 'neutral' as const,
    label: 'JSON Feed',
    when: 'A plain category with no state meaning at all.',
  },
];
---

<ShowcaseLayout
  title="Badges"
  description="State labels where colour reinforces the text and never replaces it."
  section="badges"
>
  <section class="mb-12" data-component="badge-states">
    <h2 class="text-xl md:text-2xl font-bold mb-1">States</h2>
    <p class="text-sm text-cabuya-text-secondary mb-5 max-w-3xl">
      Seven variants, each tied to something the system can actually determine.
      There is no "gold" or "premium" — Cabuya has no tiers to sell.
    </p>

    <div class="overflow-x-auto rounded-xl border border-cabuya-border">
      <table class="w-full text-sm min-w-[42rem]">
        <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand text-left">
          <tr>
            <th scope="col" class="px-4 py-2.5 font-semibold">Specimen</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Variant</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">When it applies</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cabuya-border bg-cabuya-bg-elevated">
          {
            states.map((state) => (
              <tr>
                <td class="px-4 py-3 whitespace-nowrap">
                  <Badge variant={state.variant}>{state.label}</Badge>
                </td>
                <td class="px-4 py-3"><code class="text-xs">{state.variant}</code></td>
                <td class="px-4 py-3 text-cabuya-text-secondary">{state.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-12" data-component="badge-sizes">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Sizes</h2>
    <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6 flex flex-wrap items-center gap-3">
      <Badge variant="measured" size="sm">Small — inside a table row</Badge>
      <Badge variant="measured" size="md">Medium — beside a heading</Badge>
    </div>
  </section>

  <section class="mb-12" data-component="pills">
    <h2 class="text-xl md:text-2xl font-bold mb-1">Pills</h2>
    <p class="text-sm text-cabuya-text-secondary mb-4 max-w-3xl">
      A pill is a category or a filter; a badge is a claim about state. When you
      are unsure which you want, ask whether the label could ever be wrong — if
      it could, it is a badge.
    </p>
    <div class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6 space-y-4">
      <div class="flex flex-wrap gap-2">
        <Pill>Default</Pill>
        <Pill variant="primary">Primary</Pill>
        <Pill variant="accent">Accent</Pill>
        <Pill variant="outline">Outline</Pill>
      </div>
      <div class="flex flex-wrap gap-2">
        <Pill href="#" active>L0</Pill>
        <Pill href="#">L1</Pill>
        <Pill href="#">L2</Pill>
        <Pill href="#">L3</Pill>
      </div>
    </div>
  </section>

  <section class="mb-12" data-component="badge-greyscale">
    <h2 class="text-xl md:text-2xl font-bold mb-1">The colour-blind check</h2>
    <p class="text-sm text-cabuya-text-secondary mb-4 max-w-3xl">
      The same row, desaturated. If a specimen becomes ambiguous here, its label
      is doing too little work and needs rewriting — not a stronger colour.
    </p>
    <div
      class="rounded-xl border border-cabuya-border bg-cabuya-bg-elevated p-6 flex flex-wrap gap-3"
      style="filter: grayscale(1)"
    >
      {states.map((state) => <Badge variant={state.variant}>{state.label}</Badge>)}
    </div>
  </section>

  <section class="mt-16 border-t border-cabuya-border pt-8" data-agent-reference="true">
    <h2 class="text-lg font-bold mb-4">Agent reference</h2>
    <pre
      class="rounded-lg bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand p-4 overflow-x-auto text-xs text-cabuya-text"><code>{`import Badge from '@/components/ui/Badge.astro';

<Badge variant="measured">Conforming at L2</Badge>
<Badge variant="unmeasured">Conformance unmeasured</Badge>
<Badge variant="non-conformant">3 errors</Badge>
<Badge variant="planned" size="md">Planned for v0.2</Badge>

// A pill is a category, not a state.
<Pill href="/registry?level=L2" active>L2</Pill>`}</code></pre>
    <p class="mt-3 text-xs text-cabuya-text-muted">
      Do not hand-roll a badge with palette utilities. If a state is missing,
      add a variant to <code>Badge.astro</code> so every instance moves together.
    </p>
  </section>
</ShowcaseLayout>
