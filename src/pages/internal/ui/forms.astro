---
import ShowcaseLayout from '@/layouts/ShowcaseLayout.astro';

const inputStates = [
  { name: 'Default', labelClasses: '', inputExtra: '', helperText: '' },
  {
    name: 'Focus',
    labelClasses: '',
    inputExtra: 'ring-2 ring-cabuya-primary/50 border-cabuya-primary',
    helperText: '',
  },
  {
    name: 'Error',
    labelClasses: 'text-cabuya-danger',
    inputExtra: 'border-cabuya-danger dark:border-cabuya-danger',
    helperText: 'This field is required',
  },
  {
    name: 'Disabled',
    labelClasses: 'opacity-50',
    inputExtra: 'opacity-50 cursor-not-allowed bg-cabuya-bg',
    helperText: '',
  },
];

const formElements = [
  { name: 'Text Input', tag: 'input', usage: 'Single-line text entry' },
  { name: 'Textarea', tag: 'textarea', usage: 'Multi-line text entry' },
  { name: 'Select', tag: 'select', usage: 'Option selection' },
];
---

<ShowcaseLayout title="Forms" description="Input types, states, and form layouts" section="forms">

  <!-- Input Styles -->
  <section class="mb-12" data-component="input-styles">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Input Base Style</h2>
    <p class="text-sm text-cabuya-text-secondary mb-4">
      All form inputs share these common classes from <code class="text-xs">ContactPage.astro</code>:
    </p>
    <div class="rounded-lg border border-cabuya-border p-4 mb-4">
      <code class="text-xs text-cabuya-text-secondary">w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text focus:outline-none focus:ring-2 focus:ring-cabuya-primary/50 focus:border-cabuya-primary transition-colors</code>
    </div>
    <div class="space-y-4 max-w-md">
      <div>
        <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">Text Input</label>
        <input type="text" placeholder="Type something..." class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text focus:outline-none focus:ring-2 focus:ring-cabuya-primary/50 focus:border-cabuya-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">Textarea</label>
        <textarea rows="3" placeholder="Write more here..." class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text focus:outline-none focus:ring-2 focus:ring-cabuya-primary/50 focus:border-cabuya-primary transition-colors"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">Select</label>
        <select class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text focus:outline-none focus:ring-2 focus:ring-cabuya-primary/50 focus:border-cabuya-primary transition-colors">
          <option>Option 1</option>
          <option>Option 2</option>
          <option>Option 3</option>
        </select>
      </div>
    </div>
  </section>

  <!-- States -->
  <section class="mb-12" data-component="input-states">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Input States</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
      {inputStates.map((state) => (
        <div>
          <label class:list={['block text-sm font-medium text-cabuya-text-secondary mb-2', state.labelClasses]}>
            {state.name}
          </label>
          <input
            type="text"
            placeholder={state.name === 'Disabled' ? 'Not editable' : `${state.name} state`}
            disabled={state.name === 'Disabled'}
            class:list={['w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text transition-colors', state.inputExtra]}
          />
          {state.helperText && (
            <p class="mt-1 text-xs text-cabuya-danger">{state.helperText}</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Focus Styles -->
  <section class="mb-12" data-component="focus-styles">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Focus Styles</h2>
    <p class="text-sm text-cabuya-text-secondary mb-4">
      Global focus ring from <code class="text-xs">global.css</code> applies to all interactive elements:
    </p>
    <div class="rounded-lg border border-cabuya-border p-4">
      <code class="text-xs text-cabuya-text-secondary">focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cabuya-primary focus-visible:ring-offset-2</code>
      <p class="mt-2 text-xs text-cabuya-text-secondary">
        This is set globally in <code class="text-xs">global.css</code> and applies to buttons, links, inputs when focused via keyboard.
      </p>
    </div>
  </section>

  <!-- Label Pattern -->
  <section class="mb-12" data-component="labels">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Label & Helper Text</h2>
    <div class="max-w-md space-y-4">
      <div>
        <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">
          Label text
        </label>
        <input type="text" placeholder="Input with label" class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text transition-colors" />
        <p class="mt-1 text-xs text-cabuya-text-secondary">Helper text below input for additional context.</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">
          Required field <span class="text-cabuya-danger">*</span>
        </label>
        <input type="text" placeholder="This field is required" class="w-full p-3 rounded-lg border border-cabuya-danger dark:border-cabuya-danger bg-cabuya-bg-elevated text-cabuya-text transition-colors" />
        <p class="mt-1 text-xs text-cabuya-danger">This field is required.</p>
      </div>
    </div>
  </section>

  <!-- Form Layout -->
  <section class="mb-12" data-component="form-layout">
    <h2 class="text-xl md:text-2xl font-bold mb-4">Form Layout Pattern</h2>
    <p class="text-sm text-cabuya-text-secondary mb-4">
      Two-column responsive grid from ContactPage:
      <code class="text-xs">grid grid-cols-1 md:grid-cols-2 gap-6</code>
    </p>
    <div class="rounded-2xl border border-cabuya-border p-6 max-w-2xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">First Name</label>
          <input type="text" class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">Last Name</label>
          <input type="text" class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text transition-colors" />
        </div>
      </div>
      <div class="mb-6">
        <label class="block text-sm font-medium text-cabuya-text-secondary mb-2">Message</label>
        <textarea rows="3" class="w-full p-3 rounded-lg border border-cabuya-border-strong bg-cabuya-bg-elevated text-cabuya-text transition-colors"></textarea>
      </div>
      <button type="button" class="px-8 py-3 bg-cabuya-fill text-white font-semibold rounded-full hover:bg-cabuya-fill/90 transition-colors shadow-lg hover:shadow-xl">
        Send Message
      </button>
    </div>
  </section>

  <!-- Code Example -->
  <section class="mb-12">
    <details class="rounded-lg border border-cabuya-border">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium hover:bg-cabuya-bg-brand/60">
        Show code
      </summary>
      <pre class="p-4 text-xs overflow-x-auto bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand"><code>&lt;label class="block text-sm font-medium text-cabuya-text-secondary mb-2"&gt;
  Label
&lt;/label&gt;
&lt;input
  type="text"
  class="w-full p-3 rounded-lg border border-cabuya-border-strong
         bg-cabuya-bg-elevated text-cabuya-text
         focus:outline-none focus:ring-2 focus:ring-cabuya-primary/50
         focus:border-cabuya-primary transition-colors"
/&gt;
&lt;p class="mt-1 text-xs text-cabuya-text-secondary"&gt;
  Helper text
&lt;/p&gt;</code></pre>
    </details>
  </section>

  <!-- Agent Reference -->
  <section class="mt-16 border-t border-cabuya-border pt-8" data-agent-reference="true">
    <h2 class="text-lg font-bold mb-4">Agent Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-cabuya-border text-left">
            <th class="py-2 pr-4 font-semibold">Element</th>
            <th class="py-2 pr-4 font-semibold">Tag</th>
            <th class="py-2 font-semibold">Usage</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cabuya-border">
          {formElements.map((el) => (
            <tr>
              <td class="py-2 pr-4 font-medium">{el.name}</td>
              <td class="py-2 pr-4"><code class="text-xs">&lt;{el.tag}&gt;</code></td>
              <td class="py-2 text-cabuya-text-secondary">{el.usage}</td>
            </tr>
          ))}
          <tr>
            <td class="py-2 pr-4 font-medium">Label</td>
            <td class="py-2 pr-4"><code class="text-xs">&lt;label&gt;</code></td>
            <td class="py-2 text-cabuya-text-secondary">text-sm font-medium text-cabuya-text-secondary</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-medium">Helper</td>
            <td class="py-2 pr-4"><code class="text-xs">&lt;p&gt;</code></td>
            <td class="py-2 text-cabuya-text-secondary">text-xs text-cabuya-text-secondary</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</ShowcaseLayout>
