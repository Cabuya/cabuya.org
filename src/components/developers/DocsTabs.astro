---
/**
 * Per-stack snippets, as tabs — built from `<details>` and radio inputs, with
 * no JavaScript.
 *
 * CSS-only because `docs/PERFORMANCE.md` says interactions CSS can express do
 * not get JavaScript, and a tab set is the canonical example. Radio inputs give
 * the keyboard behaviour for free — arrow keys move between tabs, which is
 * exactly the ARIA tab pattern, implemented by the browser rather than by us.
 *
 * The panels are all in the DOM, so a reader with CSS disabled sees every
 * snippet in sequence rather than one and a set of dead labels.
 */
interface Tab {
  id: string;
  label: string;
}

interface Props {
  /** Unique within the page — used to group the radio inputs. */
  name: string;
  tabs: Tab[];
  legend: string;
}

const { name, tabs, legend } = Astro.props;
---

<div class="docs-tabs my-6 rounded-cabuya-sm border border-cabuya-border">
  <fieldset class="flex flex-wrap gap-1 border-b border-cabuya-border p-2">
    <legend class="sr-only">{legend}</legend>
    {
      tabs.map((tab, index) => (
        <span>
          <input
            type="radio"
            name={name}
            id={`${name}-${tab.id}`}
            value={tab.id}
            checked={index === 0}
            class="peer sr-only"
          />
          <label
            for={`${name}-${tab.id}`}
            class="cursor-pointer rounded-md px-3 py-1.5 text-sm text-cabuya-text-secondary transition-colors hover:bg-cabuya-bg-brand peer-checked:bg-cabuya-primary-soft peer-checked:font-medium peer-checked:text-cabuya-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-cabuya-primary"
          >
            {tab.label}
          </label>
        </span>
      ))
    }
  </fieldset>

  <div class="docs-tabs__panels p-1">
    <slot />
  </div>
</div>

<style>
  /*
   * Each panel is `<div data-tab="{id}">`; each tab control is a `<span>`
   * wrapping a radio input. Rule N says: when the Nth span's input is checked,
   * show the Nth panel.
   *
   * The first version of this used `input:nth-of-type(1)`, which matches every
   * input — each one is the first input inside its own span — so two panels
   * showed at once. The position has to be counted on the span, not on the
   * input.
   *
   * Eight rules because the largest tab set on the site is seven (the
   * quickstart's stacks). A ninth tab shows nothing, which is visible
   * immediately rather than subtly wrong.
   */
  .docs-tabs__panels > :global(div[data-tab]) {
    display: none;
  }

  .docs-tabs:has(fieldset > span:nth-of-type(1) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(1)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(2) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(2)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(3) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(3)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(4) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(4)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(5) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(5)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(6) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(6)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(7) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(7)) {
    display: block;
  }
  .docs-tabs:has(fieldset > span:nth-of-type(8) input:checked)
    .docs-tabs__panels
    > :global(div[data-tab]:nth-of-type(8)) {
    display: block;
  }

  /* Without :has(), show every panel rather than none. */
  @supports not selector(:has(*)) {
    .docs-tabs__panels > :global(div[data-tab]) {
      display: block;
    }
  }
</style>
