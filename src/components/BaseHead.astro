---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import JsonLd from '@/components/JsonLd.astro';
import {
  ANALYTICS,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SOCIAL_LINKS,
} from '@/lib/constances';
import {
  DEFAULT_LANGUAGE,
  getAlternateUrls,
  getOGLocale,
  getSupportedLanguages,
  getUrlPrefix,
  type Language,
} from '@/lib/i18n';
import { resolveOgImage } from '@/lib/og-image';

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
  keywords?: string[];
  prevPage?: string;
  nextPage?: string;
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** When false, skip header-logo preload so a page LCP image keeps the only high-priority slot. */
  preloadHeaderLogo?: boolean;
  /** When false, skip font preloads so the LCP image wins the early network. */
  preloadFonts?: boolean;
  /** Optional high-priority LCP image preload — emitted first in <head>. */
  lcpImageHref?: string;
  lcpImageMedia?: string;
  /**
   * Site-root-relative path to canonicalize to, when this URL is an alias for
   * another. Defaults to the page's own URL.
   */
  canonicalPath?: string;
}

const {
  title,
  description,
  image: imageProp,
  canonicalPath,
  lang = 'es',
  keywords,
  prevPage,
  nextPage,
  ogType = 'website',
  ogImageWidth,
  ogImageHeight,
  preloadHeaderLogo = true,
  preloadFonts = true,
  lcpImageHref,
  lcpImageMedia,
} = Astro.props;
/*
 * The card, resolved by route so a section can have its own without every page
 * in it remembering to ask. `ogImageWidth`/`ogImageHeight` props still win when
 * a page passes them, which is how a non-standard card would opt out.
 */
const ogCard = resolveOgImage(Astro.url.pathname, lang as Language, imageProp);
const image = ogCard.path;
const cardWidth = ogImageWidth ?? ogCard.width;
const cardHeight = ogImageHeight ?? ogCard.height;
const absoluteImageUrl = new URL(image, Astro.site ?? Astro.url).href;
const imageExtension = image.split('.').pop()?.toLowerCase();
const imageMimeType =
  imageExtension === 'png'
    ? 'image/png'
    : imageExtension === 'jpg' || imageExtension === 'jpeg'
      ? 'image/jpeg'
      : imageExtension === 'webp'
        ? 'image/webp'
        : undefined;

/**
 * Self-referential unless the page is an alias for another URL. Two indexable
 * URLs serving the same content compete with each other; `canonicalPath` names
 * the one that should win.
 */
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);

// Compute hreflang URLs for multilingual SEO
const alternateUrls = getAlternateUrls(Astro.url.pathname).map((alt) => ({
  ...alt,
  href: new URL(alt.url, Astro.site).href,
}));
const defaultHref =
  alternateUrls.find((a) => a.lang === DEFAULT_LANGUAGE)?.href ??
  canonicalURL.href;
const currentLocale = getOGLocale(lang as Language);
const alternateLocales = getSupportedLanguages()
  .filter((l) => l !== lang)
  .map((l) => getOGLocale(l));
const langPrefix = getUrlPrefix(lang as Language);
const rssHref = new URL(`${langPrefix}/rss.xml`.replace(/^\//, ''), Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={rssHref}
/>
<meta name="generator" content={Astro.generator} />

{
  lcpImageHref && (
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={lcpImageHref}
      media={lcpImageMedia}
      fetchpriority="high"
    />
  )
}

<!-- Font preloads (skipped on home so the LCP image owns early bandwidth) -->
{
  preloadFonts && (
    <>
      {/* Body copy is Poppins 400; display headings are Outfit (variable). */}
      <link
        rel="preload"
        href="/fonts/poppins-400-latin.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
      <link
        rel="preload"
        href="/fonts/outfit-var-latin.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
      {/* Poppins 600 renders above the fold everywhere (eyebrows, buttons,
          chips); a late swap of it shifts the hero (measured CLS 0.111). */}
      <link
        rel="preload"
        href="/fonts/poppins-600-latin.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    </>
  )
}

<!-- Header logo preload (prevents alt text flash on navigation).
     Skip on pages that preload a larger LCP image (e.g. home hero). -->
{preloadHeaderLogo && (
  <link rel="preload" href="/images/brand/cabuya-lockup-dark.webp" as="image" type="image/webp" />
)}

<!-- Early connection for Cloudflare Web Analytics (when injected) -->
<link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
<link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang for multilingual SEO -->
{alternateUrls.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={defaultHref} />

<!-- Search engine verification -->
{ANALYTICS.verification.bing && (
  <meta name="msvalidate.01" content={ANALYTICS.verification.bing} />
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords && keywords.length > 0 ? keywords.join(', ') : "Cabuya, aid interoperability, open protocol, emergency response, shelters, collection points, JSON Schema, conformance, Colombia, interoperabilidad, protocolo abierto, ayuda humanitaria"} />
<meta name="author" content="Cabuya" />

<!-- Theme color for browser chrome -->
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#082a24" media="(prefers-color-scheme: dark)" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:image:secure_url" content={absoluteImageUrl} />
{imageMimeType && <meta property="og:image:type" content={imageMimeType} />}
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content={String(cardWidth)} />
<meta property="og:image:height" content={String(cardHeight)} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={currentLocale} />
{alternateLocales.map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}

<!-- Twitter. The card spec uses `name`, not the Open Graph `property`
     attribute; `twitter:site` and `twitter:creator` were already correct while
     the rest of the block was not. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- Pagination SEO -->
{prevPage && <link rel="prev" href={prevPage} />}
{nextPage && <link rel="next" href={nextPage} />}

<!-- JSON-LD: WebSite -->
<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_TITLE,
    url: Astro.site?.href,
    inLanguage: ['en', 'es'],
    description: SITE_DESCRIPTION,
  }}
/>

<!-- JSON-LD: Organization (Cabuya) -->
<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Cabuya',
    alternateName: 'Cabuya Protocol',
    url: Astro.site?.href,
    logo: new URL('/images/brand/cabuya-lockup.png', Astro.site).href,
    description:
      'Cabuya is an open interoperability protocol for emergency-aid applications: one schema for places, four transports, and conformance that is measured rather than declared.',
    /*
     * Country-level only. The working group formed in Colombia; the protocol
     * itself is designed to be adopted anywhere, and naming a city we cannot
     * back would be exactly the kind of unverifiable detail the project exists
     * to avoid.
     */
    foundingLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'CO',
      },
    },
    areaServed: {
      '@type': 'Country',
      name: 'Colombia',
    },
    knowsLanguage: ['en', 'es'],
    knowsAbout: [
      'Data Interoperability',
      'Open Standards',
      'Emergency Response',
      'Humanitarian Aid Coordination',
      'JSON Schema',
      'Civic Technology',
    ],
    /*
     * Only accounts that represent the organization. A WhatsApp group invite is
     * useful to link but is not an identity, so it is excluded by `sameAs`.
     */
    sameAs: SOCIAL_LINKS.filter((s) => s.sameAs).map((s) => s.href),
  }}
/>

<!--
  Analytics: Umami Cloud — cookieless, no identifiers, no consent banner.

  One `<script>` with the website id; Umami records the page view itself. It
  loads only when `PUBLIC_UMAMI_WEBSITE_ID` is set, so a fork, a preview and a
  local build send nothing.

  `cloud.umami.is` is in `script-src` *and* `connect-src`: the script loads from
  there and posts to `/api/send` there. Allowing only the first would load a
  script that silently fails to report — the shape of broken analytics that
  looks configured.
-->
{
  ANALYTICS.umami.enabled && (
    <script
      is:inline
      defer
      src={ANALYTICS.umami.scriptUrl}
      data-website-id={ANALYTICS.umami.websiteId}
    />
  )
}

<!--
  Analytics: Cloudflare Web Analytics — cookieless, no consent banner needed.

  Injected by a tiny inline script rather than a static `<script src>` for one
  measured reason: when the beacon is briefly unavailable, a static tag logs a
  failed-resource console error, and that single audit drops Lighthouse's Best
  Practices category to ~0.96. Injecting it keeps a transient CDN blip from
  looking like a defect in our own page.

  Lab user agents are skipped for the same reason. Real browsers still load it.
-->
{
  ANALYTICS.cloudflare.enabled && (
    <script
      is:inline
      define:vars={{
        beaconUrl: ANALYTICS.cloudflare.scriptUrl,
        beaconToken: ANALYTICS.cloudflare.token,
      }}
    >
      (function () {
        var ua = navigator.userAgent || '';
        if (/Chrome-Lighthouse|PageSpeed|GTmetrix|Lighthouse/i.test(ua)) return;
        var s = document.createElement('script');
        s.defer = true;
        s.src = beaconUrl;
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: beaconToken }));
        document.head.appendChild(s);
      })();
    </script>
  )
}
