---
/**
 * Ally card for communities and companies — horizontal wordmark, not a circle.
 */

import type { CollectionEntry } from 'astro:content';
import { type Language, tr } from '@/lib/i18n';

interface Props {
  ally: CollectionEntry<'allies'>;
  lang: Language;
  loading?: 'lazy' | 'eager';
}

const { ally, lang, loading = 'lazy' } = Astro.props;

const role = tr(ally.data.role, lang);
const bio = tr(ally.data.bio, lang);
const kindLabels: Record<
  CollectionEntry<'allies'>['data']['kind'],
  { en: string; es: string }
> = {
  community: { en: 'Community', es: 'Comunidad' },
  company: { en: 'Company', es: 'Empresa' },
  organization: { en: 'Organization', es: 'Organización' },
};

const kindLabel = kindLabels[ally.data.kind][lang];
const logoAlt =
  lang === 'es' ? `Logo de ${ally.data.name}` : `${ally.data.name} logo`;
const visitLabel = lang === 'es' ? 'Visitar sitio' : 'Visit site';
const logoDark = ally.data.logoDark ?? ally.data.logo;
---

<article
  class="group flex h-full flex-col rounded-2xl bg-corag-bg-elevated p-6 shadow-sm ring-1 ring-corag-border transition hover:shadow-lg hover:ring-corag-primary/30 motion-reduce:transition-none"
>
  {
    ally.data.url ? (
      <a
        href={ally.data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-full flex-col rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-primary"
      >
        <div class="flex h-14 items-center">
          <img
            decoding="async"
            src={ally.data.logo}
            alt={logoAlt}
            width="240"
            height="59"
            loading={loading}
            class="h-10 w-auto max-w-full object-contain object-left dark:hidden sm:h-12"
          />
          <img
            decoding="async"
            src={logoDark}
            alt=""
            width="240"
            height="59"
            loading={loading}
            class="hidden h-10 w-auto max-w-full object-contain object-left dark:block sm:h-12"
            aria-hidden="true"
          />
        </div>
        <p class="mt-4 text-sm font-medium text-corag-primary dark:text-corag-primary-light">
          {role}
        </p>
        <p class="mt-2 inline-flex w-fit items-center rounded-full bg-corag-primary-soft px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-corag-secondary">
          {kindLabel}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-corag-secondary line-clamp-4">
          {bio}
        </p>
        <p class="mt-auto pt-4 text-sm font-semibold text-corag-primary dark:text-corag-primary-light">
          {visitLabel}
          <span aria-hidden="true"> →</span>
        </p>
      </a>
    ) : (
      <div class="flex h-full flex-col">
        <div class="flex h-14 items-center">
          <img
            decoding="async"
            src={ally.data.logo}
            alt={logoAlt}
            width="240"
            height="59"
            loading={loading}
            class="h-10 w-auto max-w-full object-contain object-left dark:hidden sm:h-12"
          />
          <img
            decoding="async"
            src={logoDark}
            alt=""
            width="240"
            height="59"
            loading={loading}
            class="hidden h-10 w-auto max-w-full object-contain object-left dark:block sm:h-12"
            aria-hidden="true"
          />
        </div>
        <p class="mt-4 text-sm font-medium text-corag-primary dark:text-corag-primary-light">
          {role}
        </p>
        <p class="mt-2 inline-flex w-fit items-center rounded-full bg-corag-primary-soft px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-corag-secondary">
          {kindLabel}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-corag-secondary line-clamp-4">
          {bio}
        </p>
      </div>
    )
  }
</article>
