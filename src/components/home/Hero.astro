---
/**
 * The landing hero.
 *
 * From `lg` it fills the viewport below the chrome — `100dvh` minus the sticky
 * header, which `MainLayout` keeps measured in `--cabuya-chrome-height`. The
 * draft banner is deliberately not subtracted: it scrolls away and never comes
 * back, so netting it out would leave a permanent gap once it is gone. Below
 * `lg` the section is its content's height, because a phone that reserves a
 * whole screen for a headline has spent the fold on nothing.
 *
 * Filling a screen only works if the copy is short enough to fit one. The
 * pitch is the two sentences MESSAGING.md gives this surface and no more; the
 * afternoon claim belongs to the quickstart and the permissionless claim to
 * the thesis section, and both were saying it here too.
 *
 * The art column drops its top padding at `lg` so the rope's cut top lands
 * flush on the header's bottom rule — it reads as descending out of the
 * chrome, not as a drawing that was trimmed — and stretches to the fold, so
 * the fibres end where the page does. The layout is still built so that the
 * art's absence costs nothing: flip `HERO_ART.present` off and the copy column
 * simply takes the width. No placeholder box, per the integration guide.
 */
import Illustration from '@/components/editorial/Illustration.astro';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

/**
 * Both routes ship now (Tasks 24 and 28), so both CTAs are links and the
 * honest "these are still being written" note underneath them is gone. Set a
 * target back to `null` and the label renders as plain emphasis rather than a
 * dead link — Rule-0 holds either way.
 */
const CTA_TARGETS: { primary: string | null; secondary: string | null } = {
  primary: `${getUrlPrefix(lang)}/developers/quickstart`,
  secondary: `${getUrlPrefix(lang)}/registry`,
};

/**
 * The illustration slot.
 *
 * The asset and its intrinsic size come from `src/lib/illustrations.ts`; the
 * component enforces the pack's rules. Two things are specific to this surface:
 *
 * - **It renders on every viewport.** It used to be `hidden lg:flex`, which
 *   meant the site's one flagship drawing was invisible to a phone — the
 *   majority of readers.
 * - **Two framings, one fetch.** Under the header the rope bleeds off the top
 *   edge and reads as descending out of the chrome. Below `lg` the art is a
 *   full-bleed band showing the fan of fibres, with everything above it faded
 *   into the ground: a whole 4:5 drawing shrunk to fit a phone column is a
 *   thumbnail of a hero rather than a hero. The registry entry therefore carries
 *   a `mobile` framing flush at its bottom edge, served through a `media` source
 *   so only one file is downloaded — see the `<style>` block below for the crop
 *   and the fade.
 *
 * Flip `present` off and the copy column simply takes the width: no
 * placeholder box, per the integration guide.
 */
const HERO_ART = { present: true };
---

<section
  class="main-container flex flex-col justify-center pt-16 pb-20 sm:pt-24 sm:pb-28 lg:min-h-[calc(100dvh-var(--cabuya-chrome-height))] lg:py-0"
>
  <div
    class="grid items-center gap-12 lg:min-h-[calc(100dvh-var(--cabuya-chrome-height))] lg:grid-cols-[minmax(0,34rem)_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[minmax(0,38rem)_minmax(0,1fr)]"
  >
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-cabuya-accent-strong">
        {t.home.hero.eyebrow}
      </p>
      <h1 class="mt-4 max-w-3xl text-display text-cabuya-primary">
        {t.home.hero.title}
      </h1>
      <p class="measure mt-7 text-lg leading-relaxed text-cabuya-text-secondary">
        {t.home.hero.pitch}
      </p>
      <p class="measure mt-4 text-base leading-relaxed text-cabuya-text-secondary">
        {t.home.hero.pitchSecond}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        {
          CTA_TARGETS.primary ? (
            <a
              href={CTA_TARGETS.primary}
              class="rounded-cabuya-sm bg-cabuya-fill px-6 py-3 font-medium text-cabuya-on-fill transition-colors hover:bg-cabuya-fill-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cabuya-primary"
            >
              {t.home.hero.ctaPrimary}
            </a>
          ) : (
            <span class="rounded-cabuya-sm border border-dashed border-cabuya-border-strong px-6 py-3 font-medium text-cabuya-text-muted">
              {t.home.hero.ctaPrimary}
            </span>
          )
        }
        {
          CTA_TARGETS.secondary ? (
            <a
              href={CTA_TARGETS.secondary}
              class="rounded-cabuya-sm border border-cabuya-border-interactive px-6 py-3 font-medium text-cabuya-primary transition-colors hover:bg-cabuya-primary-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cabuya-primary"
            >
              {t.home.hero.ctaSecondary}
            </a>
          ) : (
            <span class="rounded-cabuya-sm border border-dashed border-cabuya-border-strong px-6 py-3 font-medium text-cabuya-text-muted">
              {t.home.hero.ctaSecondary}
            </span>
          )
        }
      </div>
    </div>

    {
      HERO_ART.present && (
        <div class="hero-art -mx-4 mt-2 md:-mx-6 lg:mx-0 lg:mt-0 lg:flex lg:items-start lg:justify-end lg:self-stretch">
          <Illustration
            id="hero-cordage"
            loading="eager"
            priority
            class="h-52 w-full object-cover object-bottom sm:h-64 lg:h-full lg:w-auto lg:max-w-full lg:object-contain lg:object-top"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  /*
   * Below `lg` the phone gets the bottom of the drawing, not a shrunken copy.
   *
   * `object-cover` with `object-bottom` keeps the full width and crops height
   * from the top, so what survives is the fan of fibres — the part that reads at
   * 208px tall. Nothing is cropped horizontally, which is the crop that would
   * actually damage this composition, and the narrow framing of the asset is
   * flush at its bottom edge so the frayed ends meet the edge of the band.
   *
   * The mask is what makes the crop honest: without it the rope would start at a
   * hard horizontal edge in the middle of the page, which looks like a mistake
   * rather than a choice. Fading the top third into the ground is the same
   * "feather into the paper" the illustration brief asks of every edge — and it
   * works in both themes because it fades alpha, not a colour.
   *
   * From `lg` the mask comes off: there the art is the full drawing, hung from
   * the header with its own top bleed, and a fade would erase the rope.
   */
  .hero-art img {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(0 0 0 / 0.35) 22%,
      #000 55%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(0 0 0 / 0.35) 22%,
      #000 55%
    );
  }

  @media (min-width: 1024px) {
    .hero-art img {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
