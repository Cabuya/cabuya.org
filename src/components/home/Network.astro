---
/**
 * The network diagram, and the registry as it actually stands today.
 *
 * Rule-0 constraints, both load-bearing:
 *
 * 1. **Only entries that exist**, rendered from the registry tree through its
 *    loader — no illustrative examples, no "and others".
 * 2. **Their real state.** Every wave-0 entry is `proposed`: opened on the
 *    team's behalf from the public analysis, and not yet confirmed by them.
 *    The table says so in words, not in a colour, and the explainer under it
 *    says it again in a full sentence. An unqualified list of four app names
 *    on a protocol's landing page reads as endorsement, and none of these
 *    teams has agreed to anything.
 *
 * There is no count anywhere in this section. "Four applications" invites the
 * reader to treat it as traction; the table shows what there is.
 */
import NetworkFlow from '@/components/diagrams/protocol/NetworkFlow.astro';
import Kicker from '@/components/editorial/Kicker.astro';
import Lead from '@/components/editorial/Lead.astro';
import type { Language } from '@/lib/i18n';
import { displayHost, publishersForDisplay } from '@/lib/registry-loader';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const publishers = publishersForDisplay();
---

<section class="main-container py-16 sm:py-24">
  <Kicker>{t.home.network.kicker}</Kicker>
  <h2 class="mt-3 text-title">{t.home.network.title}</h2>
  <Lead class="mt-4">{t.home.network.lead}</Lead>

  <div class="mt-10">
    <NetworkFlow lang={lang} />
  </div>

  {
    publishers.length > 0 && (
      <div class="mt-12">
        <div class="overflow-x-auto rounded-cabuya-md border border-cabuya-border">
          <table class="w-full text-sm">
            <thead class="bg-cabuya-bg-brand/60 dark:bg-cabuya-bg-brand text-left">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold">
                  {t.home.network.tableHead.publisher}
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  {t.home.network.tableHead.domains}
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  {t.home.network.tableHead.state}
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cabuya-border bg-cabuya-bg-elevated">
              {publishers.map((entry) => (
                <tr>
                  <td class="px-4 py-3">
                    <a
                      href={entry.canonical_url}
                      rel="noopener nofollow"
                      target="_blank"
                      class="text-cabuya-primary underline underline-offset-2"
                    >
                      {displayHost(entry)}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-cabuya-text-secondary">
                    {entry.entity_domains.join(', ')}
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center rounded-md border border-dashed border-cabuya-border-strong px-2 py-0.5 text-xs font-semibold text-cabuya-text-secondary">
                      {t.home.network.proposedLabel}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="measure mt-5 text-sm text-cabuya-text-secondary">
          {t.home.network.proposedExplainer}
        </p>
        <p class="measure mt-3 text-sm text-cabuya-text-muted">
          {t.home.network.measuredNote}
        </p>
      </div>
    )
  }
</section>
