---
/**
 * Where this could go.
 *
 * Rule-0 constraint: **explicitly labelled as ambition.** The label is not
 * decoration and not modesty — a reader deciding whether to spend an afternoon
 * on this deserves to know which parts are built and which are hoped for, and
 * the fastest way to lose that reader is to let them discover the difference
 * on their own.
 */
import Kicker from '@/components/editorial/Kicker.astro';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="border-y border-cabuya-border bg-cabuya-bg-brand/40 dark:bg-cabuya-bg-elevated">
  <div class="main-container py-16 sm:py-24">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
      <Kicker>{t.home.horizon.kicker}</Kicker>
      <span class="rounded-full border border-cabuya-accent-strong px-2.5 py-0.5 text-xs font-semibold text-cabuya-accent-strong">
        {t.home.horizon.ambitionLabel}
      </span>
    </div>
    <h2 class="mt-3 text-title">{t.home.horizon.title}</h2>

    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        t.home.horizon.stages.map((stage, index) => (
          <li>
            <div class="flex items-center gap-3">
              <span class="font-display text-2xl font-bold text-cabuya-accent-strong">
                {index + 1}
              </span>
              <span class="h-px flex-1 bg-cabuya-border" />
            </div>
            <h3 class="mt-3 font-display text-base font-semibold">{stage.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cabuya-text-secondary">
              {stage.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
