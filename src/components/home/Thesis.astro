---
/**
 * The founding sentence, and the argument behind it.
 *
 * Rule-0 constraint from the section table: this is stated as **intent, never
 * as an achieved outcome**. The closing note is not hedging — the network does
 * not exist yet, and a page that implied otherwise would be making exactly the
 * kind of claim the protocol was built to stop other people making.
 *
 * The principle leads in the reader's own language, and the Spanish original is
 * credited beneath it on the English page. It is a phrase the working group said
 * in Spanish, and dropping it would erase where the project came from — but
 * printing it first on an English page made a reader translate a sentence before
 * they could read the argument it introduces. Both lines are always present; only
 * the order changes, and `lang="es"` follows the Spanish one.
 */
import Kicker from '@/components/editorial/Kicker.astro';
import SectionOrnament from '@/components/editorial/SectionOrnament.astro';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

/**
 * Which of the two lines is in Spanish.
 *
 * On `/es` the principle is the Spanish original and the page is already Spanish,
 * so neither line needs marking. On `/` the principle reads in English and the
 * line beneath it is the original — that one gets `lang="es"`.
 */
const quoteLang = undefined;
const glossLang = lang === 'en' ? 'es' : undefined;
---

<section class="border-y border-cabuya-border bg-cabuya-bg-brand/40 dark:bg-cabuya-bg-elevated">
  <div class="main-container py-20 sm:py-28">
    <Kicker>{t.home.thesis.kicker}</Kicker>
    {/*
      The quote is the loudest thing on the page after the headline, and it should
      be: this section is the argument the rest of the site rests on. It was set
      at `text-title` in a 3xl measure, which read as a subheading rather than as
      a thesis.

      `lang="es"` follows the Spanish, wherever the Spanish is. On the English
      page the sentence reads in English and the original is credited beneath it;
      on the Spanish page the original *is* the sentence and the line beneath is
      the fibre gloss. Marking the wrong line would tell a screen reader to read
      English with Spanish pronunciation rules.
    */}
    <blockquote class="mt-6 max-w-4xl">
      <p class="text-balance text-display text-cabuya-primary" lang={quoteLang}>
        {t.home.thesis.principle}
      </p>
      {/*
        Italic only when it is the credited original: an English reader needs the
        line to look like a quotation from somewhere else, while on `/es` it is
        the section's own gloss and italics would be noise.
      */}
      <footer
        class:list={[
          'mt-5 text-lg text-cabuya-text-secondary sm:text-xl',
          glossLang === 'es' && 'italic',
        ]}
        lang={glossLang}
      >
        {t.home.thesis.gloss}
      </footer>
    </blockquote>

    <div class="mt-14 grid max-w-5xl gap-8 md:grid-cols-2 md:gap-12">
      <p class="text-lg leading-relaxed text-cabuya-text-secondary">
        {t.home.thesis.body}
      </p>
      <p class="text-lg leading-relaxed text-cabuya-text-secondary">
        {t.home.thesis.bodySecond}
      </p>
    </div>

    <p
      class="mt-12 max-w-3xl border-l-2 border-cabuya-accent pl-5 text-base text-cabuya-text-muted"
    >
      {t.home.thesis.intentNote}
    </p>

    {/*
      `MK-03` closes the section rather than dividing two of them.

      The landing's seams all carry a rule already, and the ornament's entry is
      explicit that it stands in for one. As a closing mark under the argument it
      does the job it was drawn for: a breath after the thesis, in the project's
      own vocabulary instead of an asterisk.
    */}
    <SectionOrnament class="mt-16 sm:mt-20" size="lg" />
  </div>
</section>
