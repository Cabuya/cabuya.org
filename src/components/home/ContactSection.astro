---
import { SOCIAL_LINKS } from '@/lib/constances';
import type { Language } from '@/lib/translations';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
---

<section
  id="contacto"
  class="relative overflow-hidden py-20 sm:py-24 bg-cabuya-bg-dark text-white"
>
  <div aria-hidden="true" class="absolute inset-0">
    <img
      src="/images/home/hero-dark.webp"
      alt=""
      width={1920}
      height={768}
      class="h-full w-full object-cover opacity-30"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-cabuya-bg-dark via-cabuya-bg-dark/85 to-cabuya-bg-dark/70"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-3xl px-4 text-center">
    <p
      class="text-xs font-semibold uppercase tracking-[0.2em] text-cabuya-accent-strong"
    >
      {lang === 'es' ? 'Comunidad' : 'Community'}
    </p>
    <h2
      class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white"
    >
      {t.contactSection.title}
    </h2>
    <p
      class="mt-4 text-base sm:text-lg text-white/85 max-w-xl mx-auto leading-relaxed"
    >
      {t.contactSection.description}
    </p>

    <ul class="mt-8 flex justify-center gap-3 sm:gap-4" role="list">
      {
        SOCIAL_LINKS.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-white/25 text-white/90 transition-colors hover:bg-white/10 hover:text-white"
            >
              <img
                src={`/icons/${social.icon}_white.svg`}
                alt=""
                width={22}
                height={22}
                loading="lazy"
                decoding="async"
                class="h-5 w-5"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={t.contactSection.ctaLink}
      class="mt-10 inline-flex min-h-[44px] items-center gap-2 rounded-full bg-cabuya-accent px-8 py-3.5 text-sm sm:text-base font-semibold text-cabuya-bg-dark shadow-lg shadow-black/30 hover:bg-cabuya-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cabuya-accent"
    >
      {t.contactSection.ctaText}
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</section>
