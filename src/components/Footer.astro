---
/**
 * Minimal migration footer (Task 7). The four-column footer ships with the
 * site shell (Task 18); until then: the principle, the licence line, and the
 * honest pointers that already exist.
 */
import type { Language } from '@/lib/i18n';
import { GITHUB_URL } from '@/lib/site-navigation';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang as Language);
const year = new Date().getFullYear();
---

<footer class="border-t border-cabuya-border bg-cabuya-bg-elevated">
  <div class="main-container py-10">
    <blockquote class="max-w-xl text-cabuya-text">
      {t.footer.principle}
      <span class="mt-1 block text-sm text-cabuya-text-muted">
        {t.footer.principleGloss}
      </span>
    </blockquote>
    <div
      class="mt-8 flex flex-col gap-2 border-t border-cabuya-border pt-6 text-sm text-cabuya-text-muted md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} Cabuya · {t.footer.license}</p>
      <nav aria-label="Footer" class="flex gap-5">
        <a href={GITHUB_URL} class="nav-link" rel="noopener" target="_blank">
          {t.footer.sourceCode}
        </a>
        <a
          href={`${GITHUB_URL}/tree/main/docs/context`}
          class="nav-link"
          rel="noopener"
          target="_blank"
        >
          {t.footer.foundingRecord}
        </a>
      </nav>
    </div>
  </div>
</footer>
