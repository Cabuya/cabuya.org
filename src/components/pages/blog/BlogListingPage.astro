---
import BlogContainer from '@/components/blog/BlogContainer.astro';
import AppInvite from '@/components/cta/AppInvite.astro';
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getBlogPosts } from '@/lib/blog';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';
import type { BlogPostsResultType } from '@/lib/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

const blogPostsResult: BlogPostsResultType = await getBlogPosts({ lang });

const collectionPageData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t.blogTitle,
  description: t.blogDescription,
  inLanguage: lang,
  url: new URL(`${prefix}/blog/`, Astro.site).href,
};
---

<MainLayout
  lang={lang}
  title={t.blogTitle}
  description={t.blogDescription}
  keywords={lang === 'en'
    ? ['Corag blog', 'humanitarian coordination', 'donation transparency', 'aid with evidence', 'civic technology Colombia', 'disaster response stories']
    : ['blog de Corag', 'coordinación humanitaria', 'transparencia en donaciones', 'ayuda con evidencia', 'tecnología cívica Colombia', 'historias de respuesta a emergencias']}
>
  <Fragment slot="head">
    <JsonLd data={collectionPageData} />
  </Fragment>
  <BlogContainer blogPostsResult={blogPostsResult} lang={lang} />
  <AppInvite lang={lang} surface="blog-listing-end" />
</MainLayout>
