---
import AppInvite from '@/components/cta/AppInvite.astro';
import JsonLd from '@/components/JsonLd.astro';
import HighlightCard from '@/components/pages/HighlightCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { APP_URL, SOCIAL_LINKS } from '@/lib/constances';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
// Deep-link the contact form to the institutional-partnership topic.
const contactCtaHref = `${prefix}/contact?${new URLSearchParams({
  topic: 'ally',
}).toString()}`;

const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const organizationData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Corag',
  alternateName: 'Corag Ayuda Directa',
  url: Astro.site?.href,
  logo: new URL('/images/brand/cabuya-lockup.png', Astro.site).href,
  description:
    'Corag connects people who need help with people who can give it, and publishes the evidence of every delivery. Requests, contributions and proof live in one place.',
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'CO',
    },
  },
  areaServed: {
    '@type': 'Country',
    name: 'Colombia',
  },
  knowsLanguage: ['es', 'en'],
  knowsAbout: [
    'Humanitarian Aid Coordination',
    'Disaster Response',
    'Donation Transparency',
    'Civic Technology',
    'Community Organizing',
    'Social Impact',
  ],
  sameAs: SOCIAL_LINKS.filter((social) => social.sameAs).map(
    (social) => social.href
  ),
};

const aboutPageData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: { '@id': Astro.site?.href },
  dateCreated: '2014-02-27',
  dateModified: new Date().toISOString().split('T')[0],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.aboutPage.title,
      item: `${siteUrl}${prefix}/about`,
    },
  ],
};

const breadcrumbs = [
  { label: lang === 'es' ? 'Inicio' : 'Home', href: `${prefix}/` },
  { label: t.aboutPage.title },
];
---

<MainLayout
  lang={lang}
  title={t.aboutPage.title}
  description={t.aboutPage.description}
  keywords={lang === 'en'
    ? ['about Corag', 'how Corag works', 'verified aid Colombia', 'donation transparency', 'humanitarian coordination platform', 'aid with evidence']
    : ['sobre Corag', 'cómo funciona Corag', 'ayuda verificada Colombia', 'transparencia en donaciones', 'plataforma de coordinación humanitaria', 'ayuda con evidencia']}
>
  <Fragment slot="head">
    <JsonLd data={organizationData} />
    <JsonLd data={aboutPageData} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <div class="bg-gradient-to-br from-cabuya-bg-dark to-cabuya-bg-dark/90 text-white">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} onDark />
    </div>
    <div class="main-container pt-6 pb-12 sm:pb-16">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-center">
        <div>
          <Eyebrow variant="accent">{t.aboutPage.subtitle}</Eyebrow>
          <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
            {t.aboutPage.title}
          </h1>
          <p class="mt-4 text-lg text-white/85">{t.aboutPage.heroDescription}</p>
        </div>
        <div class="mt-10 lg:mt-0">
          <img
            src="/images/home/entrega-mercados.webp"
            srcset="/images/home/entrega-mercados-480.webp 480w, /images/home/entrega-mercados-768.webp 768w, /images/home/entrega-mercados-1280.webp 1280w"
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt={lang === 'es'
              ? 'Voluntarios de Corag organizando mercados antes de una entrega'
              : 'Corag volunteers organizing food supplies before a delivery'}
            width="640"
            height="360"
            loading="eager"
            class="w-full rounded-2xl shadow-2xl ring-1 ring-white/20 object-cover aspect-video"
          />
        </div>
      </div>
    </div>
  </div>



  {/* The origin story beside the picture of it: courage becoming a bridge.
      The illustration is transparent, so it needs no frame and works on both
      themes. */}
  <Section title={t.aboutPage.bioTitle}>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div
        class="prose prose-lg dark:prose-invert prose-p:text-cabuya-secondary lg:col-span-6"
        set:html={t.aboutPage.bioText}
      />
      <figure class="lg:col-span-6">
        <img
          src="/images/pages/illustrations/illustration-about-1024.webp"
          srcset="/images/pages/illustrations/illustration-about-480.webp 480w, /images/pages/illustrations/illustration-about-768.webp 768w, /images/pages/illustrations/illustration-about-1024.webp 1024w"
          sizes="(min-width: 1024px) 46vw, 100vw"
          alt={t.aboutPage.bioIllustrationAlt}
          width="1412"
          height="422"
          loading="lazy"
          decoding="async"
          class="w-full"
        />
      </figure>
    </div>
  </Section>

  <Section title={t.aboutPage.passionsTitle} surface="alt">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.aboutPage.passions.map((passion) => (
        <HighlightCard
          title={passion.title}
          description={passion.description}
          icon={passion.icon}
          link={passion.link}
        />
      ))}
    </div>
  </Section>

  <Section title={t.aboutPage.quickFactsTitle}>
    <ul class="space-y-3 max-w-2xl list-none">
      {t.aboutPage.quickFacts.map((fact) => (
        <li class="flex items-start gap-3 text-cabuya-secondary">
          <span class="text-cabuya-primary dark:text-cabuya-primary-light mt-0.5 shrink-0" aria-hidden="true">✓</span>
          <span>{fact}</span>
        </li>
      ))}
    </ul>
  </Section>

  <div class="bg-cabuya-bg-dark text-white py-16">
    <div class="main-container text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">
        {t.aboutPage.ctaTitle}
      </h2>
      <p class="mt-3 text-white/85">{t.aboutPage.ctaDescription}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href={APP_URL}
          class="inline-flex min-h-[44px] items-center rounded-full bg-cabuya-seedling px-6 py-3 font-semibold text-cabuya-bg-dark transition-colors hover:bg-cabuya-seedling-soft"
        >
          {t.aboutPage.ctaApp}
        </a>
        <a
          href={contactCtaHref}
          class="inline-flex items-center px-6 py-3 rounded-full bg-white/10 text-white font-semibold ring-1 ring-white/30 hover:bg-white/15 transition-colors"
        >
          {t.aboutPage.ctaContact}
        </a>
      </div>
    </div>
  </div>
  <AppInvite lang={lang} surface="about-end" />
</MainLayout>
