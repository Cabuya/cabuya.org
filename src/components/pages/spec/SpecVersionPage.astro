---
/**
 * `/developers/spec/{version}` — one version's table of contents.
 */
import Callout from '@/components/editorial/Callout.astro';
import DocsLayout from '@/layouts/DocsLayout.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { specVersionSummary } from '@/lib/spec-loader';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
  version: string;
}

const { lang, version } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const summary = specVersionSummary(version);
const metaDescription =
  `Cabuya ${version}: ${summary.sections.length} normative sections with stable anchors — ${summary.sections
    .slice(1, 5)
    .map((section) => section.title.split(/[—:]/)[0].trim())
    .join(', ')}, and more.`.slice(0, 158);
---

<DocsLayout
  lang={lang}
  title={`${t.spec.indexTitle} ${version}`}
  description={metaDescription}
  trail={[
    { label: t.spec.indexTitle, href: `${prefix}/developers/spec` },
    { label: version },
  ]}
>
  {
    lang !== 'en' && (
      <Callout tone="note" label={t.spec.versionLabel}>
        <p>{t.spec.normativeLanguageNotice}</p>
      </Callout>
    )
  }

  <p class="not-prose mb-6">
    <span class="rounded-full bg-cabuya-warning-soft px-2.5 py-0.5 text-xs font-semibold text-cabuya-warning">
      {t.spec.statusLabels[summary.status] ?? summary.status}
    </span>
  </p>

  <ol class="not-prose flex flex-col gap-2">
    {
      summary.sections.map((section) => (
        <li>
          <a
            href={`${prefix}/developers/spec/${version}/${section.slug}`}
            class="group flex items-baseline gap-3 rounded-cabuya-sm border border-cabuya-border px-4 py-3 transition-colors hover:border-cabuya-primary"
          >
            <span class="font-mono text-xs text-cabuya-text-muted">
              §{section.number}
            </span>
            <span class="font-medium group-hover:text-cabuya-primary">
              {section.title}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</DocsLayout>
