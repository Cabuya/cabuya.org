---
/**
 * The landing page: eight sections, composed.
 *
 * Section order is the reader's journey through `docs/MESSAGING.md`: what it
 * is, why it exists, how you join, what joining means, who is already there,
 * where it could go, and then a way out to something real. Every section owns
 * exactly one messaging beat, and each carries the Rule-0 constraint that beat
 * came with — those constraints are in each component's own comment, next to
 * the code that honours them, rather than in a document nobody opens while
 * editing copy.
 *
 * `Signatories` renders nothing today, and that is not a bug. See its file.
 */
import FinalCta from '@/components/home/FinalCta.astro';
import Hero from '@/components/home/Hero.astro';
import Horizon from '@/components/home/Horizon.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Ladder from '@/components/home/Ladder.astro';
import Network from '@/components/home/Network.astro';
import Signatories from '@/components/home/Signatories.astro';
import Thesis from '@/components/home/Thesis.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<MainLayout
  lang={lang}
  title={t.home.metaTitle}
  description={t.home.metaDescription}
>
  {/*
    No ornament between these sections, and the reason is worth writing down:
    every tinted band on this page carries `border-y`, so each seam already has a
    rule. `MK-03` exists to *replace* a rule, not to sit next to one — dropped in
    here it read as a second divider a few pixels from the first. It closes the
    thesis section instead (see `Thesis.astro`), and it separates the movements of
    the quickstart, which is the long page whose only structure is its headings.
  */}
  <Hero lang={lang} />
  <Thesis lang={lang} />
  <HowItWorks lang={lang} />
  <Ladder lang={lang} />
  <Network lang={lang} />
  <Signatories lang={lang} />
  <Horizon lang={lang} />
  <FinalCta lang={lang} />
</MainLayout>
