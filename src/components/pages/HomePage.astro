---
/**
 * Minimal migration placeholder for the cabuya.org landing.
 *
 * The real homepage — the protocol story, the conformance ladder, the
 * network view — ships in migration Task 21 (see docs/MESSAGING.md for the
 * beat map). This placeholder keeps the site honest in the meantime: the
 * pitch, the founding principle, and a pointer to the founding record.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<MainLayout
  lang={lang}
  title={t.home.metaTitle}
  description={t.home.metaDescription}
>
  <section class="main-container py-24 md:py-32">
    <p
      class="text-xs font-semibold uppercase tracking-[0.2em] text-cabuya-accent-strong"
    >
      {t.home.eyebrow}
    </p>
    <h1
      class="mt-4 max-w-3xl font-display text-4xl font-bold text-cabuya-primary md:text-5xl"
    >
      {t.home.title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-cabuya-secondary">
      {t.home.pitch}
    </p>
    <p class="mt-4 max-w-2xl text-cabuya-secondary">
      {t.home.pitchSecond}
    </p>
    <blockquote
      class="mt-10 max-w-2xl border-l-2 border-cabuya-accent pl-4 text-cabuya-text"
    >
      «Crecemos juntos: no competimos, nos alimentamos.»
      <span class="mt-1 block text-sm text-cabuya-text-muted"
        >{t.home.principleGloss}</span
      >
    </blockquote>
    <p class="mt-10 text-sm text-cabuya-text-muted">
      {t.home.statusNote}
    </p>
  </section>
</MainLayout>
