<script>
  /*
   * Scroll-reveal enhancement — not an island, just a deferred module.
   * The pre-reveal hidden state only exists after `data-reveal-ready` is
   * stamped here, so without JS (or under reduced motion) the page is
   * complete and static. CSS lives in global.css.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('[data-reveal]');
  if (!reduced && 'IntersectionObserver' in window && targets.length > 0) {
    document.documentElement.setAttribute('data-reveal-ready', '');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-revealed', '');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );
    for (const el of targets) observer.observe(el);
  }
</script>

