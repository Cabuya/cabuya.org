---
/**
 * `/movement` — Corag as a collective.
 *
 * This replaced a directory of named people, allied communities and allied
 * companies. Removing the roster was the point, not a side effect: a movement
 * that introduces itself through representatives asks you to trust the
 * representatives, which is the opposite of the argument the rest of the site
 * makes. So the page has to make the absence read as a position.
 *
 * Deliberately spare — no cards, no grids, no logos. The three beats are set as
 * plain statements with a lot of air around them, because the team's brief was
 * that less is more and because a manifesto laid out as a dashboard stops
 * reading like one.
 */

import AppInvite from '@/components/cta/AppInvite.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const mp = t.movementPage;
const prefix = getUrlPrefix(lang);

const breadcrumbs = [
  { label: t.nav.home, href: `${prefix}/` },
  { label: mp.title },
];
---

<MainLayout lang={lang} title={mp.title} description={mp.description}>
  {/* Hero — typographic. The statement is the artwork. */}
  <div class="relative overflow-hidden bg-cabuya-bg">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--cabuya-primary)_0%,_transparent_55%)] opacity-[0.07] dark:opacity-[0.12]"
      aria-hidden="true"
    >
    </div>

    <div class="main-container relative pt-12 pb-4 sm:pt-16">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="main-container relative pt-6 pb-16 sm:pb-24">
      <Eyebrow>{mp.eyebrow}</Eyebrow>
      <h1
        class="mt-4 max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-cabuya sm:text-6xl lg:text-7xl"
      >
        {mp.title}
      </h1>
      <p
        class="mt-6 max-w-2xl text-lg leading-relaxed text-cabuya-secondary sm:mt-8 sm:text-xl"
        set:html={mp.lead}
      />
    </div>
  </div>

  {/* The three beats. Numbered, spaced, no chrome. */}
  <Section surface="alt" spacing="lg">
    <ul class="grid list-none gap-12 sm:gap-16 lg:grid-cols-3 lg:gap-20">
      {
        mp.beats.map((beat, index) => (
          <li>
            <span
              class="font-display text-5xl font-bold leading-none text-cabuya-primary/25 dark:text-cabuya-primary/40"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            {/* Between md and lg these stack into one full-width column, where
                an unconstrained line ran to 103 characters. */}
            <h2 class="mt-4 max-w-2xl font-display text-xl font-bold tracking-tight text-cabuya sm:text-2xl">
              {beat.title}
            </h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-cabuya-secondary">
              {beat.body}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/*
    The question the missing roster provokes, answered head-on — with the crowd
    beside it, so the answer is shown as well as said.

    The illustration sits in this column rather than spanning the page: at full
    width it competed with the text instead of supporting it, and ~150 distinct
    figures make it the heaviest asset on the site. Half-width means the 768px
    file serves it (203 KB instead of 327 KB), and dropping WebP quality would
    not have helped — the cost is the number of shapes, not the fidelity.
  */}
  <Section spacing="lg">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-6">
        <h2
          class="font-display text-3xl font-bold tracking-tight text-cabuya sm:text-4xl"
        >
          {mp.closingTitle}
        </h2>
        {/* max-w-2xl matters between md and lg, where this column is still
            full width: unconstrained it ran to ~103 characters a line. */}
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-cabuya-secondary">
          {mp.closingBody}
        </p>
        {/*
          Filled rather than ghost: the outline version vanished against the
          cream ground. It uses the soft pink pair instead of `cabuya-fill` so it
          stays a step below the application CTA in the band underneath — this
          link goes to `/channels`, not to the conversion.
        */}
        <a
          href={`${prefix}/channels/`}
          class="mt-8 inline-flex min-h-[44px] items-center gap-2 rounded-full border border-cabuya-primary/30 bg-cabuya-primary-soft px-6 py-3 text-base font-semibold text-cabuya-primary transition-colors hover:border-cabuya-primary/60 hover:bg-cabuya-seedling-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cabuya-primary dark:border-cabuya-primary/40"
        >
          {mp.channelsLabel}
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </a>
      </div>

      <figure class="lg:col-span-6">
        <img
          src="/images/pages/illustrations/illustration-movement-768.webp"
          srcset="/images/pages/illustrations/illustration-movement-480.webp 480w, /images/pages/illustrations/illustration-movement-768.webp 768w, /images/pages/illustrations/illustration-movement-1024.webp 1024w"
          sizes="(min-width: 1024px) 46vw, 100vw"
          alt={mp.illustrationAlt}
          width="1328"
          height="860"
          loading="lazy"
          decoding="async"
          class="w-full"
        />
      </figure>
    </div>
  </Section>

  <AppInvite lang={lang} surface="movement-end" />
</MainLayout>
