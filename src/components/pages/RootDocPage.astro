---
/**
 * `/governance`, `/trademark` and `/join` — the repository's own documents.
 *
 * One renderer for all three, because all three are the same thing: a
 * root-level Markdown file that governs how this project works, shown to
 * someone who arrived from the site rather than from a `git clone`.
 *
 * The page adds a header, a link to the file it came from, and nothing else.
 * The link is not decoration — it is the page telling you where the authority
 * actually lives, so a reader who wants to check what a fork carries, or open a
 * pull request against it, can go straight there.
 */
import { getCollection, render } from 'astro:content';
import Illustration from '@/components/editorial/Illustration.astro';
import ContactForm from '@/components/forms/ContactForm.svelte';
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import type { IllustrationId } from '@/lib/illustrations';
import type { RootDocId } from '@/lib/root-docs';
import { rootDoc, rootDocSummary } from '@/lib/root-docs';
import { GITHUB_URL } from '@/lib/site-navigation';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
  docId: RootDocId;
}

const { lang, docId } = Astro.props;
const t = getTranslations(lang);

const entries = await getCollection('rootDocs');
const entry = entries.find((item) => item.id === `${lang}/${docId}`);
if (!entry) throw new Error(`No rootDocs entry for ${lang}/${docId}`);

const { Content } = await render(entry);

/** The adapter is read again for the summary — one source, two consumers. */
const doc = rootDoc(docId, lang);
const description = rootDocSummary(doc);
const sourceUrl = `${GITHUB_URL}/blob/main/${doc.file}`;

/**
 * Which of the three documents carries artwork.
 *
 * `RG-02` for governance — hands working cord together, plural and equal, which
 * is shared stewardship without claiming an authority nobody granted us — and
 * `RG-03` for the join page, a rope mid-splice with one new strand being laid
 * in: adding to the network is a normal operation, not an application to a club.
 *
 * `TRADEMARK` gets none. The pack has no entry for it, and a page borrows no
 * drawing: an illustration that means nothing in particular is decoration, and
 * this one would be sitting above the strictest text on the site.
 */
const DOC_ART: Partial<Record<RootDocId, IllustrationId>> = {
  GOVERNANCE: 'governance-hands',
  CONTRIBUTING: 'join-splice',
};
const art = DOC_ART[docId];
---

<MainLayout lang={lang} title={doc.title} description={description}>
  <article>
    <section class="border-b border-cabuya-border bg-cabuya-bg-dark text-white">
      <div class="main-container py-14 md:py-20">
        <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
          <div>
            <h1 class="font-display text-3xl font-bold md:text-4xl">
              {doc.title}
            </h1>
            <p class="mt-4 max-w-3xl text-base text-white/80">{description}</p>
            <p class="mt-6 text-sm">
              <a
                href={sourceUrl}
                rel="noopener"
                class="inline-flex items-center gap-2 text-white/70 underline underline-offset-4 hover:text-white"
              >
                <code class="font-mono">{doc.file}</code>
                <span aria-hidden="true">↗</span>
                <span class="sr-only">{t.rootDocs.sourceLinkSuffix}</span>
              </a>
            </p>
          </div>
          {
            art && (
              <Illustration
                id={art}
                loading="eager"
                class="mx-auto h-auto w-full max-w-[15rem] sm:max-w-xs lg:max-w-none"
              />
            )
          }
        </div>
      </div>
    </section>

    <section class="bg-cabuya-bg py-12 md:py-16">
      <div class="main-container">
        <p
          class="mb-8 max-w-3xl rounded-cabuya-md border border-cabuya-border bg-cabuya-bg-elevated p-4 text-sm text-cabuya-text-secondary"
        >
          {t.rootDocs.sourceNote}
        </p>
        <div class="prose max-w-3xl">
          <Content />
        </div>
      </div>
    </section>

    {
      /*
       * The form lives on /join and nowhere else. It is appended after the
       * document rather than embedded inside it, because the document is a
       * repository file and a file cannot contain a Svelte island — and
       * because the contribution paths above are the ones that actually work
       * best. The form is the last resort, positioned as one.
       */
      docId === 'CONTRIBUTING' && (
        <section
          id="contact"
          class="scroll-mt-[calc(var(--cabuya-chrome-height)+1rem)] border-t border-cabuya-border bg-cabuya-bg-elevated py-12 md:py-16"
        >
          <div class="main-container">
            <h2 class="font-display text-2xl font-bold">{t.contact.title}</h2>
            <p class="mt-3 max-w-2xl text-cabuya-text-secondary">
              {t.contact.lead}
            </p>

            <div class="mt-8">
              <ContactForm
                client:visible
                lang={lang}
                labels={{
                  privacy: t.contact.privacy,
                  nameLabel: t.contact.nameLabel,
                  nameOptional: t.contact.nameOptional,
                  organizationLabel: t.contact.organizationLabel,
                  organizationOptional: t.contact.organizationOptional,
                  emailLabel: t.contact.emailLabel,
                  emailHint: t.contact.emailHint,
                  messageLabel: t.contact.messageLabel,
                  messageHint: t.contact.messageHint,
                  interestLabel: t.contact.interestLabel,
                  interestOptions: t.contact.interestOptions,
                  submit: t.contact.submit,
                  submitting: t.contact.submitting,
                  successTitle: t.contact.successTitle,
                  successBody: t.contact.successBody,
                  errors: t.contact.errors,
                  rateLimitedTitle: t.contact.rateLimitedTitle,
                  rateLimitedBody: t.contact.rateLimitedBody,
                  upstreamTitle: t.contact.upstreamTitle,
                  upstreamBody: t.contact.upstreamBody,
                  notConfiguredTitle: t.contact.notConfiguredTitle,
                  notConfiguredBody: t.contact.notConfiguredBody,
                }}
              />
            </div>

            <noscript>
              <p class="mt-6 max-w-2xl text-sm text-cabuya-text-secondary">
                {t.contact.noscript}
              </p>
            </noscript>

            {/*
              Rendered for everyone, always — with the form working, with it
              unconfigured, and with no JavaScript at all. These two links are
              the paths that cannot break, and burying them behind a failure
              state would mean showing them only to the people who already
              found out the hard way.
            */}
            <div class="mt-8 max-w-2xl border-t border-cabuya-border pt-6">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                {t.contact.alternativesTitle}
              </h3>
              <ul class="mt-3 flex list-none flex-col gap-2 p-0 text-sm">
                <li>
                  <a
                    href={`${GITHUB_URL}/issues/new/choose`}
                    rel="noopener"
                    class="text-cabuya-primary underline underline-offset-2"
                  >
                    {t.contact.alternativesIssues} ↗
                  </a>
                </li>
                <li>
                  <a
                    href={GITHUB_URL}
                    rel="noopener"
                    class="text-cabuya-primary underline underline-offset-2"
                  >
                    {t.contact.alternativesRepo} ↗
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </section>
      )
    }
  </article>
</MainLayout>
