---
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { GITHUB_URL } from '@/lib/site-navigation';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const homeHref = lang === 'en' ? '/' : `/${lang}/`;
---

<MainLayout
  lang={lang}
  title={t.notFoundPage.metaTitle}
  description={t.notFoundPage.description}
>
  <section class="main-container py-24 text-center md:py-32">
    <img
      src="/images/brand/cabuya-isologo.webp"
      alt=""
      width="96"
      height="96"
      class="mx-auto h-24 w-24 opacity-80"
    />
    <h1
      class="mt-8 font-display text-4xl font-bold text-cabuya-primary md:text-5xl"
    >
      404 — {t.notFoundPage.title}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-cabuya-secondary">
      {t.notFoundPage.description}
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href={homeHref}
        class="inline-block rounded-cabuya-sm bg-cabuya-fill px-6 py-3 font-medium text-cabuya-on-fill transition-colors hover:bg-cabuya-fill-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cabuya-primary"
      >
        {t.notFoundPage.backHome}
      </a>
      <a
        href={`${GITHUB_URL}/tree/main/docs/context`}
        rel="noopener"
        target="_blank"
        class="inline-block rounded-cabuya-sm border border-cabuya-border-interactive px-6 py-3 font-medium text-cabuya-primary transition-colors hover:bg-cabuya-primary-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cabuya-primary"
      >
        {t.notFoundPage.otherExitLabel}
      </a>
    </div>
  </section>
</MainLayout>
