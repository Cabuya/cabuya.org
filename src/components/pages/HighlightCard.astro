---
import { Eye, Heart, Shield, Sparkles, Users } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  /** Lucide icon key used by About values (and similar highlight grids). */
  icon?: 'users' | 'heart' | 'shield' | 'sparkles' | 'eye';
  link?: string;
}

const { title, description, icon, link } = Astro.props;

const icons = {
  users: Users,
  heart: Heart,
  shield: Shield,
  sparkles: Sparkles,
  eye: Eye,
} as const;

const Icon = icon ? icons[icon] : undefined;

const Tag = link ? 'a' : 'div';
const linkProps = link ? { href: link } : {};
---

<Tag
  {...linkProps}
  class={`group block p-6 rounded-xl bg-corag-bg-elevated border border-corag-border shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ${link ? 'cursor-pointer' : ''}`}
>
  {
    Icon && (
      <div class="mb-4 text-corag-primary">
        <Icon size={32} stroke-width={1.5} aria-hidden="true" />
      </div>
    )
  }
  <h3 class="text-lg font-bold text-corag mb-2 group-hover:text-corag-primary transition-colors">
    {title}
  </h3>
  <p class="text-corag-secondary text-sm leading-relaxed">
    {description}
  </p>
</Tag>
