---
interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'neutral';
}

const { label, variant = 'neutral' } = Astro.props;

const variantClasses: Record<string, string> = {
  primary: 'bg-cabuya-fill text-cabuya-on-fill hover:bg-cabuya-fill-strong',
  secondary:
    'bg-cabuya-primary-soft text-cabuya-primary hover:bg-cabuya-primary-soft/70',
  neutral:
    'bg-cabuya-bg-elevated text-cabuya-secondary hover:bg-cabuya-primary-soft',
};
---

<span class={`inline-block px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 ${variantClasses[variant]}`}>
  {label}
</span>
