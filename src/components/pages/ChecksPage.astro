---
/**
 * `/developers/validator/checks` — the whole catalogue, generated.
 *
 * Every error message the validator emits carries a link to an anchor on this
 * page. That makes these URLs part of the tool's output contract: they are as
 * permanent as the ids themselves, and `checks:catalogue` asserts in both
 * directions that every id has an anchor here and every anchor is a real id.
 *
 * Generated from `@cabuya/validator` rather than written. A hand-maintained
 * catalogue would fall behind the checks that actually run, and the reader who
 * discovers that is one following a link from a failure they are trying to fix.
 */
import { CHECKS, ES } from '@cabuya/validator';
import Callout from '@/components/editorial/Callout.astro';
import DocsLayout from '@/layouts/DocsLayout.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { buildToc } from '@/lib/toc';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

/** Family order follows the order a document is checked in, not the alphabet. */
const FAMILY_ORDER = [
  'discovery',
  'envelope',
  'record',
  'pii',
  'behavior',
  'license',
  'api',
  'write',
];

const families = FAMILY_ORDER.map((family) => ({
  family,
  label: t.checks.familyLabels[family] ?? family,
  checks: CHECKS.filter((check) => check.family === family),
})).filter((group) => group.checks.length > 0);

const implemented = CHECKS.filter((check) => check.implemented).length;

const SEVERITY_TONE: Record<string, string> = {
  error: 'bg-cabuya-danger-soft text-cabuya-danger',
  warning: 'bg-cabuya-warning-soft text-cabuya-warning',
  info: 'bg-cabuya-info-soft text-cabuya-info',
};

const headings = buildToc(
  families.map((group) => ({ depth: 2, text: group.label }))
);

/** Spanish rule and fix come from the package's own table; ids never translate. */
function localized(
  id: string,
  field: 'title' | 'rule' | 'fix'
): string | undefined {
  if (lang === 'es') return ES[id]?.[field];
  return undefined;
}
---

<DocsLayout
  lang={lang}
  title={t.checks.title}
  description={t.checks.metaDescription}
  trail={[
    { label: t.validator.title, href: `${prefix}/developers/validator` },
    { label: t.checks.title },
  ]}
  headings={headings}
>
  <p class="lead !mt-0 text-lg text-cabuya-text-secondary">{t.checks.lead}</p>

  <p class="not-prose my-4 text-sm text-cabuya-text-muted">
    {CHECKS.length} {t.checks.countSummary} · {implemented} {t.checks.implementedCountLabel}
  </p>

  <Callout tone="note" label={t.checks.title}>
    <p>{t.checks.stableNote}</p>
  </Callout>

  {
    lang !== 'en' && (
      <Callout tone="limit" label={t.checks.plannedLabel}>
        <p>{t.checks.untranslatedNote}</p>
      </Callout>
    )
  }

  {
    families.map((group, groupIndex) => (
      <section class="not-prose mt-12">
        <h2
          id={headings[groupIndex].slug}
          class="mb-4 font-display text-xl font-bold"
        >
          {group.label}
        </h2>

        <div class="flex flex-col gap-4">
          {group.checks.map((check) => (
            <article
              id={check.id}
              class:list={[
                'scroll-mt-[calc(var(--cabuya-chrome-height)+1rem)] rounded-cabuya-md border p-5',
                check.implemented
                  ? 'border-cabuya-border bg-cabuya-bg-elevated'
                  : 'border-dashed border-cabuya-border-strong bg-cabuya-bg-brand/30',
              ]}
            >
              <header class="flex flex-wrap items-center gap-2">
                <a
                  href={`#${check.id}`}
                  class="font-mono text-sm font-bold text-cabuya-primary"
                >
                  {check.id}
                </a>
                <span
                  class:list={[
                    'rounded px-2 py-0.5 text-xs font-semibold',
                    SEVERITY_TONE[check.severity] ?? SEVERITY_TONE.info,
                  ]}
                >
                  {check.severity}
                </span>
                {check.level && (
                  <span class="rounded bg-cabuya-bg-brand-strong px-2 py-0.5 font-mono text-xs">
                    {check.level}
                  </span>
                )}
                <span class="ml-auto text-xs text-cabuya-text-muted">
                  {check.implemented
                    ? t.checks.implementedLabel
                    : `${t.checks.plannedLabel}${check.plannedIn ? ` — ${check.plannedIn}` : ''}`}
                </span>
              </header>

              <h3 class="mt-2 font-display text-base font-semibold">
                {localized(check.id, 'title') ?? check.title}
              </h3>

              <dl class="mt-3 flex flex-col gap-2 text-sm">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                    {t.checks.ruleLabel}
                  </dt>
                  <dd class="text-cabuya-text-secondary">
                    {localized(check.id, 'rule') ?? check.rule}
                  </dd>
                </div>
                {check.fix && (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                      {t.checks.fixLabel}
                    </dt>
                    <dd class="text-cabuya-text-secondary">
                      {localized(check.id, 'fix') ?? check.fix}
                    </dd>
                  </div>
                )}
              </dl>

              {check.specAnchor && (
                <p class="mt-3 text-xs">
                  <a
                    href={check.specAnchor}
                    class="text-cabuya-primary underline underline-offset-2"
                  >
                    {t.checks.specLabel}
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }
</DocsLayout>
