---
/**
 * `/changelog` — one timeline, parsed from the specification's own changelog.
 *
 * Parsed rather than transcribed. A changelog copied into a page is a
 * changelog that stops matching the repository, and release notes are the
 * worst possible place for that: they are what somebody reads to decide
 * whether an upgrade will break them.
 *
 * Zero JavaScript. A timeline is a list with a rule down the left, and every
 * interactive version of one is a list with a rule down the left plus a
 * regression waiting to happen.
 *
 * The validator and skill releases will join this page as they exist. Until
 * then it says so rather than rendering three empty columns — a timeline with
 * two blank tracks reads as a project that stopped, not as one that has not
 * started.
 */
import Callout from '@/components/editorial/Callout.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { inlineMarkdownToHtml } from '@/lib/inline-markdown';
import { specChangelog } from '@/lib/spec-loader';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

const releases = specChangelog();

/**
 * Keep a Changelog's group names are English by convention and are part of the
 * format, so they are translated for display and matched case-insensitively —
 * a heading written `added` must not fall through to a blank label.
 */
const groupLabel = (kind: string): string =>
  t.changelog.groupLabels[kind.toLowerCase()] ?? kind;

/** `Unreleased` is a keyword, not a version number. */
const isUnreleased = (version: string): boolean =>
  /^unreleased$/i.test(version.trim());
---

<MainLayout
  lang={lang}
  title={t.changelog.metaTitle}
  description={t.changelog.metaDescription}
>
  <section class="border-b border-cabuya-border bg-cabuya-bg-dark text-white">
    <div class="main-container py-14 md:py-20">
      <h1 class="font-display text-3xl font-bold md:text-4xl">
        {t.changelog.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base text-white/80 md:text-lg">
        {t.changelog.lead}
      </p>
    </div>
  </section>

  <section class="bg-cabuya-bg py-12 md:py-16">
    <div class="main-container">
      <div class="max-w-3xl">
        <Callout tone="note" label={t.changelog.scopeTitle}>
          <p>{t.changelog.scopeBody}</p>
          <!--
            The language gate looks for this notice before it will allow the
            English release entries below on the Spanish route. Without it the
            page would be a Spanish page quietly serving English, which is the
            case the gate exists to catch.
          -->
          <p class="mt-3">{t.changelog.quotedNotice}</p>
        </Callout>
      </div>

      <ol class="not-prose mt-10 max-w-3xl list-none border-l border-cabuya-border p-0">
        {
          releases.map((release) => (
            <li class="relative pb-10 pl-6 last:pb-0">
              <span
                class:list={[
                  'absolute -left-[5px] top-2 block h-[9px] w-[9px] rounded-full',
                  isUnreleased(release.version)
                    ? 'border border-cabuya-border-strong bg-cabuya-bg'
                    : 'bg-cabuya-fill',
                ]}
                aria-hidden="true"
              />

              <h2 class="flex flex-wrap items-baseline gap-3 font-display text-xl font-bold">
                <span class="font-mono">
                  {isUnreleased(release.version)
                    ? t.changelog.unreleased
                    : release.version}
                </span>
                {release.date && (
                  <time
                    datetime={release.date}
                    class="font-sans text-sm font-normal text-cabuya-text-muted"
                  >
                    {release.date}
                  </time>
                )}
              </h2>

              {release.groups.length === 0 && release.notes.length === 0 && (
                <p class="mt-2 text-sm text-cabuya-text-muted">
                  {t.changelog.nothingYet}
                </p>
              )}

              {release.groups.map((group) => (
                <div class="mt-4">
                  <h3 class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                    {groupLabel(group.kind)}
                  </h3>
                  <ul class="mt-2 flex list-disc flex-col gap-2 pl-5 text-sm text-cabuya-text-secondary marker:text-cabuya-border-strong">
                    {group.entries.map((entry) => (
                      <li set:html={inlineMarkdownToHtml(entry)} />
                    ))}
                  </ul>
                </div>
              ))}

              {release.notes.map((note) => (
                <p
                  class="mt-4 text-sm font-semibold text-cabuya-text"
                  set:html={inlineMarkdownToHtml(note)}
                />
              ))}
            </li>
          ))
        }
      </ol>

      <div class="mt-12 max-w-3xl">
        <h2 class="font-display text-lg font-bold">
          {t.changelog.otherTracksTitle}
        </h2>
        <p class="mt-2 text-sm text-cabuya-text-secondary">
          {t.changelog.otherTracksBody}
        </p>
        <p class="mt-4 text-sm">
          <a
            href={`${prefix}/rfcs`}
            class="text-cabuya-primary underline underline-offset-2"
          >
            {t.rfcs.title}
          </a>
        </p>
      </div>
    </div>
  </section>
</MainLayout>
