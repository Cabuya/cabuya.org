---
/**
 * `/faq` — the general-audience FAQ.
 *
 * `/developers/faq` answers the adoption blockers for a developer; this page
 * answers the question the project actually gets asked first — "what is this
 * and what does it do?" — for anyone. The two link to each other and own
 * different tiers; neither duplicates the other.
 *
 * Rule-0 constraints carried by the copy (asserted in
 * `tests/unit/lib/faq-page.test.ts`): v0.2 entities are framed as proposed in
 * an open RFC, never as shipped; being listed is never an endorsement; and no
 * question's answer names a real publisher.
 *
 * The `FAQPage` JSON-LD is generated from the same translation entries the
 * page renders, through `faqBody()` + the existing `faq-jsonld.ts` rules —
 * one source, so the markup a search engine reads cannot disagree with the
 * page a person reads.
 */
import JsonLd from '@/components/JsonLd.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE_URL } from '@/lib/constances';
import { faqJsonLd } from '@/lib/faq-jsonld';
import { faqBody } from '@/lib/faq-markdown';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { breadcrumbList } from '@/lib/structured-data';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const canonical = `${SITE_URL}${prefix}/faq`;

const structuredData = faqJsonLd(faqBody(lang), canonical, lang);
const trail = breadcrumbList([
  { name: t.nav.home, url: `${SITE_URL}${prefix}/` },
  { name: t.faq.title },
]);
---

<MainLayout
  lang={lang}
  title={t.faq.metaTitle}
  description={t.faq.metaDescription}
>
  {structuredData && <JsonLd data={structuredData} />}
  {trail && <JsonLd data={trail} />}

  <section class="main-container py-16 sm:py-24">
    <h1 class="max-w-3xl font-display text-3xl font-bold text-balance md:text-5xl">
      {t.faq.title}
    </h1>
    <p class="measure mt-6 text-lg leading-relaxed text-cabuya-text-secondary">
      {t.faq.lead}
    </p>

    <div class="mt-14 max-w-3xl space-y-12">
      {
        t.faq.items.map((item) => (
          <section>
            <h2 class="text-xl font-semibold text-cabuya-text">{item.q}</h2>
            <p class="mt-3 leading-relaxed text-cabuya-text-secondary">
              {item.a}
            </p>
            {item.more && (
              <p class="mt-3">
                <a
                  class="font-medium text-cabuya-primary underline underline-offset-4 hover:text-cabuya-primary/80"
                  href={`${prefix}${item.more.path}`}
                >
                  {item.more.label} →
                </a>
              </p>
            )}
          </section>
        ))
      }
    </div>

    <aside
      class="mt-16 max-w-3xl border-l-2 border-cabuya-accent pl-5"
    >
      <h2 class="text-lg font-semibold text-cabuya-text">
        {t.faq.devFaqTitle}
      </h2>
      <p class="mt-2 text-cabuya-text-secondary">{t.faq.devFaqBody}</p>
      <p class="mt-3">
        <a
          class="font-medium text-cabuya-primary underline underline-offset-4 hover:text-cabuya-primary/80"
          href={`${prefix}/developers/faq`}
        >
          {t.faq.devFaqLink} →
        </a>
      </p>
    </aside>
  </section>
</MainLayout>
