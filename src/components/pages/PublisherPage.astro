---
/**
 * `/registry/{publisher_id}` — one entry, with claimed and measured kept apart.
 *
 * This page exists so the badge is falsifiable. Anyone who sees «Cabuya 0.1
 * compatible» in a README can click it and land here, where the run behind that
 * word is shown with its timestamp, its level and — if it failed — the ids of
 * the checks that failed and links to what each of them means.
 *
 * ## The two blocks
 *
 * *Measured* is what a machine found by fetching the live feed. *Declared* is
 * what the entry says about itself, reviewed by a person before merge and
 * verified by nobody. They are rendered as two visually distinct blocks and
 * never interleaved, because the entire difference between a registry and a
 * directory is whether a reader can tell those two apart at a glance — and a
 * layout that mixes them takes that away no matter what the labels say.
 */
import { SPEC_VERSION } from '@cabuya/validator';
import CodeBlock from '@/components/developers/CodeBlock.astro';
import Callout from '@/components/editorial/Callout.astro';
import HistorySparkline from '@/components/registry/HistorySparkline.astro';
import StateBadge from '@/components/registry/StateBadge.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import {
  badgeAccessibleName,
  badgeEmbedSnippets,
  STATE_DESCRIPTIONS,
} from '@/lib/badge';
import { SITE_URL } from '@/lib/constances';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import type { PublisherEntry } from '@/lib/registry-loader';
import { displayHost, publisherHistory } from '@/lib/registry-loader';
import { fetchMeasuredStatuses, measurementAge } from '@/lib/registry-status';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
  entry: PublisherEntry;
}

const { lang, entry } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

const statuses = await fetchMeasuredStatuses([entry.publisher_id]);
const status = statuses.get(entry.publisher_id);
const state = status?.state ?? 'unmeasured';
const history = publisherHistory(entry.publisher_id);
const now = new Date();

const snippets = badgeEmbedSnippets(SITE_URL, entry.publisher_id, lang);

const title = `${entry.publisher_id} — ${t.registry.title}`;

/**
 * One description per entry, naming the entry and its measured state.
 *
 * Composed rather than written because there is one of these per publisher and
 * they must not collide — a shared description is a set of pages a search
 * engine treats as one, and the page a reader most needs to reach is the one
 * for the publisher they were looking up. It leads with the state because
 * someone searching for a publisher's name is usually deciding whether to
 * consume its feed.
 */
const description = t.registry.publisherMetaDescription
  .replace('{id}', entry.publisher_id)
  .replace('{host}', displayHost(entry))
  .replace('{state}', STATE_DESCRIPTIONS[state][lang])
  .replace(
    '{domains}',
    entry.entity_domains
      .map((domain) => t.registry.domainLabels[domain] ?? domain)
      .join(', ')
  );
---

<MainLayout lang={lang} title={title} description={description}>
  <!--
    The border is load-bearing in dark mode: `bg-cabuya-bg-dark` and
    `bg-cabuya-bg` are close enough there that without it the hero has no edge
    and the page opens with a heading floating in nothing.
  -->
  <section class="border-b border-cabuya-border bg-cabuya-bg-dark text-white">
    <div class="main-container py-12 md:py-16">
      <p class="text-sm">
        <a
          href={`${prefix}/registry`}
          class="text-white/70 underline underline-offset-2 hover:text-white"
        >
          ← {t.registry.backToIndex}
        </a>
      </p>
      <h1 class="mt-4 font-mono text-2xl font-bold md:text-3xl">
        {entry.publisher_id}
      </h1>
      <p class="mt-2 text-white/80">
        <a
          href={entry.canonical_url}
          rel="noopener"
          class="underline underline-offset-2"
        >
          {displayHost(entry)}
        </a>
      </p>
    </div>
  </section>

  <section class="bg-cabuya-bg py-12 md:py-16">
    <div class="main-container">
      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Measured. A machine found this. -->
        <article
          class="rounded-cabuya-md border-2 border-cabuya-border-strong bg-cabuya-bg-elevated p-6"
        >
          <h2 class="font-display text-xl font-bold">
            {t.registry.measuredTitle}
          </h2>
          <p class="mt-2 text-sm text-cabuya-text-secondary">
            {t.registry.measuredBody}
          </p>

          <dl class="mt-6 flex flex-col gap-4">
            <div>
              <dt
                class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted"
              >
                {t.registry.stateLabel}
              </dt>
              <dd class="mt-1">
                <StateBadge state={state} lang={lang} size="md" />
                <p class="mt-2 text-sm text-cabuya-text-secondary">
                  {STATE_DESCRIPTIONS[state][lang]}
                </p>
              </dd>
            </div>

            <div>
              <dt
                class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted"
              >
                {t.registry.levelLabel}
              </dt>
              <dd class="mt-1 font-mono text-sm">{status?.level ?? '—'}</dd>
            </div>

            <div>
              <dt
                class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted"
              >
                {t.registry.checkedLabel}
              </dt>
              <dd class="mt-1 text-sm">
                {
                  status?.checked_at ? (
                    <time datetime={status.checked_at}>
                      {measurementAge(status.checked_at, now, lang)}
                    </time>
                  ) : (
                    t.registry.neverMeasured
                  )
                }
              </dd>
            </div>
          </dl>

          {
            status?.failing_checks && status.failing_checks.length > 0 && (
              <div class="mt-6 border-t border-cabuya-border pt-6">
                <h3 class="font-display text-base font-semibold">
                  {t.registry.failingChecksTitle}
                </h3>
                <p class="mt-1 text-sm text-cabuya-text-secondary">
                  {t.registry.failingChecksBody}
                </p>
                <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
                  {status.failing_checks.map((id) => (
                    <li>
                      <a
                        href={`${prefix}/developers/validator/checks#${id}`}
                        class="inline-block rounded bg-cabuya-danger-soft px-2 py-1 font-mono text-xs font-semibold text-cabuya-danger"
                      >
                        {id}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </article>

        <!-- Declared. The entry says this about itself. -->
        <article
          class="rounded-cabuya-md border border-dashed border-cabuya-border bg-cabuya-bg p-6"
        >
          <h2 class="font-display text-xl font-bold">
            {t.registry.declaredTitle}
          </h2>
          <p class="mt-2 text-sm text-cabuya-text-secondary">
            {t.registry.declaredBody}
          </p>

          <dl class="mt-6 flex flex-col gap-4 text-sm">
            <div>
              <dt
                class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted"
              >
                {t.registry.canonicalLabel}
              </dt>
              <dd class="mt-1 break-all font-mono text-xs">
                {entry.canonical_url}
              </dd>
            </div>

            <div>
              <dt
                class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted"
              >
                {t.registry.domainsLabel}
              </dt>
              <dd class="mt-1">
                {
                  entry.entity_domains
                    .map((domain) => t.registry.domainLabels[domain] ?? domain)
                    .join(', ')
                }
              </dd>
            </div>

            {
              entry.events && entry.events.length > 0 && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                    {t.registry.eventsLabel}
                  </dt>
                  <dd class="mt-1 font-mono text-xs">
                    {entry.events.join(', ')}
                  </dd>
                </div>
              )
            }

            <div>
              <dt
                class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted"
              >
                {t.registry.addedLabel}
              </dt>
              <dd class="mt-1">
                <time datetime={entry.added}>{entry.added}</time>
                {' · '}
                {
                  entry.status === 'proposed'
                    ? t.registry.reviewProposed
                    : t.registry.reviewReviewed
                }
              </dd>
            </div>

            {
              entry.confirmed && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                    {t.registry.confirmedLabel}
                  </dt>
                  <dd class="mt-1">
                    <time datetime={entry.confirmed}>{entry.confirmed}</time>
                  </dd>
                </div>
              )
            }

            {
              entry.notes && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
                    {t.registry.notesLabel}
                  </dt>
                  <dd class="mt-1 text-cabuya-text-secondary">{entry.notes[lang]}</dd>
                </div>
              )
            }
          </dl>

          {
            !entry.confirmed && (
              <p class="mt-6 border-t border-cabuya-border pt-4 text-sm text-cabuya-text-secondary">
                {t.registry.unconfirmedNote}
              </p>
            )
          }
        </article>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <section>
          <h2 class="font-display text-xl font-bold">
            {t.registry.historyTitle}
          </h2>
          <p class="mt-2 text-sm text-cabuya-text-secondary">
            {t.registry.historyBody}
          </p>
          <div class="mt-4">
            {
              history.length > 0 ? (
                <HistorySparkline
                  points={history}
                  lang={lang}
                  publisherId={entry.publisher_id}
                />
              ) : (
                <p class="text-sm text-cabuya-text-muted">
                  {t.registry.historyEmpty}
                </p>
              )
            }
          </div>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold">
            {t.registry.embedTitle}
          </h2>
          <p class="mt-2 text-sm text-cabuya-text-secondary">
            {t.registry.embedBody}
          </p>

          <p class="mt-4">
            <!--
              The alt text is the badge's own accessible name, composed from the
              same state this page shows. An empty alt would be defensible if the
              surrounding prose said what the badge says — it does not; it says
              what the badge is for.
            -->
            <img
              src={`/badge/${entry.publisher_id}.svg${lang === 'es' ? '?lang=es' : ''}`}
              alt={badgeAccessibleName({
                state,
                version: SPEC_VERSION.split('.').slice(0, 2).join('.'),
                lang,
                publisherId: entry.publisher_id,
              })}
              width="160"
              height="20"
              loading="lazy"
            />
          </p>

          <h3 class="mt-6 text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
            {t.registry.embedMarkdown}
          </h3>
          <CodeBlock code={snippets.markdown} lang="markdown" uiLang={lang} />

          <h3 class="mt-4 text-xs font-semibold uppercase tracking-wider text-cabuya-text-muted">
            {t.registry.embedHtml}
          </h3>
          <CodeBlock code={snippets.html} lang="html" uiLang={lang} />
        </section>
      </div>

      <div class="mt-12 max-w-4xl">
        <Callout tone="limit" label={t.registry.notEndorsementTitle}>
          <p>{t.registry.notEndorsement}</p>
        </Callout>
      </div>
    </div>
  </section>
</MainLayout>
