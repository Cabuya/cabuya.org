---
import ContactForm from '@/components/contact/ContactForm.svelte';
import AppInvite from '@/components/cta/AppInvite.astro';
import JsonLd from '@/components/JsonLd.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { CONTACT_FORM } from '@/lib/constances';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: t.contactPage.title,
  description: t.contactPage.description,
  url: `${siteUrl}${prefix}/contact`,
  /*
   * No `email` until Corag publishes one. Declaring a contact point without a
   * reachable address is worse than declaring none: search engines surface it
   * and the message goes nowhere.
   */
  mainEntity: {
    '@type': 'Organization',
    name: 'Corag',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'general',
      url: `${siteUrl}${prefix}/contact`,
      availableLanguage: ['Spanish', 'English'],
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.contactPage.title,
      item: `${siteUrl}${prefix}/contact`,
    },
  ],
};

const breadcrumbs = [
  { label: lang === 'es' ? 'Inicio' : 'Home', href: `${prefix}/` },
  { label: t.contactPage.title },
];

const quickLinks = t.contactPage.quickLinks.map((link) => ({
  ...link,
  href: link.href.startsWith('/') ? `${prefix}${link.href}` : link.href,
}));
---

<MainLayout
  lang={lang}
  title={t.contactPage.title}
  description={t.contactPage.description}
  keywords={lang === 'en'
    ? ['contact Corag', 'Corag partnerships', 'offer capacity to Corag', 'report a problem Corag', 'Corag press enquiries', 'collaborate with Corag']
    : ['contactar Corag', 'alianzas Corag', 'aportar capacidad a Corag', 'reportar un problema Corag', 'prensa Corag', 'colaborar con Corag']}
>
  <Fragment slot="head">
    <JsonLd data={contactPageSchema} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <div class="bg-gradient-to-br from-corag-bg-dark to-corag-bg-dark/90 text-white">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} onDark />
    </div>
    <div class="main-container pt-6 pb-16">
      <Eyebrow variant="accent">{t.contactPage.subtitle}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
        {t.contactPage.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-white/85">
        {t.contactPage.heroDescription}
      </p>
    </div>
  </div>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-16">
      <div class="min-w-0">
        <h2 class="text-2xl sm:text-3xl font-bold text-corag mb-2">
          {t.contactPage.formTitle}
        </h2>
        <p class="mb-8 text-corag-secondary">{t.contactPage.formNote}</p>
        <ContactForm
          client:visible
          lang={lang}
          apiEndpoint={CONTACT_FORM.apiEndpoint}
        />
      </div>

      <aside class="space-y-8">
        <div>
          <h3 class="text-lg font-bold text-corag">{t.contactPage.quickLinksTitle}</h3>
          <ul class="mt-4 space-y-3 list-none">
            {
              quickLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-xl border border-corag-border bg-corag-bg-elevated p-4 transition hover:border-corag-primary/40"
                  >
                    <p class="font-semibold text-corag">{link.label}</p>
                    <p class="mt-1 text-sm text-corag-secondary">{link.description}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </Section>

  <AppInvite lang={lang} variant="band" surface="contact-end" />
</MainLayout>
