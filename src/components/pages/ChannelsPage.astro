---
/**
 * Corag channels directory page (shared between EN and ES).
 * Lists every official Corag channel and marks the application as the
 * primary one, because that is where the actual work happens.
 */

import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getChannels } from '@/lib/channel';
import { channelIconPath } from '@/lib/channel-icons';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const channels = await getChannels();
const primary = channels.filter((c) => c.data.isPrimary);
const secondary = channels.filter((c) => !c.data.isPrimary);

const platformLabel: Record<string, string> = {
  'meetup-com': 'Meetup.com',
  luma: 'Luma',
  github: 'GitHub',
  linkedin: 'LinkedIn',
  x: 'X (Twitter)',
  instagram: 'Instagram',
  facebook: 'Facebook',
  youtube: 'YouTube',
  discord: 'Discord',
  whatsapp: 'WhatsApp',
  telegram: 'Telegram',
  newsletter: 'Newsletter',
  linktree: 'Linktree',
  website: 'Website',
  other: 'Other',
};

const t = {
  title: lang === 'es' ? 'Canales' : 'Channels',
  description:
    lang === 'es'
      ? 'Los canales oficiales de Corag: la aplicación, el grupo de WhatsApp, Instagram y Facebook, con una indicación clara de por dónde empezar.'
      : 'The official Corag channels: the application, the WhatsApp group, Instagram and Facebook, with a clear indication of where to start.',
  intro:
    lang === 'es'
      ? 'Pedir ayuda, ofrecerla y aportar ocurre en la aplicación. Los demás canales sirven para coordinar, avisar y mostrar lo que se entregó.'
      : 'Asking for help, offering it and contributing all happen in the application. The other channels are for coordinating, announcing, and showing what was delivered.',
  primaryHeading: lang === 'es' ? 'Donde ocurre todo' : 'Where it all happens',
  otherHeading: lang === 'es' ? 'Canales de la red' : 'Network channels',
  primaryBadge: lang === 'es' ? 'Empieza aquí' : 'Start here',
  visitLabel: lang === 'es' ? 'Abrir canal' : 'Open channel',
};

const breadcrumbs = [
  {
    label: lang === 'es' ? 'Inicio' : 'Home',
    href: `${getUrlPrefix(lang)}/`,
  },
  { label: t.title },
];
---

<MainLayout lang={lang} title={t.title} description={t.description}>
  <div class="bg-cabuya-bg">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="main-container pt-6 pb-12">
      <Eyebrow>{lang === 'es' ? 'Conecta' : 'Connect'}</Eyebrow>
      <h1
        class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-cabuya"
      >
        {t.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-cabuya-secondary">
        {t.intro}
      </p>
    </div>
  </div>

  {
    primary.length > 0 && (
      <Section title={t.primaryHeading}>
        <ul class="grid gap-6 sm:grid-cols-2 list-none">
          {primary.map((c) => (
            <li class="flex h-full min-w-0 flex-col rounded-2xl bg-cabuya-bg-elevated ring-2 ring-cabuya-primary dark:ring-cabuya-primary-light p-4 sm:p-6 shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="flex items-center gap-3 text-xl font-bold text-cabuya">
                  {channelIconPath(c.data.platform) && (
                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cabuya-primary-soft text-cabuya-primary dark:text-cabuya-primary-light"
                      aria-hidden="true"
                    >
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d={channelIconPath(c.data.platform)} />
                      </svg>
                    </span>
                  )}
                  {c.data.name}
                </h3>
                <span class="inline-flex items-center rounded-full bg-cabuya-fill px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cabuya-on-fill dark:bg-cabuya-primary-light dark:text-cabuya-bg-dark">
                  {t.primaryBadge}
                </span>
              </div>
              <p class="mt-1 text-sm font-medium text-cabuya-primary dark:text-cabuya-primary-light">
                {platformLabel[c.data.platform] ?? c.data.platform}
              </p>
              <p class="mt-3 text-sm text-cabuya-secondary">
                {tr(c.data.description, lang)}
              </p>
              <p class="mt-2 text-sm italic text-cabuya-secondary">
                {tr(c.data.audience, lang)}
              </p>
              <a
                href={c.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex min-h-[24px] items-center gap-1.5 text-sm font-semibold text-cabuya-primary dark:text-cabuya-primary-light hover:underline"
              >
                {t.visitLabel}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    secondary.length > 0 && (
      <Section title={t.otherHeading} surface="alt">
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none">
          {secondary.map((c) => (
            <li class="flex h-full min-w-0 flex-col rounded-2xl bg-cabuya-bg-elevated ring-1 ring-cabuya-border p-4 sm:p-6">
              <h3 class="flex items-center gap-2.5 text-lg font-semibold text-cabuya">
                {channelIconPath(c.data.platform) && (
                  <span
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cabuya-primary-soft text-cabuya-primary dark:text-cabuya-primary-light"
                    aria-hidden="true"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d={channelIconPath(c.data.platform)} />
                    </svg>
                  </span>
                )}
                {c.data.name}
              </h3>
              <p class="mt-1 text-sm font-semibold uppercase tracking-wider text-cabuya-primary dark:text-cabuya-primary-light">
                {platformLabel[c.data.platform] ?? c.data.platform}
              </p>
              <p class="mt-3 text-sm text-cabuya-secondary">
                {tr(c.data.description, lang)}
              </p>
              <p class="mt-2 text-sm italic text-cabuya-secondary">
                {tr(c.data.audience, lang)}
              </p>
              <a
                href={c.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex min-h-[24px] items-center gap-1.5 text-sm font-semibold text-cabuya-primary dark:text-cabuya-primary-light hover:underline"
              >
                {t.visitLabel}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</MainLayout>
