---
/**
 * Cabuya small status/category pill (filter pills, tag chips).
 *
 * For state labels — measured, unmeasured, proposed — use `<Badge>` instead:
 * a pill is a category, a badge is a claim about state.
 */

interface Props {
  href?: string;
  active?: boolean;
  variant?: 'default' | 'primary' | 'accent' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  href,
  active = false,
  variant = 'default',
  size = 'md',
  class: className = '',
} = Astro.props;

const sizeClass = size === 'sm' ? 'px-2.5 py-1 text-xs' : 'px-3 py-1.5 text-sm';

const variantBase = {
  // The border is not decoration: `bg-cabuya-bg-elevated` is also what cards
  // and panels use, so without an edge the default pill dissolves into any
  // raised surface it sits on. The component contact sheet is where that
  // became obvious — it was invisible in the dark half.
  default:
    'bg-cabuya-bg-elevated text-cabuya-secondary border border-cabuya-border hover:bg-cabuya-primary-soft',
  primary: 'bg-cabuya-fill text-cabuya-on-fill hover:bg-cabuya-fill-strong',
  accent: 'bg-cabuya-accent text-cabuya-bg-dark hover:bg-cabuya-accent-strong',
  outline:
    'border border-cabuya-border text-cabuya-secondary hover:bg-cabuya-primary-soft',
};
const activeClass = active
  ? 'ring-2 ring-cabuya-primary ring-offset-2 ring-offset-cabuya-bg'
  : '';
const base = `inline-flex items-center gap-1 rounded-full font-medium transition-colors ${sizeClass} ${variantBase[variant]} ${activeClass} ${className}`;
---

{
  href ? (
    <a href={href} class={base}>
      <slot />
    </a>
  ) : (
    <span class={base}>
      <slot />
    </span>
  )
}
