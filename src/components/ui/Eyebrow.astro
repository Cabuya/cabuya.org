---
/**
 * Cabuya eyebrow label — small uppercase tracking-widest text used above
 * section titles or in hero banners.
 */

interface Props {
  variant?: 'primary' | 'accent' | 'muted';
  class?: string;
}

const { variant = 'primary', class: className = '' } = Astro.props;

const colorClass =
  variant === 'accent'
    ? 'text-cabuya-accent dark:text-cabuya-accent'
    : variant === 'muted'
      ? 'text-cabuya-secondary'
      : 'text-cabuya-primary dark:text-cabuya-primary-light';
---

<p class={`text-sm font-semibold uppercase tracking-widest ${colorClass} ${className}`}>
  <slot />
</p>
