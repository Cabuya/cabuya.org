---
/**
 * An image inside an institutional page, optionally wearing a CSS-drawn device
 * frame.
 *
 * The frames are CSS, never baked into the image: a screenshot re-captured
 * later drops straight in, and the chrome themes with the token layer instead
 * of freezing one palette into a PNG.
 */
import type { InstitutionalFigure } from '@/lib/translations/types';

interface Props {
  figure: InstitutionalFigure;
  /** `sizes` hint; defaults to the common half-width column. */
  sizes?: string;
  /** Above-the-fold figures opt out of lazy loading. */
  eager?: boolean;
  class?: string;
}

const {
  figure,
  sizes = '(min-width: 1024px) 45vw, 100vw',
  eager = false,
  class: className = '',
} = Astro.props;

const {
  srcBase,
  widths,
  alt,
  width,
  height,
  caption,
  frame = 'plain',
} = figure;

const largest = Math.max(...widths);
const src = `${srcBase}-${largest}.webp`;
const srcset = widths.map((w) => `${srcBase}-${w}.webp ${w}w`).join(', ');

const frameClass =
  frame === 'browser'
    ? 'overflow-hidden rounded-[28px] border border-corag-border bg-corag-bg-elevated shadow-corag-lg'
    : frame === 'phone'
      ? 'overflow-hidden rounded-[2rem] border-[6px] border-corag-bg-dark bg-corag-bg-dark shadow-corag-lg'
      : frame === 'none'
        ? ''
        : 'overflow-hidden rounded-[28px] border border-corag-border shadow-corag-sm';
---

<figure class={className}>
  <div class={frameClass}>
    {
      frame === 'browser' && (
        <div
          class="flex items-center gap-1.5 border-b border-corag-border bg-corag-bg px-5 py-3"
          aria-hidden="true"
        >
          <span class="h-2.5 w-2.5 rounded-full bg-corag-primary/40" />
          <span class="h-2.5 w-2.5 rounded-full bg-corag-primary/25" />
          <span class="h-2.5 w-2.5 rounded-full bg-corag-primary/10" />
        </div>
      )
    }
    <img
      src={src}
      srcset={srcset}
      sizes={sizes}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={frame === 'phone' ? 'w-full rounded-[1.6rem]' : 'w-full'}
    />
  </div>
  {
    caption && (
      <figcaption class="mt-4 text-sm leading-relaxed text-corag-secondary">
        {caption}
      </figcaption>
    )
  }
</figure>
