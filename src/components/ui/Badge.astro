---
/**
 * Cabuya badge — a categorical label where colour reinforces meaning.
 *
 * The variant vocabulary is the project's own: measurement states, level
 * markers, and registry entry states. It replaced a set of sponsor tiers
 * (diamond/gold/silver/bronze) inherited from the previous project, which
 * described a relationship Cabuya does not have with anyone.
 *
 * Colour is never the only signal — every variant is rendered with its own
 * text, and the caller is expected to keep that text meaningful on its own.
 * A reader who cannot distinguish the greens from the ambers still reads
 * "unmeasured".
 */

interface Props {
  variant?: /** A level the validator measured and confirmed. */
    | 'measured'
    /** Schema-valid, but conformance was not measured (degraded run). */
    | 'unmeasured'
    /** Errors found — the entry does not conform at the level claimed. */
    | 'non-conformant'
    /** Catalogued and specified, but not implemented in this version. */
    | 'planned'
    /** In the registry but not yet confirmed by the team that owns it. */
    | 'proposed'
    /** A specification stage: draft, review, stable. */
    | 'draft'
    /** Neutral categorical label with no state meaning. */
    | 'neutral';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'neutral', size = 'sm', class: className = '' } = Astro.props;

const sizeClass = size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-2.5 py-1 text-sm';

const variantClass: Record<string, string> = {
  measured: 'bg-cabuya-success-soft text-cabuya-success',
  unmeasured: 'bg-cabuya-warning-soft text-cabuya-warning',
  'non-conformant': 'bg-cabuya-danger-soft text-cabuya-danger',
  planned: 'bg-cabuya-info-soft text-cabuya-info',
  proposed:
    'bg-cabuya-bg-elevated text-cabuya-secondary border border-cabuya-border-strong border-dashed',
  draft: 'bg-cabuya-primary-soft text-cabuya-primary',
  neutral:
    'bg-cabuya-bg-elevated text-cabuya-secondary border border-cabuya-border',
};
---

<span
  class={`inline-flex items-center gap-1 rounded-md font-semibold ${sizeClass} ${variantClass[variant]} ${className}`}
>
  <slot />
</span>
