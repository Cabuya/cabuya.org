---
/**
 * WebMCP: the two things an agent can *do* on this site, offered to the browser.
 *
 * `navigator.modelContext.provideContext()` is the browser-side half of MCP — an
 * agent driving the page can call a declared tool instead of guessing at the
 * DOM. The site already has both of these as public HTTP endpoints, and
 * `/auth.md` documents them; this makes them reachable to an agent that arrived
 * through a browser rather than through the API.
 *
 * ## Why an inline script rather than an island
 *
 * It is ~40 lines and it must run on the landing page, which has a 40 KB JS
 * budget and currently spends 22. An island would cost a hydration entry point
 * and a network round trip to register two function objects. Inline costs a CSP
 * hash — `scripts/generate-csp.mjs` reads the built HTML and adds it — and no
 * bytes over the wire.
 *
 * ## Two tools, both of which already existed
 *
 * - `validate_cabuya_feed` posts to `/api/validate`, the same public endpoint the
 *   validator page uses. No key, 10 calls a minute per caller.
 * - `read_cabuya_page_as_markdown` fetches a page's `.md` twin, which every page
 *   on this site has. Same-origin only, and it refuses anything else — an agent
 *   tool that will fetch an arbitrary URL for you is an SSRF proxy with a
 *   friendly name.
 *
 * Nothing here is a new capability or a new claim: if `navigator.modelContext`
 * is absent, the script does nothing and the page is unchanged.
 */
---

<script is:inline>
  (() => {
    const mc = navigator.modelContext;
    if (!mc || typeof mc.provideContext !== 'function') return;

    const json = (value) => ({
      content: [{ type: 'text', text: JSON.stringify(value, null, 2) }],
    });
    const text = (value) => ({ content: [{ type: 'text', text: value }] });

    const tools = [
      {
        name: 'validate_cabuya_feed',
        description:
          'Validate a Cabuya manifest or place feed by URL and return the findings, each with a stable check id, the rule it comes from and the fix. Conformance is measured, never declared: this is the measurement. Public, no credentials, rate limited to 10 calls per minute.',
        inputSchema: {
          type: 'object',
          required: ['url'],
          properties: {
            url: {
              type: 'string',
              description:
                'Absolute https URL of a manifest (usually /.well-known/cabuya.json) or of a place feed.',
            },
            kind: {
              type: 'string',
              enum: ['manifest', 'feed', 'auto'],
              description:
                'What you believe the document is. The server verifies rather than trusts it. Defaults to auto.',
            },
            lang: {
              type: 'string',
              enum: ['en', 'es'],
              description:
                'Language for the human-readable parts. Check ids and pointers never translate.',
            },
          },
        },
        async execute({ url, kind, lang }) {
          const response = await fetch('/api/validate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url, kind: kind ?? 'auto', lang: lang ?? 'en' }),
          });
          return json(await response.json());
        },
      },
      {
        name: 'read_cabuya_page_as_markdown',
        description:
          'Read any page of cabuya.org as Markdown, including every section of the specification and the full check catalogue. Pass a site-relative path such as /developers/quickstart or /developers/spec/0.1/3-the-feed.',
        inputSchema: {
          type: 'object',
          required: ['path'],
          properties: {
            path: {
              type: 'string',
              description:
                'Site-relative path, with or without the .md suffix. Spanish pages live under /es.',
            },
          },
        },
        async execute({ path }) {
          /* Same-origin only. A tool that fetches arbitrary URLs on request is
             an open proxy, and this one runs in the visitor's browser. */
          const target = new URL(path, location.origin);
          if (target.origin !== location.origin) {
            return text('Refused: this tool only reads pages on cabuya.org.');
          }
          const clean = target.pathname.replace(/\/$/, '') || '/index';
          const twin = clean.endsWith('.md') ? clean : `${clean}.md`;
          const response = await fetch(twin, {
            headers: { Accept: 'text/markdown' },
          });
          if (!response.ok) {
            return text(`No Markdown twin at ${twin} (HTTP ${response.status}).`);
          }
          return text(await response.text());
        },
      },
    ];

    mc.provideContext({ tools });
  })();
</script>
