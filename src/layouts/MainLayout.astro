---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/layout/Header.svelte';
import type { Language } from '@/lib/i18n';
import { DESCRIPTION_MAX, truncateToBand } from '@/lib/meta-description';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Canonicalize to another URL when this one is an alias. */
  canonicalPath?: string;
  image?: string;
  keywords?: string[];
  prevPage?: string;
  nextPage?: string;
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Forwarded to BaseHead — disable on pages with a dedicated LCP preload. */
  preloadHeaderLogo?: boolean;
  preloadFonts?: boolean;
  lcpImageHref?: string;
  lcpImageMedia?: string;
  /**
   * Which theme preference this page reads and writes.
   *
   * `docs` is the developers portal, which defaults to dark. See the script
   * below for why that default does not override a reader who has already
   * chosen.
   */
  themeScope?: 'site' | 'docs';
}

const {
  lang,
  title,
  description,
  themeScope = 'site',
  canonicalPath,
  image,
  keywords,
  prevPage,
  nextPage,
  ogType,
  ogImageWidth,
  ogImageHeight,
  preloadHeaderLogo = true,
  preloadFonts = true,
  lcpImageHref,
  lcpImageMedia,
} = Astro.props;

const language = lang as Language;
const t = getTranslations(language);
const pathname = Astro.url.pathname;

/**
 * Last line of defence for the 130-160 band `CLAUDE.md` requires: no page may
 * emit a description past the maximum, whatever it passes in. Page components
 * compose theirs with `buildMetaDescription`; this catches anything that does
 * not, and cuts at a sentence or word boundary rather than mid-word.
 */
const metaDescription = truncateToBand(description, DESCRIPTION_MAX);
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={metaDescription}
      canonicalPath={canonicalPath}
      image={image}
      lang={lang}
      keywords={keywords}
      prevPage={prevPage}
      nextPage={nextPage}
      ogType={ogType}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      preloadHeaderLogo={preloadHeaderLogo}
      preloadFonts={preloadFonts}
      lcpImageHref={lcpImageHref}
      lcpImageMedia={lcpImageMedia}
    />
    <slot name="head" />
    {/*
      Theme resolution, before first paint.

      Two scopes, because the portal is a different surface: it has a sidebar,
      a contents rail and code on every page, and dark is what a reader of that
      surface expects. The landing is not that surface.

      A scoped default is only safe if it is a *default*. Three rules keep the
      flip from reading as a bug:

      1. It happens here, in a blocking script, so the page never paints in one
         theme and repaints in the other.
      2. It coincides with entering the portal, where the sidebar and contents
         rail appear at the same moment. A theme change that lands with a
         visible change of context reads as intent; one that lands alone reads
         as breakage.
      3. It never overrides a reader who has already chosen. Someone who set
         light did so for a reason — for some readers dark type haloes and is
         genuinely harder — so an explicit site preference carries into the
         portal. The dark default is for readers who have expressed nothing,
         and one toggle inside the portal pins the portal separately from then
         on.
    */}
    <script is:inline define:vars={{ themeScope }}>
  (function () {
    var key = themeScope === 'docs' ? 'theme:docs' : 'theme';
    var choice = null;
    try {
      choice = localStorage.getItem(key) || (themeScope === 'docs' ? localStorage.getItem('theme') : null);
    } catch (error) {
      /* Storage disabled. Fall through to the scope's default. */
    }
    if (!choice) choice = themeScope === 'docs' ? 'dark' : 'light';
    document.documentElement.classList.toggle('dark', choice === 'dark');
  })();
</script>
  </head>
  <body
    class:list={[
      'flex flex-col min-h-screen text-cabuya bg-cabuya-bg',
    ]}
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-cabuya-bg-elevated focus:px-4 focus:py-2 focus:rounded focus:shadow-lg focus:text-cabuya-primary">
      {t.nav.skipToContent}
    </a>
    {/*
      The banner scrolls away; the header stays.

      Both used to stick, which cost 157px on a 568px phone — 27% of the
      viewport, permanently, before any content. The banner says the
      specification is a draft, and that stays true whether or not it is on
      screen; the header is the one people reach for again.
    */}
    <div
      data-cabuya-chrome
      class:list={[
        'sticky top-0 z-50',
        /* Light PTD: keep chrome transparent so the hero illustration
           fades under the glass header (2024-style), not a solid cream bar. */
      ]}
    >
      <Header
        client:idle
        lang={language}
        pathname={pathname}
        themeScope={themeScope}
        labels={{
          openMenu: t.nav.openMenu,
          closeMenu: t.nav.closeMenu,
          switchToLanguage: t.nav.switchToLanguage,
          toDark: t.theme.toDark,
          toLight: t.theme.toLight,
        }}
      />
    </div>
    {/*
      Keep --cabuya-chrome-height in sync with sticky chrome (header ±
      notification bar). Hero uses it for 100dvh fill; ResizeObserver
      covers bar collapse/expand and header reflow without layout jump
      below the hero (chrome shrink and hero grow cancel).
      Also re-sync on transitionend + trailing rAF — grid 0fr/1fr
      animations can skip the final ResizeObserver callback.
    */}
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-cabuya-chrome]');
        if (!el) return;
        var root = document.documentElement;
        var raf = 0;
        var sync = function () {
          root.style.setProperty(
            '--cabuya-chrome-height',
            el.getBoundingClientRect().height + 'px'
          );
        };
        var syncSoon = function () {
          sync();
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(function () {
            raf = 0;
            sync();
          });
        };
        sync();
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(syncSoon).observe(el);
        } else {
          window.addEventListener('resize', syncSoon);
        }
        el.addEventListener('transitionend', syncSoon);
      })();
    </script>
    {/*
      In-page jump to #main-after-hero must clear sticky chrome. Native
      scroll-padding can lag the ResizeObserver; re-measure on click.
    */}
    <script is:inline>
      (function () {
        document.addEventListener('click', function (event) {
          var link = event.target && event.target.closest
            ? event.target.closest('[data-scroll-to-after-hero]')
            : null;
          if (!link) return;
          var target = document.getElementById('main-after-hero');
          if (!target) return;
          event.preventDefault();
          var chrome = document.querySelector('[data-cabuya-chrome]');
          var offset = chrome ? chrome.getBoundingClientRect().height : 68;
          var top =
            target.getBoundingClientRect().top + window.scrollY - offset;
          var reduce = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;
          window.scrollTo({
            top: Math.max(0, top),
            behavior: reduce ? 'auto' : 'smooth',
          });
          if (history.replaceState) {
            history.replaceState(null, '', '#main-after-hero');
          }
        });
      })();
    </script>
    <main
      id="main-content"
      class:list={[
        'flex-1 bg-cabuya-bg',
      ]}
    >
      <slot />
    </main>
    <Footer lang={lang} />
    {/*
      No analytics boot script.

      Cloudflare Web Analytics has no custom-event API: it measures page views,
      referrers and Web Vitals from its own beacon and nothing else. The
      outbound-link and scroll-depth tracking that used to live here worked
      through the previous provider's event API, which is gone — so the code
      was 299 lines and 1.5 KB per page that sent nothing at all.

      Deleting it rather than leaving it dormant is the point: dead tracking
      code is a privacy claim nobody can verify by reading the page. What the
      site measures, and what it cannot, is in `docs/ANALYTICS.md`.
    */}
  </body>
</html>
