---
import '@/styles/global.css';

import {
  INTERNAL_SECTIONS,
  type InternalPage,
  pagesIn,
  topLevelPages,
} from '@/lib/internal-hub';

/**
 * The dev-only hub shell.
 *
 * The sidebar is generated from `src/lib/internal-hub.ts` rather than a list
 * kept here, because the hand-maintained version outlived the pages it linked
 * to. A unit test reconciles that registry with the filesystem.
 */

interface Props {
  title: string;
  description?: string;
  /** Section id from the registry — drives the active state. */
  section?: string;
  /** Page id from the registry when the page is a sub-page. */
  subsection?: string;
}

const { title, description, section, subsection } = Astro.props;
const fullTitle = `${title} — Cabuya Internal`;

const activeId = subsection || section;
const topLevelItems = topLevelPages();
const activeSection =
  INTERNAL_SECTIONS.find((s) => s.id === section)?.id ?? undefined;
const children: InternalPage[] = activeSection
  ? pagesIn(activeSection).filter((page) => !page.topLevel)
  : [];

/** Flat order for the mobile prev/next pair. */
const visibleItems: InternalPage[] = topLevelItems.flatMap((item) =>
  item.section === activeSection ? [item, ...children] : [item]
);
const currentIndex = visibleItems.findIndex((item) => item.id === activeId);
const prevItem = currentIndex > 0 ? visibleItems[currentIndex - 1] : null;
const nextItem =
  currentIndex >= 0 && currentIndex < visibleItems.length - 1
    ? visibleItems[currentIndex + 1]
    : null;
---

<html lang="en" data-internal="true">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
  (function(){var t=localStorage.getItem('theme');if(t==='dark')document.documentElement.classList.add('dark');else document.documentElement.classList.remove('dark');})();
</script>
  </head>
  <body class="min-h-screen bg-cabuya-bg dark:bg-cabuya-bg-dark text-cabuya-text font-sans antialiased transition-colors duration-300">

    <!-- Dev-only banner. Amber is intentional: it is not a brand surface, it is a warning. -->
    <div class="sticky top-0 z-50 flex items-center justify-between gap-3 px-3 sm:px-4 py-2 text-sm font-semibold bg-amber-100 dark:bg-amber-950 text-amber-950 dark:text-amber-100 border-b border-amber-400 dark:border-amber-800">
      <div class="flex items-center gap-2 min-w-0">
        <span class="inline-flex items-center rounded-full bg-amber-900 dark:bg-amber-200 px-2 py-0.5 text-xs font-bold text-amber-50 dark:text-amber-950 uppercase tracking-wide shrink-0">
          Internal
        </span>
        <span class="text-xs sm:text-sm truncate">Cabuya · dev-only hub</span>
      </div>
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <span class="hidden md:inline text-xs">
          Never shipped to production
        </span>
        <button
          id="internal-theme-toggle"
          type="button"
          class="group inline-flex items-center gap-2 rounded-full pl-1 pr-3 py-1 bg-cabuya-bg-elevated text-cabuya-text border border-amber-400 dark:border-amber-800 hover:border-cabuya-primary hover:shadow-sm transition-all"
          aria-label="Toggle light/dark mode"
          title="Toggle light/dark mode"
        >
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-cabuya-fill text-cabuya-on-fill">
            <svg id="internal-sun" class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <svg id="internal-moon" class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </span>
          <span class="hidden sm:inline text-xs font-semibold">
            <span class="dark:hidden">Light</span>
            <span class="hidden dark:inline">Dark</span>
          </span>
        </button>
      </div>
    </div>

    <!-- Mobile horizontal navigation -->
    <div class="lg:hidden sticky top-[41px] z-40 bg-cabuya-bg-elevated border-b border-cabuya-border">
      <div class="flex items-center gap-1 px-2 py-2 overflow-x-auto scrollbar-hide">
        {visibleItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium transition-colors whitespace-nowrap',
              item.topLevel ? '' : 'ml-1',
              activeId === item.id
                ? 'bg-cabuya-fill text-cabuya-on-fill'
                : 'bg-cabuya-bg-brand text-cabuya-text-secondary hover:bg-cabuya-bg-brand-strong',
            ]}
            aria-current={activeId === item.id ? 'page' : undefined}
          >
            {item.icon && <span class="text-sm font-mono" aria-hidden="true">{item.icon}</span>}
            <span>{item.title}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="flex min-h-[calc(100vh-40px)]">

      <!-- Desktop sidebar -->
      <nav
        class="hidden lg:flex flex-col w-64 shrink-0 border-r border-cabuya-border bg-cabuya-bg-brand/40 dark:bg-cabuya-bg-elevated sticky top-[41px] h-[calc(100vh-41px)]"
        aria-label="Internal hub"
      >
        <div class="flex-1 overflow-y-auto py-4 px-3">
          <div class="mb-4 px-2">
            <span class="text-xs font-bold uppercase tracking-wider text-cabuya-text-muted">
              Navigation
            </span>
          </div>
          <ul class="space-y-0.5">
            {topLevelItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                    activeId === item.id || item.section === activeSection
                      ? 'bg-cabuya-fill text-cabuya-on-fill'
                      : 'text-cabuya-text-secondary hover:bg-cabuya-bg-brand-strong',
                  ]}
                  aria-current={activeId === item.id ? 'page' : undefined}
                >
                  <span class="w-6 text-center text-base font-mono" aria-hidden="true">{item.icon}</span>
                  <span>{item.title}</span>
                </a>
                {item.section === activeSection && children.length > 0 && (
                  <ul class="mt-0.5 ml-6 space-y-0.5">
                    {children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors',
                            activeId === child.id
                              ? 'bg-cabuya-bg-brand-strong text-cabuya-text'
                              : 'text-cabuya-text-secondary hover:bg-cabuya-bg-brand-strong',
                          ]}
                          aria-current={activeId === child.id ? 'page' : undefined}
                        >
                          <span class="font-mono" aria-hidden="true">&rsaquo;</span>
                          <span>{child.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Main content area -->
      <main class="flex-1 min-w-0 overflow-x-hidden">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
          <div class="mb-8 sm:mb-10">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold tracking-tight">{title}</h1>
            {description && (
              <p class="mt-2 text-base sm:text-lg text-cabuya-text-secondary">{description}</p>
            )}
          </div>

          <slot />

          <!-- Mobile prev/next navigation -->
          <div class="lg:hidden flex items-center justify-between mt-12 pt-6 border-t border-cabuya-border">
            {prevItem ? (
              <a href={prevItem.href} class="flex items-center gap-2 text-sm font-medium text-cabuya-text-secondary hover:text-cabuya-primary transition-colors">
                <span aria-hidden="true">&larr;</span>
                <span>{prevItem.title}</span>
              </a>
            ) : <span />}
            {nextItem && (
              <a href={nextItem.href} class="flex items-center gap-2 text-sm font-medium text-cabuya-text-secondary hover:text-cabuya-primary transition-colors">
                <span>{nextItem.title}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        </div>

        <footer class="border-t border-cabuya-border px-4 sm:px-6 py-4 text-center text-xs text-cabuya-text-muted">
          Cabuya internal hub &middot; dev-only &middot; removed from every production build
        </footer>
      </main>
    </div>

    <script is:inline>
      (function () {
        var active = document.querySelector('[aria-current="page"]');
        if (active) {
          var nav = active.closest('.scrollbar-hide');
          if (nav) {
            var offset = active.offsetLeft - nav.offsetWidth / 2 + active.offsetWidth / 2;
            nav.scrollLeft = Math.max(0, offset);
          }
        }
      })();
    </script>

    <script is:inline>
      (function() {
        var btn = document.getElementById('internal-theme-toggle');
        if (btn) {
          btn.addEventListener('click', function() {
            document.documentElement.classList.toggle('dark');
            var isDark = document.documentElement.classList.contains('dark');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
          });
        }
      })();
    </script>

    <style>
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .scrollbar-hide::-webkit-scrollbar { display: none; }
    </style>
  </body>
</html>
