{
  "name": "cabuya.org",
  "description": "cabuya.org — the home of the Cabuya Protocol: an open interoperability standard that lets emergency-aid applications publish and consume the same data. Site, CC0 spec, publisher registry and the @cabuya/validator.",
  "author": "Cabuya",
  "license": "Apache-2.0",
  "homepage": "https://cabuya.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cabuya/cabuya.org.git"
  },
  "type": "module",
  "version": "3.0.11",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "prebuild": "node scripts/generate-agent-skills-index.mjs && node scripts/generate-og-fallback.mjs",
    "generate:agent-skills-index": "node scripts/generate-agent-skills-index.mjs",
    "dns:aid:publish": "node scripts/publish-dns-aid.mjs",
    "dns:aid:dry-run": "DNS_AID_DRY_RUN=1 node scripts/publish-dns-aid.mjs",
    "astro": "astro",
    "astro:check": "astro check",
    "astro:preview": "astro preview",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "biome:fix:unsafe": "biome check --write --unsafe",
    "ncu:check": "ncu",
    "ncu:upgrade": "ncu -u",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "images:optimize": "node scripts/optimize-images.mjs",
    "og:fallback": "node scripts/generate-og-fallback.mjs",
    "og:fallback:force": "node scripts/generate-og-fallback.mjs --force",
    "images:webp": "echo 'All images are natively WebP — no generation needed'",
    "md:check": "node scripts/check-md-parity.mjs",
    "md:check:strict": "node scripts/check-md-parity.mjs --strict",
    "md:check:existence": "node scripts/check-md-parity.mjs --existence-only",
    "lang:check": "node scripts/audit-language-integrity.mjs",
    "lang:check:strict": "node scripts/audit-language-integrity.mjs --strict",
    "seo:check": "node scripts/audit-seo.mjs",
    "seo:check:strict": "node scripts/audit-seo.mjs --strict",
    "parity:check": "node scripts/audit-content-parity.mjs",
    "parity:check:strict": "node scripts/audit-content-parity.mjs --strict",
    "redirects:check": "node scripts/audit-redirects.mjs",
    "redirects:check:strict": "node scripts/audit-redirects.mjs --strict",
    "lighthouse": "lhci autorun",
    "lighthouse:full": "lhci autorun --config=lighthouserc.full.cjs",
    "responsive:inventory": "node scripts/responsive-audit/build-url-list.mjs",
    "responsive:capture": "node scripts/responsive-audit/capture.mjs",
    "responsive:capture:quick": "node scripts/responsive-audit/capture.mjs --quick",
    "test:responsive": "playwright test tests/e2e/responsive/",
    "test:responsive:update": "playwright test tests/e2e/responsive/ --update-snapshots",
    "release": "bash .github/scripts/prepare_release.sh",
    "responsive:audit": "node scripts/responsive-audit/audit-layout.mjs --base=http://localhost:7777",
    "responsive:audit:quick": "node scripts/responsive-audit/audit-layout.mjs --base=http://localhost:7777 --quick",
    "spec:check": "node scripts/check-spec.mjs",
    "spec:check:strict": "node scripts/check-spec.mjs --strict",
    "spec:boundary": "node scripts/check-spec-boundary.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "registry:ids": "node scripts/generate-registry-ids.mjs",
    "registry:ids:check": "node scripts/generate-registry-ids.mjs --check",
    "revalidate:dry-run": "node scripts/revalidate.mjs --dry-run",
    "registry:check:strict": "node scripts/check-registry.mjs --strict",
    "validator:build": "pnpm --filter @cabuya/validator build",
    "validator:test": "pnpm --filter @cabuya/validator test",
    "validator:pack": "pnpm --filter @cabuya/validator exec npm pack --dry-run",
    "retention:check": "node scripts/check-no-retention.mjs",
    "retention:check:strict": "node scripts/check-no-retention.mjs --strict",
    "internal:check": "node scripts/check-internal-excluded.mjs",
    "internal:check:strict": "node scripts/check-internal-excluded.mjs --strict",
    "checks:catalogue": "node scripts/check-checks-catalogue.mjs",
    "checks:catalogue:strict": "node scripts/check-checks-catalogue.mjs --strict"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@cabuya/validator": "workspace:*",
    "@astrojs/compiler-rs": "0.3.2",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@lucide/astro": "1.31.0",
    "astro": "7.1.6",
    "svelte": "5.56.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "20.11.1",
    "npm-check-updates": "23.0.0",
    "sharp": "0.35.3",
    "tsx": "^4.23.1",
    "vitest": "4.1.10",
    "yaml": "2.8.3"
  },
  "bugs": {
    "url": "https://github.com/Cabuya/cabuya.org/issues"
  }
}
