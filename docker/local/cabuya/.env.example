# Project env vars
ASTRO_TELEMETRY_DISABLED=1

# Analytics
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_USE_PROXY=true
PUBLIC_UMAMI_ENABLE=false
PUBLIC_BING_SITE_VERIFICATION=

# === Contact forms — DailyBot Forms API (/api/contact) ===
# Personal API key from https://app.dailybot.com → User settings → API keys.
# Form + question UUIDs are baked into functions/api/_dailybot.ts (Corag org).
# Astro `pnpm run dev` does not run functions/ — bind this for wrangler pages dev.
DAILYBOT_API_KEY=
