{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabuya.org/registry/schema/event.schema.json",
  "title": "Registry event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "name", "started"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "object",
      "required": ["en", "es"],
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "started": {
      "type": "string",
      "format": "date"
    },
    "ended": {
      "type": ["string", "null"],
      "format": "date"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "$comment": "Rule-0: figures only with named sources."
    }
  }
}
