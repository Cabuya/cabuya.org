{
  "name": "@cabuya/validator",
  "version": "0.1.0",
  "description": "The Cabuya Protocol conformance validator \u2014 one engine, four harnesses (CLI, CI, live web, scheduled re-validation). Conformance is measured, never declared.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cabuya/cabuya.org.git",
    "directory": "packages/validator"
  },
  "homepage": "https://cabuya.org/developers/validator",
  "bugs": {
    "url": "https://github.com/Cabuya/cabuya.org/issues"
  },
  "keywords": [
    "cabuya",
    "protocol",
    "validator",
    "conformance",
    "humanitarian",
    "interoperability"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "import": "./dist/checks.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-standalone.mjs && tsc -p tsconfig.json && node scripts/build-standalone.mjs --dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas:precompile": "node scripts/build-standalone.mjs",
    "schemas:check": "node scripts/build-standalone.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "cabuya-validator": "./dist/cli/index.js"
  }
}
