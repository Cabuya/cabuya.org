{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabuya.org/registry/schema/event.schema.json",
  "title": "Registry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "name",
    "started"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "object",
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "started": {
      "type": "string",
      "format": "date"
    },
    "ended": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": "object",
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 500
        },
        "es": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false,
      "description": "Free-text context, written natively in both languages. Rendered verbatim on the registry pages, which are published in both — a note in one language only would leave half the readers with a blank field where the caveat should be."
    }
  }
}
